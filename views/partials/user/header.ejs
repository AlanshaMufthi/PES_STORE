<%
  const currentPage = typeof page !== 'undefined' ? page : 'home';
  const query = typeof searchQuery !== 'undefined' ? searchQuery : '';
  const count = typeof cartCount !== 'undefined' ? cartCount : (locals.cartCount || 0);
%>

<link rel="stylesheet" href="/css/tailwind.css">

<!-- ═══════════════ NAVBAR ═══════════════ -->
<nav class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm w-full">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <svg width="44" height="50" viewBox="0 0 44 50" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M22 2L40 10V26C40 36.5 32 44.5 22 48C12 44.5 4 36.5 4 26V10L22 2Z" fill="white" stroke="black" stroke-width="2.5"/>
        <path d="M10 20L13 15L16 19L22 13L28 19L31 15L34 20H10Z" fill="black"/>
        <text x="22" y="34" text-anchor="middle" font-family="Cinzel,serif" font-size="9" font-weight="700" fill="black">2ES</text>
      </svg>
    </a>

    <!-- Search -->
    <div class="hidden md:flex items-center flex-1 justify-center">
      <form action="/shop" method="GET" class="search-wrap">
        <input
          id="headerSearchInput"
          name="q"
          value="<%= query %>"
          class="search-input"
          type="text"
          placeholder="search product..."
        />
        <button type="submit" class="absolute right-2.5 top-1/2 -translate-y-1/2" aria-label="Search">
          <svg width="14" height="14" fill="none" stroke="#888" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      </form>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">

      <!-- Cart Icon -->
      <a href="/cart" class="cart-wrap icon-btn" title="Cart" aria-label="Shopping Cart">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span
          id="headerCartCount"
          class="cart-count"
          style="display: <%= (count > 0) ? 'flex' : 'none' %>;"
        ><%= count %></span>
      </a>

      <!-- Wishlist Icon -->
      <a href="/wishlist" class="icon-btn <%= currentPage === 'wishlist' ? 'text-red-500' : 'text-gray-700 hover:text-black' %>" title="Wishlist" aria-label="Wishlist">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </a>

      <!-- Profile Icon / Login Button -->
      <% if (locals.user) { %>
        <div class="profile-wrap" id="profileWrap">
          <button class="icon-btn" id="profileBtn" aria-label="Profile menu">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </button>
          <div class="profile-dropdown" id="profileDropdown">
            <a href="/profile">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              Profile
            </a>
            <div class="divider"></div>
            <a href="/logout" class="logout">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              Logout
            </a>
          </div>
        </div>
      <% } else { %>
        <div class="flex items-center gap-2">
          <a href="/login" class="px-4 py-1.5 text-xs font-semibold text-gray-800 border border-gray-300 rounded-md hover:bg-gray-50 transition">Log in</a>
          <a href="/signup" class="px-4 py-1.5 text-xs font-semibold text-white bg-gray-900 rounded-md hover:bg-gray-700 transition">Sign up</a>
        </div>
      <% } %>

    </div>
  </div>

  <!-- Nav Links -->
  <div class="border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 flex gap-8 py-2.5 justify-center">
      <a href="/" class="text-sm <%= currentPage === 'home' ? 'font-semibold text-gray-900 border-b-2 border-gray-900 pb-0.5' : 'font-medium text-gray-500 hover:text-gray-900 transition' %>">HOME</a>
      <a href="/shop" class="text-sm <%= currentPage === 'shop' ? 'font-semibold text-gray-900 border-b-2 border-gray-900 pb-0.5' : 'font-medium text-gray-500 hover:text-gray-900 transition' %>">SHOP</a>
      <a href="/about" class="text-sm <%= currentPage === 'about' ? 'font-semibold text-gray-900 border-b-2 border-gray-900 pb-0.5' : 'font-medium text-gray-500 hover:text-gray-900 transition' %>">ABOUT</a>
      <a href="/contact" class="text-sm <%= currentPage === 'contact' ? 'font-semibold text-gray-900 border-b-2 border-gray-900 pb-0.5' : 'font-medium text-gray-500 hover:text-gray-900 transition' %>">CONTACT</a>
    </div>
  </div>
</nav>

<!-- Dropdown Logic -->
<script>
  (function() {
    const profileBtn = document.getElementById('profileBtn');
    const profileDropdown = document.getElementById('profileDropdown');
    const profileWrap = document.getElementById('profileWrap');
    if (profileBtn && profileDropdown && profileWrap) {
      profileBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        profileDropdown.classList.toggle('open');
      });
      document.addEventListener('click', function(e) {
        if (!profileWrap.contains(e.target)) {
          profileDropdown.classList.remove('open');
        }
      });
    }
  })();
</script>

<%- include('../sweetalert.ejs') %>
