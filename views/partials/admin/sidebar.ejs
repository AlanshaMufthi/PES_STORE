<style>
    :root {
      --primary-color: #6366f1;
      --primary-hover: #4f46e5;
      --bg-sidebar: #0f172a;
      --text-sidebar: #94a3b8;
      --text-active: #ffffff;
      --bg-active: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      --danger-color: #ef4444;
      --sidebar-width: 260px;
    }

    .sidebar {
      width: var(--sidebar-width);
      flex-shrink: 0;
      padding: 32px 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: var(--bg-sidebar);
      min-height: 100vh;
      box-shadow: 4px 0 15px rgba(0, 0, 0, 0.1);
      position: relative;
      z-index: 100;
    }

    .sidebar-brand {
      padding: 0 16px 32px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-logo {
      width: 40px; height: 40px; background: var(--bg-active);
      border-radius: 12px; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    }
    .brand-name { font-size: 1.4rem; font-weight: 800; color: #fff; letter-spacing: -0.02em; }

    .nav-item {
      display: flex; align-items: center; gap: 14px;
      padding: 12px 18px; border-radius: 14px;
      font-size: 0.95rem; font-weight: 600; color: var(--text-sidebar);
      cursor: pointer; text-decoration: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid transparent;
    }
    .nav-item:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      transform: translateX(4px);
    }
    .nav-item.active {
      background: var(--bg-active);
      color: var(--text-active);
      box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }
    .nav-item svg { flex-shrink: 0; transition: color 0.2s; }
    .nav-item.active svg { color: #fff; }
    
    .nav-divider { height: 1px; background: rgba(255, 255, 255, 0.05); margin: 16px 12px; }
    
    .nav-item.logout {
      margin-top: auto;
      color: var(--danger-color);
    }
    .nav-item.logout:hover {
      background: rgba(239, 68, 68, 0.1);
      color: #ff7e7e;
    }
</style>

<aside class="sidebar">
