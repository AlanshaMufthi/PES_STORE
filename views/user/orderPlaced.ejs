<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Placed - PES</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<%- include('../partials/user/header.ejs', { page: 'orders', cartCount: locals.cartCount || 0, searchQuery: locals.searchQuery || '' }) %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --black: #0a0a0a;
    --white: #ffffff;
    --gray-200: #e8e8e8;
    --gray-600: #555555;
    --border: #e2e2e2;
    --green: #27ae60;
    --radius: 4px;
  }

  body { font-family: 'DM Sans', sans-serif; background: var(--white); color: var(--black); }

  .success-wrapper {
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 24px;
  }

  .success-card {
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 28px 36px;
    text-align: center;
    width: 100%;
    max-width: 460px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }

  .success-icon {
    width: 52px;
    height: 52px;
    background: #2980b9;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
    animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .success-icon svg { width: 26px; height: 26px; stroke: white; stroke-width: 3; fill: none; }

  .success-title {
    font-family: 'Syne', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 18px;
    color: var(--black);
  }

  .order-detail-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    margin-bottom: 10px;
  }

  .order-detail-table tr {
    border-bottom: 1px solid var(--border);
  }

  .order-detail-table tr:last-child { border-bottom: none; }

  .order-detail-table td {
    padding: 8px 6px;
    font-size: 0.82rem;
  }

  .order-detail-table td:first-child {
    color: var(--gray-600);
    width: 48%;
  }

  .order-detail-table td:last-child {
    font-weight: 600;
    text-align: right;
  }

  .eta {
    font-family: 'Syne', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--green);
    margin: 14px 0;
  }

  .action-btns {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-secondary {
    padding: 10px 22px;
    background: var(--black);
    color: var(--white);
    border: none;
    border-radius: var(--radius);
    font-family: 'Syne', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s;
  }
  .btn-secondary:hover { background: #333; }

  .btn-primary {
    padding: 10px 22px;
    background: #2980b9;
    color: var(--white);
    border: none;
    border-radius: var(--radius);
    font-family: 'Syne', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: #2471a3; }

  @keyframes popIn {
    0% { transform: scale(0.6); opacity: 0; }
    70% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .success-card > * {
    animation: fadeUp 0.4s ease forwards;
    opacity: 0;
  }

  .success-card > *:nth-child(1) { animation-delay: 0.1s; }
  .success-card > *:nth-child(2) { animation-delay: 0.2s; }
  .success-card > *:nth-child(3) { animation-delay: 0.3s; }
  .success-card > *:nth-child(4) { animation-delay: 0.4s; }
  .success-card > *:nth-child(5) { animation-delay: 0.5s; }
  .success-card > *:nth-child(6) { animation-delay: 0.55s; }
</style>

<div class="success-wrapper">
  <div class="success-card">
    <div class="success-icon">
      <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
    </div>

    <div class="success-title">Payment Successful</div>

    <table class="order-detail-table">
      <tr>
        <td>Order ID</td>
        <td><%= order.orderId || order._id %></td>
      </tr>
      <tr>
        <td>Date</td>
        <td><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></td>
      </tr>
      <tr>
        <td>Time</td>
        <td><%= new Date(order.createdAt).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' }) %></td>
      </tr>
      <tr>
        <td>Payment Method</td>
        <td><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod.toUpperCase() %></td>
      </tr>
      <tr>
        <td>Amount</td>
        <td>₹<%= order.total ? order.total.toLocaleString('en-IN') : '0' %></td>
      </tr>
    </table>

    <% if (order.estimatedDelivery) { %>
    <div class="eta">
      Arriving By <%= new Date(order.estimatedDelivery).toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %>
    </div>
    <% } else { %>
    <div class="eta">Arriving in 5–7 Business Days</div>
    <% } %>

    <div class="action-btns">
      <a href="/orders/<%= order._id %>" class="btn-secondary">View Order</a>
      <a href="/shop" class="btn-primary">Continue Shopping</a>
    </div>
  </div>
</div>

<%- include('../partials/user/footer.ejs') %>
</body>
</html>
