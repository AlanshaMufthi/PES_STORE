<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cart – PES</title>
   
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">

<style>
  .profile-dropdown {
    position: absolute; right: 0; top: calc(100% + 10px);
    background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12); min-width: 160px;
    z-index: 100; overflow: hidden; display: none;
  }
  .profile-dropdown.open { display: block; }
  .profile-dropdown a {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    font-size: 0.82rem; font-weight: 600; color: #111;
    text-decoration: none; transition: background 0.15s;
  }
  .profile-dropdown a:hover { background: #f5f5f5; }
  .profile-dropdown a.logout { color: #e63946; }
  .profile-dropdown .divider { height: 1px; background: #eee; margin: 2px 0; }
  .profile-wrap { position: relative; }
  .icon-btn {
    background: none; border: none; cursor: pointer; padding: 6px;
    border-radius: 6px; display: flex; align-items: center;
    justify-content: center; color: #111;
  }
  .icon-btn:hover { background: #f3f3f3; }
  .cart-wrap { position: relative; display: flex; align-items: center; }
  .cart-count {
    position: absolute; top: -7px; right: -7px;
    background: #e63946; color: #fff; font-size: 0.6rem; font-weight: 800;
    width: 16px; height: 16px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .search-input {
    background: #f3f3f3; border: 1px solid #ddd; border-radius: 6px;
    padding: 0.35rem 2rem 0.35rem 0.75rem; font-size: 0.8rem;
    outline: none; width: 180px; color: #555;
  }
  .search-wrap { position: relative; }
</style>
  <style>
    body { font-family: 'Barlow', sans-serif; }
    .oos-content { opacity: 0.55; pointer-events: none; }
    .oos-content a { pointer-events: auto; }
    .qty-btn:disabled { opacity: 0.35; cursor: not-allowed; }
  </style>
</head>
<body class="bg-white text-gray-900">

  <%- include('../partials/user/header.ejs', { page: 'cart', searchQuery: '', cartCount }) %>

  <main class="max-w-5xl mx-auto px-6 py-12">

    <% if (!cartItems || cartItems.length === 0) { %>
      <!-- Empty cart -->
      <div class="text-center py-24">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto mb-5 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.35 6.39A1 1 0 007 21h10a1 1 0 00.99-.85L19 13M7 13H5.4M10 21a1 1 0 100-2 1 1 0 000 2zm7 0a1 1 0 100-2 1 1 0 000 2z"/>
        </svg>
        <p class="text-lg font-semibold text-gray-700 mb-2">Your cart is empty</p>
        <p class="text-sm text-gray-400 mb-6">Looks like you haven't added anything yet.</p>
        <a href="/shop" class="inline-block bg-black text-white px-8 py-3 rounded-xl font-semibold hover:bg-gray-800 transition-colors">
          Shop Now
        </a>
      </div>

    <% } else { %>

      <% if (hasUnavailable) { %>
        <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 text-sm font-medium px-4 py-3 rounded-xl mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
          </svg>
          Some items in your cart are currently unavailable. Remove them to proceed to checkout.
        </div>
      <% } %>

      <!-- Cart Items -->
      <div class="space-y-6 mb-10">
        <% cartItems.forEach(item => { %>
          <%
            // FIX: null-safe guard — skip rendering this item entirely if product is missing
            if (!item.product) return;
            const oos = item.unavailable
            const maxQty = Math.min(item.stockAvailable || 0, 5)
          %>

          <div id="cart-item-<%= item._id %>"
               class="flex items-start gap-5 pb-6 border-b border-gray-100 <%= oos ? 'bg-gray-50 rounded-xl px-3 pt-3' : '' %>">

            <!-- IMAGE + INFO wrapped in oos-content so they grey out -->
            <div class="flex items-start gap-5 flex-1 min-w-0 <%= oos ? 'oos-content' : '' %>">

              <!-- Image — FIX: null-safe product._id -->
              <a href="/product/<%= item.product._id %>"
                 class="w-24 h-24 bg-gray-100 rounded-xl overflow-hidden flex-shrink-0 relative">
                <img src="<%= item.product.productImage?.[0] || '' %>"
                     alt="<%= item.product.productname || 'Product' %>"
                     class="w-full h-full object-contain p-2 <%= oos ? 'grayscale' : '' %>"/>
                <% if (oos) { %>
                  <div class="absolute inset-0 bg-black/40 flex items-center justify-center rounded-xl">
                    <span class="text-white text-[9px] font-bold uppercase tracking-wider text-center leading-tight px-1">Not<br/>Available</span>
                  </div>
                <% } %>
              </a>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2 flex-wrap">
                  <div>
                    <p class="font-bold text-sm uppercase tracking-wide leading-tight mb-1">
                      <%= item.product.productname || 'Unknown Product' %>
                    </p>
                    <p class="text-xs text-gray-400 mb-2"><%= item.product.brand || '' %></p>

                    <div class="flex items-center gap-2 flex-wrap">
                      <% if (!oos) { %>
                        <span class="font-bold text-sm">₹<%= (item.price || 0).toLocaleString('en-IN') %></span>
                        <% if (item.variant && item.variant.offerActive) { %>
                          <span class="text-xs text-gray-400 line-through">₹<%= (item.variant.productPrice || 0).toLocaleString('en-IN') %></span>
                        <% } %>
                      <% } %>
                      <span class="bg-gray-100 text-gray-700 text-xs font-semibold px-2.5 py-1 rounded-lg"><%= item.size %></span>

                      <% if (oos) { %>
                        <span class="bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-lg">Unavailable</span>
                      <% } else if (item.stockAvailable <= 3) { %>
                        <span class="bg-orange-100 text-orange-600 text-xs font-semibold px-2.5 py-1 rounded-lg">
                          Only <%= item.stockAvailable %> left!
                        </span>
                      <% } else { %>
                        <span class="bg-green-100 text-green-600 text-xs font-semibold px-2.5 py-1 rounded-lg">In Stock</span>
                      <% } %>
                    </div>

                    <% if (!oos) { %>
                      <p class="text-xs text-gray-400 mt-2">
                        Item total: <span class="font-semibold text-gray-700" id="item-total-<%= item._id %>">
                          ₹<%= ((item.price || 0) * (item.quantity || 0)).toLocaleString('en-IN') %>
                        </span>
                      </p>
                    <% } %>

                    <% if (oos) { %>
                      <p class="text-xs text-red-400 mt-2 font-medium">
                        This item is currently unavailable. Remove it to proceed.
                      </p>
                    <% } %>
                  </div>
                </div>
              </div>

            </div>

            <!-- Quantity & Remove -->
            <div class="flex flex-col items-end gap-3 flex-shrink-0">

              <button
                onclick="removeFromCart('<%= item._id %>')"
                class="flex items-center gap-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
                Remove
              </button>

              <% if (!oos) { %>
                <div class="flex items-center gap-0 border border-gray-200 rounded-lg overflow-hidden">
                  <button
                    onclick="updateQty('<%= item._id %>', -1, <%= item.price || 0 %>, <%= maxQty %>)"
                    class="qty-btn px-2.5 py-1.5 text-gray-500 hover:bg-gray-100 transition-colors text-sm"
                    id="minus-<%= item._id %>"
                    <%= (item.quantity || 1) <= 1 ? 'disabled' : '' %>
                  >−</button>

                  <span id="qty-<%= item._id %>"
                        class="px-3 text-sm font-semibold min-w-[2rem] text-center">
                    <%= item.quantity || 1 %>
                  </span>

                  <button
                    onclick="updateQty('<%= item._id %>', 1, <%= item.price || 0 %>, <%= maxQty %>)"
                    class="qty-btn px-2.5 py-1.5 text-gray-500 hover:bg-gray-100 transition-colors text-sm"
                    id="plus-<%= item._id %>"
                    <%= (item.quantity || 1) >= maxQty ? 'disabled' : '' %>
                  >+</button>
                </div>

                <% if ((item.quantity || 1) >= maxQty) { %>
                  <p class="text-[10px] text-gray-400 text-right">
                    <% if (item.stockAvailable <= 5) { %>
                      Max stock reached
                    <% } else { %>
                      Max 5 per item
                    <% } %>
                  </p>
                <% } %>
              <% } %>

            </div>

          </div>
        <% }) %>
      </div>

      <!-- Cart Total -->
      <div class="flex justify-center">
        <div class="border border-gray-200 rounded-2xl p-6 w-full max-w-sm">
          <h2 class="font-bold text-base mb-4">Cart Total</h2>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between pb-3 border-b border-gray-100">
              <span class="text-gray-600">Subtotal:</span>
              <span class="font-semibold" id="subtotalDisplay">₹<%= (subtotal || 0).toLocaleString('en-IN', {minimumFractionDigits:2}) %></span>
            </div>
            <div class="flex justify-between pb-3 border-b border-gray-100">
              <span class="text-gray-600">Shipping:</span>
              <span class="font-semibold text-green-600">Free</span>
            </div>
            <div class="flex justify-between">
              <span class="font-bold">Total:</span>
              <span class="font-bold" id="totalDisplay">₹<%= (subtotal || 0).toLocaleString('en-IN', {minimumFractionDigits:2}) %></span>
            </div>
          </div>

          <% if (hasUnavailable && subtotal === 0) { %>
            <button disabled
              class="mt-6 block w-full bg-gray-300 text-gray-500 text-center py-3 rounded-xl font-semibold cursor-not-allowed">
              Remove unavailable items to checkout
            </button>
          <% } else { %>
            <a href="/checkout"
               class="mt-6 block w-full bg-black text-white text-center py-3 rounded-xl font-semibold hover:bg-gray-800 transition-colors">
              Proceed to Checkout
            </a>
          <% } %>
        </div>
      </div>

    <% } %>

  </main>

  <%- include('../partials/user/footer.ejs') %>

  <script>
    function updateCartBadge(count) {
      const badge = document.getElementById('headerCartCount')
        || document.querySelector('[data-cart-count]')
        || document.querySelector('.cart-count-badge')
      if (!badge) return
      const n = parseInt(count) || 0
      badge.textContent = n
      badge.style.display = n > 0 ? '' : 'none'
    }

    async function removeFromCart(itemId) {
      try {
        const res = await fetch(`/cart/remove/${itemId}`, { method: 'DELETE' })
        const data = await res.json()
        if (data.success) {
          document.getElementById(`cart-item-${itemId}`)?.remove()
          updateTotals(data.subtotal)
          if (data.cartCount !== undefined) updateCartBadge(data.cartCount)
          showToast('Item removed')
          if (data.cartCount === 0) location.reload()
        } else {
          showToast(data.message || 'Error removing item')
        }
      } catch {
        showToast('Error removing item')
      }
    }

    async function updateQty(itemId, delta, unitPrice, maxQty) {
      const el       = document.getElementById(`qty-${itemId}`)
      const minusBtn = document.getElementById(`minus-${itemId}`)
      const plusBtn  = document.getElementById(`plus-${itemId}`)

      const currentQty = parseInt(el.textContent)
      const newQty = currentQty + delta

      if (newQty < 1 || newQty > maxQty) return

      try {
        const res = await fetch(`/cart/update/${itemId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quantity: newQty })
        })
        const data = await res.json()

        if (data.success) {
          el.textContent = newQty
          const itemTotal = document.getElementById(`item-total-${itemId}`)
          if (itemTotal) {
            itemTotal.textContent = '₹' + (unitPrice * newQty).toLocaleString('en-IN')
          }
          if (minusBtn) minusBtn.disabled = newQty <= 1
          if (plusBtn)  plusBtn.disabled  = newQty >= maxQty
          updateTotals(data.subtotal)
        } else {
          showToast(data.message || 'Could not update quantity')
          if (data.message && data.message.includes('Only')) {
            if (plusBtn) plusBtn.disabled = true
          }
        }
      } catch {
        showToast('Error updating quantity')
      }
    }

    function updateTotals(subtotal) {
      if (subtotal === undefined) return
      const fmt = '₹' + subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2 })
      const s = document.getElementById('subtotalDisplay')
      const t = document.getElementById('totalDisplay')
      if (s) s.textContent = fmt
      if (t) t.textContent = fmt
    }

    function showToast(msg) {
      const t = document.createElement('div')
      t.className = 'fixed bottom-6 right-6 bg-black text-white px-5 py-3 rounded-xl text-sm shadow-lg z-50 transition-opacity'
      t.textContent = msg
      document.body.appendChild(t)
      setTimeout(() => t.remove(), 2800)
    }
  </script>
</body>
</html>
