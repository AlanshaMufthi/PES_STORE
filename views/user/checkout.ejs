  <script>
    // ── Payment option visual selection ──
    document.querySelectorAll('input[name="payment"]').forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.pay-option').forEach(el => el.classList.remove('selected'));
        radio.closest('.pay-option').classList.add('selected');
        hideError('paymentError', 'paymentSection');
      });
    });

    // ── Address card highlight ──
    document.querySelectorAll('input[name="delivery_address"]').forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.address-card').forEach(el => el.classList.remove('selected'));
        radio.closest('.address-card').classList.add('selected');
        hideError('addressError', 'addressSection');
      });
    });

    function showError(errorId, sectionId) {
      const err = document.getElementById(errorId);
      if (err) { err.classList.add('show'); err.scrollIntoView({ behavior:'smooth', block:'center' }); }
    }
    function hideError(errorId) {
      const err = document.getElementById(errorId);
      if (err) err.classList.remove('show');
    }

    // ── Coupon ──
    async function applyCoupon() {
      const code = document.getElementById('couponInput').value.trim();
      const msgEl = document.getElementById('couponMsg');
      if (!code) { msgEl.textContent = 'Please enter a coupon code.'; msgEl.className = 'text-xs mt-2 text-red-500'; msgEl.classList.remove('hidden'); return; }
      try {
        const res = await fetch('/checkout/apply-coupon', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ coupon: code }) });
        const data = await res.json();
        if (data.success) { msgEl.textContent = `✓ Coupon applied! You saved ₹${data.discount}`; msgEl.className = 'text-xs mt-2 text-green-600'; }
        else { msgEl.textContent = data.message || 'Invalid coupon code.'; msgEl.className = 'text-xs mt-2 text-red-500'; }
        msgEl.classList.remove('hidden');
      } catch { msgEl.textContent = 'Could not apply coupon. Try again.'; msgEl.className = 'text-xs mt-2 text-red-500'; msgEl.classList.remove('hidden'); }
    }

    // ── Place Order ──
    document.getElementById('checkoutForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const address = document.querySelector('input[name="delivery_address"]:checked');
      const payment = document.querySelector('input[name="payment"]:checked');
      hideError('addressError'); hideError('paymentError');
      if (!address) { showError('addressError', 'addressSection'); return; }
      if (!payment) { showError('paymentError', 'paymentSection'); return; }
      try {
        const csrfToken = document.querySelector('input[name="_csrf"]').value;
        const res = await fetch('/checkout/place-order', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ addressId: address.value, paymentMethod: payment.value, _csrf: csrfToken })
        });
        const data = await res.json();
        if (data.success) { window.location.href = data.url; }
        else { Swal.fire({ icon:'error', title:'Order Failed', text: data.message || 'Could not place order. Please try again.', confirmButtonColor:'#111' }); }
      } catch { Swal.fire({ icon:'error', title:'Something went wrong', text:'An unexpected error occurred. Please try again.', confirmButtonColor:'#111' }); }
    });
  </script>
