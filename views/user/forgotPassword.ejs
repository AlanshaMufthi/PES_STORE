<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | 2ES</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Nunito', sans-serif;
      min-height: 100vh;
      background: #111;
      position: relative;
      overflow: hidden;
    }

    /* ── Background image ── */
    .bg-image {
      position: fixed;
      inset: 0;
      background: url('/images/stadium-bg.jpg') center center / cover no-repeat;
      filter: grayscale(100%) brightness(0.45);
      z-index: 0;
    }

    /* ── Navbar ── */
    .navbar {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 22px 60px;
      gap: 0;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 48px;
      list-style: none;
      margin-right: auto;
      margin-left: auto;
    }

    .nav-links a {
      font-family: 'Cinzel', serif;
      font-size: 0.82rem;
      font-weight: 600;
      color: #fff;
      text-decoration: none;
      letter-spacing: 0.08em;
      position: relative;
      transition: color 0.2s;
    }

    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0; right: 0;
      height: 2px;
      background: #fff;
      border-radius: 2px;
    }

    .nav-links a:hover { color: #ddd; }

    .nav-auth {
      display: flex;
      align-items: center;
      gap: 12px;
      position: absolute;
      right: 60px;
    }

    .btn-login {
      padding: 9px 24px;
      border-radius: 999px;
      border: 2px solid #fff;
      background: #fff;
      color: #111;
      font-family: 'Nunito', sans-serif;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }

    .btn-login:hover { background: transparent; color: #fff; }

    .btn-signup {
      padding: 9px 24px;
      border-radius: 999px;
      border: 2px solid #fff;
      background: transparent;
      color: #fff;
      font-family: 'Nunito', sans-serif;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }

    .btn-signup:hover { background: #fff; color: #111; }

    /* ── Main card ── */
    .page-wrap {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 80px);
      padding: 20px;
    }

    .card {
      background: rgba(180, 180, 180, 0.18);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 28px;
      width: 100%;
      max-width: 900px;
      min-height: 480px;
      display: flex;
      align-items: center;
      padding: 60px 56px;
      gap: 60px;
      animation: fadeUp 0.6s ease both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Left logo ── */
    .card-logo {
      flex-shrink: 0;
      width: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-logo img {
      width: 180px;
      height: 180px;
      object-fit: contain;
      filter: brightness(0) invert(0); /* keeps logo dark as in design */
      opacity: 0.85;
    }

    /* ── Right form ── */
    .card-form {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .card-form h1 {
      font-family: 'Cinzel', serif;
      font-size: 2rem;
      font-weight: 700;
      color: #1a1a1a;
      letter-spacing: 0.02em;
      margin-bottom: 4px;
    }

    .card-form p {
      font-size: 0.92rem;
      font-weight: 600;
      color: #333;
      margin-bottom: 4px;
    }

    /* Error message */
    .error-msg {
      color: #e63946;
      font-size: 0.85rem;
      font-weight: 700;
      display: none;
    }

    .success-msg {
      color: #22c55e;
      font-size: 0.85rem;
      font-weight: 700;
      display: none;
    }

    /* ── Input ── */
    .input-wrap {
      position: relative;
    }

    .input-wrap input {
      width: 100%;
      padding: 16px 20px;
      border-radius: 10px;
      border: 1.5px solid rgba(255,255,255,0.4);
      background: rgba(255,255,255,0.55);
      font-family: 'Nunito', sans-serif;
      font-size: 0.92rem;
      font-weight: 600;
      color: #222;
      outline: none;
      transition: border 0.2s, background 0.2s;
    }

    .input-wrap input::placeholder { color: #888; font-weight: 500; }

    .input-wrap input:focus {
      border-color: rgba(0,0,0,0.4);
      background: rgba(255,255,255,0.75);
    }

    /* ── Send button ── */
    .btn-send {
      width: 100%;
      padding: 17px;
      border-radius: 10px;
      border: none;
      background: #111;
      color: #fff;
      font-family: 'Cinzel', serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-top: 8px;
    }

    .btn-send:hover { background: #333; transform: translateY(-1px); }
    .btn-send:active { transform: translateY(0); }

    /* ── Flash messages from EJS ── */
    <% if (typeof message !== 'undefined' && message) { %>
    .flash-show { display: block !important; }
    <% } %>
  </style>
</head>
<body>

  <!-- Background -->
  <div class="bg-image"></div>



  <!-- ═══════ MAIN CARD ═══════ -->
  <div class="page-wrap">
    <div class="card">

      <!-- Left: Logo -->
      <div class="card-logo">
        <img src="/img/pes.logo.png" alt="2ES Logo" />
      </div>

      <!-- Right: Form -->
      <div class="card-form">
        <h1>Forgot Password ?</h1>
        <p>Please confirm your mail address!</p>

        <%- include('../partials/sweetalert.ejs') %>

        <form action="/forgotPassword" method="POST">
          <div class="input-wrap" style="margin-bottom: 12px;">
            <input
              type="email"
              name="email"
              placeholder="Enter your Email"
              required
            />
          </div>
          <button type="submit" class="btn-send">Send OTP</button>
        </form>
      </div>

    </div>
  </div>

</body>
</html>
