<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= product.productname %> – PES</title>
<link rel="stylesheet" href="/css/tailwind.css">

<style>
  .profile-dropdown {
    position: absolute; right: 0; top: calc(100% + 10px);
    background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12); min-width: 160px;
    z-index: 100; overflow: hidden; display: none;
  }
  .profile-dropdown.open { display: block; }
  .profile-dropdown a {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    font-size: 0.82rem; font-weight: 600; color: #111;
    text-decoration: none; transition: background 0.15s;
  }
  .profile-dropdown a:hover { background: #f5f5f5; }
  .profile-dropdown a.logout { color: #e63946; }
  .profile-dropdown .divider { height: 1px; background: #eee; margin: 2px 0; }
  .profile-wrap { position: relative; }
  .icon-btn {
    background: none; border: none; cursor: pointer; padding: 6px;
    border-radius: 6px; display: flex; align-items: center;
    justify-content: center; color: #111;
  }
  .icon-btn:hover { background: #f3f3f3; }
  .cart-wrap { position: relative; display: flex; align-items: center; }
  .cart-count {
    position: absolute; top: -7px; right: -7px;
    background: #e63946; color: #fff; font-size: 0.6rem; font-weight: 800;
    width: 16px; height: 16px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .search-input {
    background: #f3f3f3; border: 1px solid #ddd; border-radius: 6px;
    padding: 0.35rem 2rem 0.35rem 0.75rem; font-size: 0.8rem;
    outline: none; width: 180px; color: #555;
  }
  .search-wrap { position: relative; }
</style>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Barlow', sans-serif; }
    .font-display { font-family: 'Barlow Condensed', sans-serif; }

    /* ── Thumbnails ── */
    .thumb-btn { transition: border-color 0.15s, opacity 0.15s; }
    .thumb-btn.active { border-color: #000 !important; }
    .thumb-btn:hover { border-color: #555; }

    /* ── Zoom ── */
    #mainImageWrap { overflow: hidden; cursor: zoom-in; position: relative; }
    #mainImage { transition: transform 0.25s ease; transform-origin: center center; display: block; width: 100%; height: 100%; object-fit: contain; padding: 24px; }
    #mainImageWrap.zoomed { cursor: crosshair; }
    #mainImageWrap.zoomed #mainImage { transform: scale(2.2); cursor: crosshair; }

    /* ── Size buttons ── */
    .size-btn { transition: all 0.15s; }
    .size-btn.selected { background: #000; color: #fff; border-color: #000; }
    .size-btn.oos { opacity: 0.32; cursor: not-allowed; text-decoration: line-through; }

    /* ── Stars ── */
    .star-on  { color: #f59e0b; }
    .star-off { color: #e5e7eb; }

    /* ── Toast ── */
    #toast {
      position: fixed; bottom: 28px; left: 50%;
      transform: translateX(-50%) translateY(20px);
      padding: 11px 22px; border-radius: 100px;
      font-size: 0.84rem; font-weight: 600;
      display: flex; align-items: center; gap: 8px;
      box-shadow: 0 8px 28px rgba(0,0,0,0.18);
      transition: opacity 0.3s, transform 0.35s cubic-bezier(0.34,1.4,0.64,1);
      opacity: 0; z-index: 9999; pointer-events: none; white-space: nowrap;
      background: #111; color: #fff;
    }
    #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    #toast.green { background: #16a34a; }
    #toast.red   { background: #dc2626; }

    /* ── Accordion ── */
    .accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .accordion-body.open { max-height: 400px; }
    .accordion-icon { transition: transform 0.25s; }
    .accordion-btn.open .accordion-icon { transform: rotate(45deg); }

    /* ── Wishlist button ── */
    .wishlist-btn.wishlisted svg { fill: #e11d48; stroke: #e11d48; }

    /* ── OOS overlay on image ── */
    .oos-overlay {
      position: absolute; inset: 0; background: rgba(255,255,255,0.65);
      display: flex; align-items: center; justify-content: center;
      border-radius: inherit; z-index: 2;
    }

    /* ── Review Modal ── */
    #reviewModalOverlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 10000;
      display: flex; align-items: center; justify-content: center;
      padding: 1rem;
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease;
    }
    #reviewModalOverlay.open {
      opacity: 1; pointer-events: all;
    }
    #reviewModal {
      background: #fff;
      border-radius: 20px;
      width: 100%; max-width: 520px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.18);
      transform: translateY(24px) scale(0.97);
      transition: transform 0.28s cubic-bezier(0.34,1.3,0.64,1);
      overflow: hidden;
    }
    #reviewModalOverlay.open #reviewModal {
      transform: translateY(0) scale(1);
    }

    /* ── Review star picker ── */
    .review-star { cursor: pointer; transition: transform 0.1s; font-size: 28px; color: #e5e7eb; }
    .review-star:hover, .review-star.lit { color: #f59e0b; }
    .review-star:active { transform: scale(1.25); }
  </style>
</head>
<body class="bg-white text-gray-900">

  <%- include('../partials/user/header.ejs', { page: 'shop', cartCount, searchQuery }) %>

  <!-- Toast -->
  <div id="toast"><span id="toastMsg"></span></div>

  <!-- ══════════════════════════════════════════
       WRITE REVIEW MODAL
  ══════════════════════════════════════════ -->
  <div id="reviewModalOverlay" role="dialog" aria-modal="true" aria-labelledby="reviewModalTitle"
       onclick="handleOverlayClick(event)">
    <div id="reviewModal">

      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <h2 id="reviewModalTitle" class="font-bold text-base font-display tracking-wide uppercase">Write a Review</h2>
        <button onclick="closeReviewModal()"
          class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors text-gray-400 hover:text-gray-700">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Form -->
      <div id="reviewForm" class="px-6 py-5 space-y-5">

        <!-- Star rating -->
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Your Rating <span class="text-red-400">*</span></p>
          <div class="flex items-center gap-1" id="starPicker">
            <span class="review-star" data-val="1">&#9733;</span>
            <span class="review-star" data-val="2">&#9733;</span>
            <span class="review-star" data-val="3">&#9733;</span>
            <span class="review-star" data-val="4">&#9733;</span>
            <span class="review-star" data-val="5">&#9733;</span>
          </div>
          <p id="ratingLabel" class="text-xs text-gray-400 mt-1">Tap to rate</p>
        </div>

        <!-- Title -->
        <div>
          <label class="text-xs font-bold uppercase tracking-widest text-gray-400 block mb-1.5">Review Title</label>
          <input id="reviewTitle" type="text" maxlength="100"
            placeholder="Summarise your experience..."
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 transition-colors"/>
        </div>

        <!-- Comment -->
        <div>
          <label class="text-xs font-bold uppercase tracking-widest text-gray-400 block mb-1.5">Review <span class="text-red-400">*</span></label>
          <textarea id="reviewComment" rows="4" maxlength="1000"
            placeholder="Tell others what you think about this product..."
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-gray-500 transition-colors resize-none leading-relaxed"></textarea>
          <p class="text-xs text-gray-300 text-right mt-1"><span id="bodyCount">0</span> / 1000</p>
        </div>

        <!-- Photo upload -->
        <div>
          <label class="text-xs font-bold uppercase tracking-widest text-gray-400 block mb-1.5">
            Photos <span class="font-normal text-gray-300">(optional, max 4)</span>
          </label>
          <label for="reviewImgsInput"
            class="flex flex-col items-center justify-center gap-1.5 border border-dashed border-gray-200 rounded-xl py-4 px-3 cursor-pointer hover:border-gray-400 hover:bg-gray-50 transition-colors">
            <svg class="w-5 h-5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span class="text-xs text-gray-400">Click to upload photos</span>
            <input id="reviewImgsInput" type="file" name="reviewImgs" accept="image/*" multiple class="hidden" onchange="previewReviewImgs(this)"/>
          </label>
          <!-- Preview thumbnails -->
          <div id="reviewImgPreviews" class="flex flex-wrap gap-2 mt-2"></div>
        </div>

        <!-- Error -->
        <p id="reviewError" class="hidden text-xs text-red-500 bg-red-50 px-3 py-2 rounded-lg"></p>

        <!-- Submit -->
        <button id="submitReviewBtn" onclick="submitReview()"
          class="w-full bg-black text-white py-3.5 rounded-2xl font-bold text-sm uppercase tracking-wide hover:bg-gray-800 transition-colors">
          Submit Review
        </button>
      </div>

      <!-- Success state -->
      <div id="reviewSuccess" class="hidden px-6 py-10 text-center">
        <div class="w-14 h-14 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h3 class="font-bold text-lg font-display uppercase tracking-wide mb-1">Thank You!</h3>
        <p class="text-sm text-gray-500">Your review has been submitted successfully.</p>
        <button onclick="closeReviewModal()"
          class="mt-5 px-6 py-2.5 border border-gray-200 rounded-xl text-sm font-semibold hover:bg-gray-50 transition-colors">
          Close
        </button>
      </div>

    </div>
  </div>
  <!-- END REVIEW MODAL -->

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <!-- ── Breadcrumbs ── -->
    <nav class="flex items-center gap-2 text-xs text-gray-400 mb-6 flex-wrap">
      <% breadcrumbs.forEach((crumb, i) => { %>
        <% if (crumb.href) { %>
          <a href="<%= crumb.href %>" class="hover:text-black transition-colors"><%= crumb.label %></a>
        <% } else { %>
          <span class="text-gray-700 font-semibold"><%= crumb.label %></span>
        <% } %>
        <% if (i < breadcrumbs.length - 1) { %>
          <svg class="w-3 h-3 text-gray-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        <% } %>
      <% }) %>
    </nav>

    <!-- ── PRODUCT SECTION ── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20">

      <!-- Left: Images -->
      <div class="flex gap-3">
        <!-- Thumbnails -->
        <div class="flex flex-col gap-2 w-16 flex-shrink-0">
          <% product.productImage.forEach((img, i) => { %>
            <button
              onclick="setMainImage('<%= img %>', this)"
              class="thumb-btn rounded-xl overflow-hidden border-2 aspect-square flex-shrink-0 bg-gray-50 <%= i === 0 ? 'active border-black' : 'border-gray-200' %>">
              <img src="<%= img %>" alt="view <%= i+1 %>" class="w-full h-full object-contain p-1" loading="lazy"/>
            </button>
          <% }) %>
        </div>

        <!-- Main image with zoom -->
        <div class="flex-1 flex flex-col gap-2">
          <div id="mainImageWrap"
            class="bg-gray-50 rounded-2xl flex items-center justify-center aspect-square border border-gray-100 select-none"
            onclick="toggleZoom(event)"
            onmousemove="moveZoom(event)">
            <img id="mainImage"
              src="<%= product.productImage[0] %>"
              alt="<%= product.productname %>"/>
            <% if (!hasStock) { %>
              <div class="oos-overlay">
                <span class="bg-gray-800 text-white text-xs font-bold px-4 py-2 rounded-full uppercase tracking-widest">Out of Stock</span>
              </div>
            <% } %>
          </div>
          <p class="text-center text-xs text-gray-400">Click image to zoom · Move mouse to pan</p>
        </div>
      </div>

      <!-- Right: Details -->
      <div>

        <!-- Brand + name -->
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1"><%= product.brand %></p>
        <h1 class="text-2xl sm:text-3xl font-bold leading-snug mb-3 font-display tracking-wide uppercase"><%= product.productname %></h1>

        <!-- Ratings -->
        <% if (reviews.length > 0) { %>
          <div class="flex items-center gap-2 mb-4">
            <div class="flex items-center gap-0.5">
              <% for(let i=1;i<=5;i++) { %>
                <svg class="w-4 h-4 <%= i<=Math.round(avgRating) ? 'star-on' : 'star-off' %>" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              <% } %>
            </div>
            <span class="text-sm font-bold"><%= avgRating.toFixed(1) %></span>
            <a href="#reviews" class="text-xs text-gray-400 hover:text-black underline transition-colors">
              <%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %>
            </a>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-400 mb-4">No reviews yet — <a href="#reviews" class="underline hover:text-black">be the first</a></p>
        <% } %>

        <!-- Price & discounts -->
        <div class="flex items-baseline gap-3 mb-4 flex-wrap">
          <% if (firstAvailable) { %>
            <span id="displayPrice" class="text-3xl font-bold">
              ₹<%= (firstAvailable.offerActive ? firstAvailable.offerPrice : firstAvailable.productPrice).toLocaleString('en-IN') %>
            </span>
            <% if (firstAvailable.offerActive && firstAvailable.discountPct > 0) { %>
              <span id="basePrice" class="text-gray-400 line-through text-base">
                ₹<%= firstAvailable.productPrice.toLocaleString('en-IN') %>
              </span>
              <span id="discountBadge" class="bg-red-100 text-red-600 text-xs font-bold px-2.5 py-1 rounded-full">
                -<%= firstAvailable.discountPct %>% OFF
              </span>
              <span class="text-green-600 text-xs font-semibold">
                Save ₹<%= (firstAvailable.productPrice - firstAvailable.offerPrice).toLocaleString('en-IN') %>
              </span>
            <% } else { %>
              <span id="basePrice" class="hidden"></span>
              <span id="discountBadge" class="hidden"></span>
            <% } %>
          <% } else { %>
            <span id="displayPrice" class="text-3xl font-bold text-gray-300">—</span>
            <span id="basePrice" class="hidden"></span>
            <span id="discountBadge" class="hidden"></span>
          <% } %>
        </div>

        <!-- Stock status badge -->
        <div class="flex items-center gap-3 mb-5">
          <div id="stockBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold
            <%= isFullyArchived ? 'bg-gray-100 text-gray-500' : hasStock ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-600' %>">
            <span class="w-1.5 h-1.5 rounded-full inline-block
              <%= isFullyArchived ? 'bg-gray-400' : hasStock ? 'bg-green-500' : 'bg-red-500' %>">
            </span>
            <span id="stockText">
              <%= isFullyArchived ? 'Currently Unavailable' : hasStock ? 'In Stock' : 'Out of Stock' %>
            </span>
          </div>
        </div>

        <!-- Chips -->
        <div class="flex flex-wrap gap-2 mb-6">
          <% if (product.category) { %>
            <a href="/shop?category=<%= product.category._id %>"
               class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-3 py-1 rounded-full font-medium transition-colors">
              <%= product.category.name %>
            </a>
          <% } %>
          <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full font-medium"><%= product.collection %></span>
          <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full font-medium"><%= product.gender %></span>
        </div>

        <!-- Size selector -->
        <% if (sizeVariantMap.length > 0) { %>
          <div class="mb-6">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm font-bold uppercase tracking-wide">Select Size <span class="font-normal text-gray-400">(UK)</span></p>
              <p id="sizeError" class="text-xs text-red-500 hidden">Please select a size</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <% sizeVariantMap.forEach(sv => { %>
                <button
                  onclick="selectSize('<%= sv.size %>', this,
                    <%= sv.sellingPrice %>,
                    <%= sv.productPrice %>,
                    <%= sv.discountPct || 0 %>,
                    <%= sv.available %>,
                    <%= sv.stock %>,
                    '<%= sv.variantId %>')"
                  class="size-btn min-w-[48px] h-12 px-3 rounded-xl border text-sm font-semibold
                    <%= !sv.available ? 'oos border-gray-200 text-gray-300 bg-gray-50' : 'border-gray-300 hover:border-black bg-white' %>"
                  <%= !sv.available ? 'disabled' : '' %>
                  data-size="<%= sv.size %>"
                  data-available="<%= sv.available %>">
                  <%= sv.size %>
                </button>
              <% }) %>
            </div>
            <input type="hidden" id="selectedSize" value=""/>
            <input type="hidden" id="selectedVariantId" value=""/>
          </div>
        <% } else { %>
          <div class="mb-6 p-3 bg-amber-50 border border-amber-200 rounded-xl">
            <p class="text-xs text-amber-700 font-medium">No size variants are currently available for this product.</p>
          </div>
        <% } %>

        <!-- Quantity -->
        <% if (hasStock) { %>
          <div class="mb-6">
            <p class="text-sm font-bold uppercase tracking-wide mb-3">Quantity</p>
            <div class="flex items-center gap-3">
              <button onclick="changeQty(-1)"
                class="w-10 h-10 border border-gray-300 rounded-xl text-lg flex items-center justify-center hover:bg-gray-50 transition-colors font-bold">−</button>
              <span id="qtyDisplay" class="w-10 text-center font-bold text-lg">1</span>
              <button onclick="changeQty(1)"
                class="w-10 h-10 border border-gray-300 rounded-xl text-lg flex items-center justify-center hover:bg-gray-50 transition-colors font-bold">+</button>
            </div>
          </div>
        <% } %>

        <!-- Action buttons -->
        <% if (hasStock) { %>
          <div class="flex gap-3 mb-6">
            <button onclick="addToCart()"
              class="flex-1 bg-black text-white py-3.5 rounded-2xl font-bold hover:bg-gray-800 transition-colors text-sm uppercase tracking-wide">
              Add to Cart
            </button>
            <button onclick="buyNow()"
              class="flex-1 border-2 border-black py-3.5 rounded-2xl font-bold hover:bg-black hover:text-white transition-colors text-sm uppercase tracking-wide">
              Buy Now
            </button>
            <button id="wishlistBtn"
              onclick="toggleWishlist('<%= product._id %>')"
              class="wishlist-btn w-14 h-14 border border-gray-300 rounded-2xl flex items-center justify-center hover:border-red-400 hover:text-red-500 transition-colors flex-shrink-0 <%= inWishlist ? 'wishlisted' : '' %>"
              title="<%= inWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="<%= inWishlist ? '#e11d48' : 'none' %>" viewBox="0 0 24 24" stroke="<%= inWishlist ? '#e11d48' : 'currentColor' %>" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 016.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"/>
              </svg>
            </button>
          </div>
        <% } else { %>
          <div class="mb-6 p-5 bg-gray-50 border border-gray-200 rounded-2xl text-center">
            <p class="text-sm font-semibold text-gray-500 mb-1">This product is currently out of stock</p>
            <p class="text-xs text-gray-400 mb-4">Save it to your wishlist and we'll let you know when it's back.</p>
            <button id="wishlistBtn"
              onclick="toggleWishlist('<%= product._id %>')"
              class="wishlist-btn w-full border border-gray-300 py-2.5 rounded-xl text-sm font-semibold hover:border-black transition-colors flex items-center justify-center gap-2 <%= inWishlist ? 'wishlisted' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="<%= inWishlist ? '#e11d48' : 'none' %>" viewBox="0 0 24 24" stroke="<%= inWishlist ? '#e11d48' : 'currentColor' %>" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 016.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"/>
              </svg>
              <%= inWishlist ? 'Saved to Wishlist' : 'Save to Wishlist' %>
            </button>
          </div>
        <% } %>

        <!-- Highlights -->
        <% if (highlights && highlights.length > 0) { %>
          <div class="bg-gray-50 rounded-2xl p-4 mb-4">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3">Product Highlights</p>
            <ul class="space-y-2">
              <% highlights.forEach(h => { %>
                <li class="flex items-center gap-2 text-sm text-gray-700">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <%= h %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <!-- Delivery info -->
        <div class="border border-gray-100 rounded-2xl divide-y divide-gray-100 mb-4">
          <div class="flex items-center gap-4 p-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.99-1.83L23 6H6"/>
            </svg>
            <div>
              <p class="text-sm font-semibold">Free Delivery</p>
              <p class="text-xs text-gray-400">On all orders above ₹999</p>
            </div>
          </div>
          <div class="flex items-center gap-4 p-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            <div>
              <p class="text-sm font-semibold">Free 30-Day Returns</p>
              <p class="text-xs text-gray-400">Easy returns, no questions asked</p>
            </div>
          </div>
        </div>

        <!-- Description accordion -->
        <div class="border border-gray-100 rounded-2xl overflow-hidden">
          <button
            onclick="toggleAccordion(this)"
            class="accordion-btn w-full flex items-center justify-between px-5 py-4 text-sm font-bold uppercase tracking-wide hover:bg-gray-50 transition-colors">
            Product Description
            <span class="accordion-icon text-xl leading-none text-gray-400 font-light">+</span>
          </button>
          <div class="accordion-body">
            <div class="px-5 pb-5 pt-3 text-sm text-gray-600 leading-relaxed border-t border-gray-100">
              <p><%= product.description %></p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ── REVIEWS ── -->
    <div id="reviews" class="border-t border-gray-100 pt-10 mb-20">
      <h2 class="text-xl font-bold font-display tracking-wide uppercase mb-6">Customer Reviews</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <!-- Rating summary -->
        <div class="flex flex-col items-center justify-center bg-gray-50 rounded-2xl p-6 text-center">
          <p class="text-5xl font-bold mb-2"><%= avgRating.toFixed(1) %></p>
          <div class="flex items-center gap-0.5 mb-2">
            <% for(let i=1;i<=5;i++) { %>
              <svg class="w-5 h-5 <%= i<=Math.round(avgRating) ? 'star-on' : 'star-off' %>" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            <% } %>
          </div>
          <p class="text-xs text-gray-400"><%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %></p>
        </div>

        <!-- Breakdown bars -->
        <div class="col-span-2 space-y-2 flex flex-col justify-center">
          <% [5,4,3,2,1].forEach(star => { %>
            <% const count = reviews.filter(r => Math.round(r.rating) === star).length %>
            <% const pct   = reviews.length ? Math.round((count/reviews.length)*100) : 0 %>
            <div class="flex items-center gap-3 text-sm">
              <div class="flex items-center gap-0.5 w-20 flex-shrink-0">
                <% for(let i=1;i<=5;i++) { %>
                  <svg class="w-3 h-3 <%= i<=star ? 'text-yellow-400' : 'text-gray-200' %>" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                <% } %>
              </div>
              <div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">
                <div class="bg-yellow-400 h-2 rounded-full" style="width:<%= pct %>%"></div>
              </div>
              <span class="text-xs text-gray-400 w-8 text-right"><%= count %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- ★ Write a Review button — opens modal ★ -->
      <button onclick="openReviewModal()"
        class="inline-flex items-center gap-2 bg-black text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-gray-800 transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
        </svg>
        Write a Review
      </button>

      <!-- Review list -->
      <div id="reviewsList">
        <% if (reviews && reviews.length > 0) { %>
          <div class="space-y-4">
            <% reviews.forEach(review => { %>
              <div class="border border-gray-100 rounded-2xl p-5">
                <div class="flex items-start gap-3 mb-3">
                  <div class="w-10 h-10 bg-gray-100 rounded-full overflow-hidden flex items-center justify-center flex-shrink-0">
                    <% if (review.userId?.avatar) { %>
                      <img src="<%= review.userId.avatar %>" alt="" class="w-full h-full object-cover"/>
                    <% } else { %>
                      <span class="font-bold text-sm text-gray-500">
                        <%= review.userId ? review.userId.name[0].toUpperCase() : 'U' %>
                      </span>
                    <% } %>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between flex-wrap gap-1">
                      <p class="font-bold text-sm"><%= review.userId ? review.userId.name : 'Anonymous' %></p>
                      <span class="text-xs text-gray-400">
                        <%= new Date(review.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
                      </span>
                    </div>
                    <div class="flex items-center gap-0.5 mt-1">
                      <% for(let i=1;i<=5;i++) { %>
                        <svg class="w-3.5 h-3.5 <%= i<=review.rating ? 'text-yellow-400' : 'text-gray-200' %>" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      <% } %>
                    </div>
                  </div>
                </div>
                <% if (review.title) { %>
                  <p class="font-semibold text-sm mb-1"><%= review.title %></p>
                <% } %>
                <p class="text-sm text-gray-600 leading-relaxed"><%= review.reviewComment %></p>
                <% if (review.reviewImgs && review.reviewImgs.length > 0) { %>
                  <div class="flex flex-wrap gap-2 mt-3">
                    <% review.reviewImgs.forEach(img => { %>
                      <img src="<%= img %>" alt="review photo"
                        class="w-16 h-16 object-cover rounded-xl border border-gray-100 cursor-pointer hover:opacity-80 transition-opacity"
                        onclick="openImgLightbox('<%= img %>')"/>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div id="noReviewsMsg" class="text-center py-10 bg-gray-50 rounded-2xl">
            <p class="text-gray-400 text-sm">No reviews yet.</p>
            <p class="text-gray-400 text-xs mt-1">Be the first to share your experience!</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ── RELATED PRODUCTS ── -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
      <div class="border-t border-gray-100 pt-10">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-1 h-5 bg-red-500 rounded-full inline-block"></span>
          <h3 class="font-bold text-lg font-display uppercase tracking-wide">You May Also Like</h3>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
          <% relatedProducts.forEach(rp => { %>
            <%
              const rpFirst = rp.variants?.[0] || null
              const rpPrice = rpFirst ? (rpFirst.offerActive ? rpFirst.offerPrice : rpFirst.productPrice) : 0
              const rpBase  = rpFirst?.productPrice || 0
              const rpHasDiscount = rpFirst?.offerActive && rpFirst?.discountPercentage > 0
              const rpInStock = rp.variants?.some(v => v.status === 'onStock' && v.stock > 0)
            %>
            <a href="/product/<%= rp._id %>" class="group block">
              <div class="bg-gray-50 rounded-2xl overflow-hidden aspect-square flex items-center justify-center relative mb-3">
                <img src="<%= rp.productImage?.[0] || '/images/default.png' %>"
                  alt="<%= rp.productname %>"
                  class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-300"/>
                <% if (rpHasDiscount) { %>
                  <span class="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">
                    -<%= rpFirst.discountPercentage %>%
                  </span>
                <% } %>
                <% if (!rpInStock) { %>
                  <span class="absolute bottom-2 left-2 right-2 text-center bg-gray-800 text-white text-xs font-semibold py-1 rounded-lg">
                    Out of Stock
                  </span>
                <% } %>
              </div>
              <p class="text-xs text-gray-400 font-semibold uppercase tracking-wide"><%= rp.brand %></p>
              <p class="font-bold text-sm text-gray-800 leading-snug line-clamp-2"><%= rp.productname %></p>
              <div class="flex items-baseline gap-2 mt-1">
                <span class="text-sm font-bold">₹<%= rpPrice.toLocaleString('en-IN') %></span>
                <% if (rpHasDiscount) { %>
                  <span class="text-xs text-gray-400 line-through">₹<%= rpBase.toLocaleString('en-IN') %></span>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </main>

  <%- include('../partials/user/footer.ejs') %>

  <script>
    const SIZE_MAP   = <%- JSON.stringify(sizeVariantMap) %>
    const PRODUCT_ID = '<%= product._id %>'
   const IS_LOGGED_IN = <%= isLoggedIn %>

    let qty          = 1
    let selectedSize = null
    let selectedVariantId = null
    let maxStock     = 0

    // ── Image handling ──────────────────────────────────────────
    function setMainImage(src, btn) {
      document.getElementById('mainImage').src = src
      document.querySelectorAll('.thumb-btn').forEach(t => {
        t.classList.remove('active')
        t.style.borderColor = ''
      })
      btn.classList.add('active')
      document.getElementById('mainImageWrap').classList.remove('zoomed')
    }

    function toggleZoom(e) {
      const wrap = document.getElementById('mainImageWrap')
      wrap.classList.toggle('zoomed')
    }

    function moveZoom(e) {
      const wrap = document.getElementById('mainImageWrap')
      if (!wrap.classList.contains('zoomed')) return
      const rect = wrap.getBoundingClientRect()
      const xPct = ((e.clientX - rect.left) / rect.width)  * 100
      const yPct = ((e.clientY - rect.top)  / rect.height) * 100
      document.getElementById('mainImage').style.transformOrigin = `${xPct}% ${yPct}%`
    }

    // ── Size selection ───────────────────────────────────────────────────
    function selectSize(size, btn, sellingPrice, basePrice, discountPct, available, stock, variantId) {
      if (!available) return
      selectedSize      = size
      selectedVariantId = variantId
      maxStock          = Math.min(stock, 5)
      document.getElementById('selectedSize').value      = size
      document.getElementById('selectedVariantId').value = variantId
      document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('selected'))
      btn.classList.add('selected')
      document.getElementById('displayPrice').textContent = '₹' + sellingPrice.toLocaleString('en-IN')
      if (discountPct > 0) {
        document.getElementById('basePrice').textContent = '₹' + basePrice.toLocaleString('en-IN')
        document.getElementById('basePrice').classList.remove('hidden')
        document.getElementById('discountBadge').textContent = `-${discountPct}% OFF`
        document.getElementById('discountBadge').classList.remove('hidden')
      } else {
        document.getElementById('basePrice').classList.add('hidden')
        document.getElementById('discountBadge').classList.add('hidden')
      }
      const hint = document.getElementById('stockHint')
      if (hint) {
        if (stock > 0 && stock <= 5) { hint.textContent = `Only ${stock} left!`; hint.classList.remove('hidden') }
        else { hint.classList.add('hidden') }
      }
      qty = 1
      const qtyEl = document.getElementById('qtyDisplay')
      if (qtyEl) qtyEl.textContent = 1
      document.getElementById('sizeError')?.classList.add('hidden')
    }

    // ── Quantity ─────────────────────────────────────────────────────────
    function changeQty(delta) {
      if (!selectedSize) { showToast('Please select a size first', 'red'); return }
      const newQty = qty + delta
      if (newQty < 1) return
      if (newQty > maxStock) { showToast(`Only ${maxStock} unit(s) available for this size`, 'red'); return }
      qty = newQty
      document.getElementById('qtyDisplay').textContent = qty
    }

    // ── Add to Cart ───────────────────────────────────────────────────────
    async function addToCart() {
      if (!selectedSize) {
        document.getElementById('sizeError')?.classList.remove('hidden')
        document.querySelector('.size-btn')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
        return
      }
      try {
        const res  = await fetch('/cart/add', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId: PRODUCT_ID, variantId: selectedVariantId, size: selectedSize, quantity: qty })
        })
        const data = await res.json()
        if (res.status === 401) { window.location.href = '/login'; return }
        if (data.success) showToast('Added to cart ✓', 'green')
        else showToast(data.message || 'Could not add to cart', 'red')
      } catch { showToast('Something went wrong', 'red') }
    }

    // ── Buy Now ───────────────────────────────────────────────────────────
    async function buyNow() {
      if (!selectedSize) { document.getElementById('sizeError')?.classList.remove('hidden'); return }
      try {
        const res  = await fetch('/cart/add', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId: PRODUCT_ID, variantId: selectedVariantId, size: selectedSize, quantity: qty })
        })
        const data = await res.json()
        if (res.status === 401) { window.location.href = '/login'; return }
        if (data.success) window.location.href = '/cart'
        else showToast(data.message || 'Error', 'red')
      } catch { showToast('Something went wrong', 'red') }
    }

    // ── Wishlist toggle ───────────────────────────────────────────────────
    async function toggleWishlist(productId) {
      const btn = document.getElementById('wishlistBtn')
      const isWishlisted = btn.classList.contains('wishlisted')
      const action = isWishlisted ? 'remove' : 'add'
      try {
        const res  = await fetch('/wishlist/toggle', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, action })
        })
        if (res.status === 401) { window.location.href = '/login'; return }
        const data = await res.json()
        if (data.success) {
          const svg = btn.querySelector('svg')
          if (action === 'add') {
            btn.classList.add('wishlisted'); btn.title = 'Remove from Wishlist'
            svg.setAttribute('fill', '#e11d48'); svg.setAttribute('stroke', '#e11d48')
            const span = btn.querySelector('span'); if (span) span.textContent = 'Saved to Wishlist'
            showToast('Saved to wishlist ♡', 'green')
          } else {
            btn.classList.remove('wishlisted'); btn.title = 'Add to Wishlist'
            svg.setAttribute('fill', 'none'); svg.setAttribute('stroke', 'currentColor')
            const span = btn.querySelector('span'); if (span) span.textContent = 'Save to Wishlist'
            showToast('Removed from wishlist')
          }
        } else { showToast(data.message || 'Error updating wishlist', 'red') }
      } catch { showToast('Something went wrong', 'red') }
    }

    // ── Accordion ─────────────────────────────────────────────────────────
    function toggleAccordion(btn) {
      const body = btn.nextElementSibling
      const isOpen = body.classList.contains('open')
      body.classList.toggle('open', !isOpen)
      btn.classList.toggle('open', !isOpen)
      btn.querySelector('.accordion-icon').textContent = isOpen ? '+' : '−'
    }

    // ── Toast ──────────────────────────────────────────────────────────────
    let _toastTimer
    function showToast(msg, type = 'dark') {
      const t = document.getElementById('toast')
      document.getElementById('toastMsg').textContent = msg
      t.className = 'show' + (type === 'green' ? ' green' : type === 'red' ? ' red' : '')
      clearTimeout(_toastTimer)
      _toastTimer = setTimeout(() => { t.className = '' }, 3000)
    }

    // ── Auto-select first available size on load ──────────────────────────
    window.addEventListener('DOMContentLoaded', () => {
      const first = SIZE_MAP.find(s => s.available)
      if (first) {
        const btn = [...document.querySelectorAll('.size-btn')].find(b => b.dataset.size === first.size)
        if (btn) btn.click()
      }
    })

    // ══════════════════════════════════════════
    // REVIEW MODAL LOGIC
    // ══════════════════════════════════════════

    let reviewRating = 0
    const ratingLabels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent']

    // Star picker interactions
    document.querySelectorAll('.review-star').forEach(star => {
      star.addEventListener('mouseover', () => highlightStars(+star.dataset.val))
      star.addEventListener('mouseout',  () => highlightStars(reviewRating))
      star.addEventListener('click', () => {
        reviewRating = +star.dataset.val
        highlightStars(reviewRating)
        document.getElementById('ratingLabel').textContent = ratingLabels[reviewRating]
      })
    })

    function highlightStars(n) {
      document.querySelectorAll('.review-star').forEach(s => {
        s.classList.toggle('lit', +s.dataset.val <= n)
      })
    }

    // Char counter
    document.getElementById('reviewComment').addEventListener('input', function() {
      document.getElementById('bodyCount').textContent = this.value.length
    })

    // Image preview thumbnails
    function previewReviewImgs(input) {
      const preview = document.getElementById('reviewImgPreviews')
      preview.innerHTML = ''
      const files = Array.from(input.files).slice(0, 4)
      files.forEach(file => {
        const reader = new FileReader()
        reader.onload = e => {
          const img = document.createElement('img')
          img.src = e.target.result
          img.className = 'w-14 h-14 object-cover rounded-xl border border-gray-200'
          preview.appendChild(img)
        }
        reader.readAsDataURL(file)
      })
    }

    // Open modal — check login, then check duplicate
    async function openReviewModal() {
      if (!IS_LOGGED_IN) {
        window.location.href = '/login'
        return
      }
      try {
        const res  = await fetch(`/product/${PRODUCT_ID}/review/check`)
        const data = await res.json()

        if (data.alreadyReviewed) {
          showToast('You have already reviewed this product', 'red')
          return
        }

        // Reset modal state
        reviewRating = 0
        highlightStars(0)
        document.getElementById('ratingLabel').textContent = 'Tap to rate'
        document.getElementById('reviewTitle').value = ''
        document.getElementById('reviewComment').value = ''
        document.getElementById('bodyCount').textContent = '0'
        document.getElementById('reviewImgPreviews').innerHTML = ''
        document.getElementById('reviewImgsInput').value = ''
        document.getElementById('reviewError').classList.add('hidden')
        document.getElementById('reviewForm').classList.remove('hidden')
        document.getElementById('reviewSuccess').classList.add('hidden')
        const btn = document.getElementById('submitReviewBtn')
        btn.textContent = 'Submit Review'
        btn.disabled = false

        document.getElementById('reviewModalOverlay').classList.add('open')
        document.body.style.overflow = 'hidden'
      } catch {
        showToast('Something went wrong', 'red')
      }
    }

    function closeReviewModal() {
      document.getElementById('reviewModalOverlay').classList.remove('open')
      document.body.style.overflow = ''
    }

    function handleOverlayClick(e) {
      if (e.target === document.getElementById('reviewModalOverlay')) closeReviewModal()
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeReviewModal()
    })

    // Submit review using FormData (supports image uploads)
    async function submitReview() {
      const title         = document.getElementById('reviewTitle').value.trim()
      const reviewComment = document.getElementById('reviewComment').value.trim()
      const errEl         = document.getElementById('reviewError')
      const imgInput      = document.getElementById('reviewImgsInput')

      if (!reviewRating) {
        errEl.textContent = 'Please select a star rating.'
        errEl.classList.remove('hidden'); return
      }
      if (reviewComment.length < 10) {
        errEl.textContent = 'Please write at least 10 characters in your review.'
        errEl.classList.remove('hidden'); return
      }
      errEl.classList.add('hidden')

      const btn = document.getElementById('submitReviewBtn')
      btn.textContent = 'Submitting…'
      btn.disabled = true

      // Build FormData so images are included
      const fd = new FormData()
      fd.append('rating', reviewRating)
      fd.append('title', title)
      fd.append('reviewComment', reviewComment)
      Array.from(imgInput.files).slice(0, 4).forEach(f => fd.append('reviewImgs', f))

      try {
        const res  = await fetch(`/product/${PRODUCT_ID}/review`, {
          method: 'POST',
          body: fd   // no Content-Type header — browser sets multipart boundary
        })
        const data = await res.json()

        if (res.status === 401) { window.location.href = '/login'; return }

        if (data.success) {
          document.getElementById('reviewForm').classList.add('hidden')
          document.getElementById('reviewSuccess').classList.remove('hidden')
          injectNewReview(data.review)
        } else {
          errEl.textContent = data.message || 'Could not submit review. Please try again.'
          errEl.classList.remove('hidden')
          btn.textContent = 'Submit Review'
          btn.disabled = false
        }
      } catch {
        errEl.textContent = 'Something went wrong. Please try again.'
        errEl.classList.remove('hidden')
        btn.textContent = 'Submit Review'
        btn.disabled = false
      }
    }

    // Inject new review card at top of list (no page reload)
    function injectNewReview(review) {
      const list  = document.getElementById('reviewsList')
      const noMsg = document.getElementById('noReviewsMsg')
      if (noMsg) noMsg.remove()

      let wrapper = list.querySelector('div.space-y-4')
      if (!wrapper) {
        wrapper = document.createElement('div')
        wrapper.className = 'space-y-4'
        list.appendChild(wrapper)
      }

      const stars = [1,2,3,4,5].map(i =>
        `<svg class="w-3.5 h-3.5 ${i <= review.rating ? 'text-yellow-400' : 'text-gray-200'}" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>`
      ).join('')

      const date    = new Date(review.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'})
      const initial = (review.userName || 'U')[0].toUpperCase()

      const imgHtml = review.reviewImgs && review.reviewImgs.length
        ? `<div class="flex flex-wrap gap-2 mt-3">
            ${review.reviewImgs.map(src =>
              `<img src="${src}" class="w-14 h-14 object-cover rounded-xl border border-gray-100 cursor-pointer hover:opacity-80 transition-opacity" onclick="openImgLightbox('${src}')"/>`
            ).join('')}
          </div>`
        : ''

      const card = document.createElement('div')
      card.className = 'border border-gray-100 rounded-2xl p-5'
      card.innerHTML = `
        <div class="flex items-start gap-3 mb-3">
          <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
            ${review.userAvatar
              ? `<img src="${review.userAvatar}" class="w-full h-full object-cover rounded-full"/>`
              : `<span class="font-bold text-sm text-gray-500">${initial}</span>`}
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between flex-wrap gap-1">
              <p class="font-bold text-sm">${review.userName || 'You'}</p>
              <span class="text-xs text-gray-400">${date}</span>
            </div>
            <div class="flex items-center gap-0.5 mt-1">${stars}</div>
          </div>
        </div>
        ${review.title ? `<p class="font-semibold text-sm mb-1">${review.title}</p>` : ''}
        <p class="text-sm text-gray-600 leading-relaxed">${review.reviewComment}</p>
        ${imgHtml}
      `
      wrapper.prepend(card)
    }

    // Simple lightbox for review images
    function openImgLightbox(src) {
      const lb = document.createElement('div')
      lb.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:99999;display:flex;align-items:center;justify-content:center;cursor:zoom-out;'
      lb.innerHTML = `<img src="${src}" style="max-width:90vw;max-height:90vh;border-radius:12px;object-fit:contain;"/>`
      lb.addEventListener('click', () => lb.remove())
      document.body.appendChild(lb)
    }
  </script>
</body>
</html>
