<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up – 2ES Store</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />



  <style>
    * { font-family: 'Raleway', sans-serif; box-sizing: border-box; }

    html, body {
      height: 100%;
      overflow: hidden;
    }

    .bg-stadium {
      background-image: url('/img/signup.background.jpg');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
      height: 100vh;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .bg-stadium::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      z-index: 0;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.22);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: 18px;
    }

    .field-input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1.5px solid rgba(255, 255, 255, 0.55);
      padding: 6px 2px;
      font-size: 0.875rem;
      color: #ffffff;
      outline: none;
      font-family: 'Raleway', sans-serif;
      font-weight: 500;
      transition: border-color 0.2s;
      letter-spacing: 0.01em;
    }
    .field-input::placeholder {
      color: rgba(255, 255, 255, 0.6);
      font-weight: 400;
      font-size: 0.875rem;
    }
    .field-input:focus {
      border-bottom-color: #ffffff;
    }

    .password-wrapper {
      position: relative;
      width: 100%;
    }
    .password-wrapper .field-input {
      padding-right: 28px;
    }
    .eye-btn {
      position: absolute;
      right: 2px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      color: rgba(255,255,255,0.6);
      transition: color 0.2s;
    }
    .eye-btn:hover { color: #ffffff; }

    .btn-continue {
      width: 100%;
      background: #111111;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: background 0.2s;
      font-family: 'Raleway', sans-serif;
    }
    .btn-continue:hover { background: #2a2a2a; }
    .btn-continue:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .btn-outline {
      width: 100%;
      background: rgba(255,255,255,0.15);
      color: #ffffff;
      border: 1px solid rgba(255,255,255,0.35);
      border-radius: 8px;
      padding: 13px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      font-family: 'Raleway', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      letter-spacing: 0.02em;
      text-decoration: none;
    }
    .btn-outline:hover { background: rgba(255,255,255,0.25); }

    input[type="checkbox"] {
      accent-color: #2563eb;
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      cursor: pointer;
    }

    .or-text {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255,255,255,0.75);
      font-weight: 600;
      letter-spacing: 0.06em;
      margin: 4px 0;
    }

    .signup-heading {
      font-family: 'Raleway', sans-serif;
      font-weight: 700;
      font-size: 1.5rem;
      color: #ffffff;
      letter-spacing: 0.06em;
      text-align: center;
    }

    .logo-shield {
      width: 160px;
      height: auto;
      opacity: 0.92;
    }

    /* Error messages */
    .error-message {
      font-size: 0.75rem;
      margin-top: 3px;
      color: #fca5a5;
      font-weight: 500;
      min-height: 1rem;
    }
    .error-message.hidden {
      visibility: hidden;
    }

    .sub-label {
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255,255,255,0.75);
      margin-bottom: 1rem;
      letter-spacing: 0.01em;
    }

    .terms-label {
      font-size: 0.75rem;
      color: rgba(255,255,255,0.75);
      font-weight: 500;
      line-height: 1.5;
    }
    .terms-label a {
      color: #ffffff;
      font-weight: 600;
      text-decoration: underline;
    }
    .terms-label a:hover { color: rgba(255,255,255,0.85); }

  <%- include('../partials/sweetalert.ejs') %>
  </style>
</head>
<body class="bg-black">

  <div class="bg-stadium">

    <div class="relative z-10 w-full flex justify-center px-6">
      <div class="glass-card w-full max-w-3xl px-10 py-10 flex gap-10 items-center">

        <!-- LEFT: Logo -->
        <div class="hidden md:flex flex-col items-center justify-center flex-shrink-0" style="min-width:180px;">
          <img src="/img/pes.logo.png" alt="2ES Logo" class="logo-shield" style="width:170px;" />
        </div>

        <!-- RIGHT: Form -->
        <div class="flex-1">

          <h1 class="signup-heading mb-5">Sign-Up</h1>
          <p class="sub-label">Enter your details below</p>


          <!-- No action/method — handled entirely by fetch -->
          <form id="signupForm" class="flex flex-col gap-4" novalidate>

            <!-- First Name + Last Name -->
            <div class="grid grid-cols-2 gap-5">
              <div id="wrap-firstName">
                <input class="field-input" type="text" name="firstName" id="firstName" placeholder="First Name" autocomplete="given-name" />
                <p class="error-message hidden" id="err-firstName"></p>
              </div>
              <div id="wrap-lastName">
                <input class="field-input" type="text" name="lastName" id="lastName" placeholder="Last Name" autocomplete="family-name" />
                <p class="error-message hidden" id="err-lastName"></p>
              </div>
            </div>

            <!-- Phone -->
            <div id="wrap-phone">
              <input class="field-input" type="tel" name="phone" id="phone" placeholder="Phone" autocomplete="tel" />
              <p class="error-message hidden" id="err-phone"></p>
            </div>

            <!-- Email -->
            <div id="wrap-email">
              <input class="field-input" type="email" name="email" id="email" placeholder="Email" autocomplete="email" />
              <p class="error-message hidden" id="err-email"></p>
            </div>

            <!-- Password -->
            <div id="wrap-password">
              <div class="password-wrapper">
                <input class="field-input" type="password" id="password" name="password" placeholder="Password" autocomplete="new-password" />
                <button type="button" class="eye-btn" onclick="togglePassword('password', this)" aria-label="Toggle password visibility">
                  <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
              <p class="error-message hidden" id="err-password"></p>
            </div>

            <!-- Confirm Password -->
            <div id="wrap-confirmPassword">
              <div class="password-wrapper">
                <input class="field-input" type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" autocomplete="new-password" />
                <button type="button" class="eye-btn" onclick="togglePassword('confirmPassword', this)" aria-label="Toggle confirm password visibility">
                  <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
              </div>
              <p class="error-message hidden" id="err-confirmPassword"></p>
            </div>

            <!-- Referral Code -->
            <div>
              <input class="field-input" type="text" name="referralCode" placeholder="Referral Code (Optional)" />
            </div>

            <div class="mt-2"></div>

            <!-- Terms checkbox -->
            <div class="flex items-start gap-3">
              <input type="checkbox" id="terms" name="terms" checked />
              <label for="terms" class="terms-label">
                By creating an account, I agree to our
                <a href="/terms">Terms of use</a>
                and
                <a href="/privacy">Privacy Policy</a>
              </label>
            </div>

            <!-- Continue button -->
            <button type="submit" id="submitBtn" class="btn-continue mt-1">Continue</button>

            <div class="or-text">OR</div>

            <!-- Sign up with Gmail -->
            <a href="/auth/google" class="btn-outline">
              <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
              Sign up with G-Mail
            </a>

            <!-- Already have account -->
            <a href="/login" class="btn-outline">
              Already have an account? &nbsp;Login
            </a>

          </form>
        </div>

      </div>
    </div>

  </div>

  <script>

    /* ── Eye icon toggle ── */
    function togglePassword(fieldId, btn) {
      const input = document.getElementById(fieldId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.innerHTML = isPassword
        ? `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
           </svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
           </svg>`;
    }

    /* ── Show / Clear error using IDs (reliable, no DOM traversal issues) ── */
    function showError(fieldId, message) {
      const input = document.getElementById(fieldId);
      const error = document.getElementById('err-' + fieldId);
      if (input) input.style.borderBottomColor = '#f87171';
      if (error) {
        error.textContent = message;
        error.classList.remove('hidden');
      }
    }

    function clearError(fieldId) {
      const input = document.getElementById(fieldId);
      const error = document.getElementById('err-' + fieldId);
      if (input) input.style.borderBottomColor = 'rgba(255,255,255,0.55)';
      if (error) {
        error.textContent = '';
        error.classList.add('hidden');
      }
    }

    function showGeneralError(message) {
      Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: message,
        confirmButtonColor: '#ef4444'
      });
    }

    function hideGeneralError() {
      // No longer needed with SweetAlerts
    }

    /* ── Clear errors on input ── */
    ['firstName', 'lastName', 'phone', 'email', 'password', 'confirmPassword'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', () => clearError(id));
    });

    /* ── Submit handler ── */
    document.getElementById('signupForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      hideGeneralError();

      const firstName       = document.getElementById('firstName').value.trim();
      const lastName        = document.getElementById('lastName').value.trim();
      const phone           = document.getElementById('phone').value.trim();
      const email           = document.getElementById('email').value.trim();
      const password        = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const terms           = document.getElementById('terms');

      let valid = true;

      // First Name — must contain at least 3 alphabetic characters
if (firstName === '') {
  showError('firstName', 'First name is required'); valid = false;
} else if ((firstName.match(/[a-zA-Z]/g) || []).length < 3) {
  showError('firstName', 'First name must contain at least 3 letters'); valid = false;
} else { clearError('firstName'); }

// Last Name — must contain at least 2 alphabetic characters
if (lastName === '') {
  showError('lastName', 'Last name is required'); valid = false;
} else if ((lastName.match(/[a-zA-Z]/g) || []).length < 2) {
  showError('lastName', 'Last name must contain at least 2 letters'); valid = false;
} else { clearError('lastName'); }

      // Phone
      if (phone === '') {
        showError('phone', 'Phone number is required'); valid = false;
      } else if (!/^[0-9]{10}$/.test(phone)) {
        showError('phone', 'Enter a valid 10-digit phone number'); valid = false;
      } else { clearError('phone'); }

      // Email
      if (email === '') {
        showError('email', 'Email is required'); valid = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('email', 'Enter a valid email address'); valid = false;
      } else { clearError('email'); }

      // Password
      if (password === '') {
        showError('password', 'Password is required'); valid = false;
      } else if (!/^(?=.*[A-Za-z])(?=.*\d).{6,}$/.test(password)) {
        showError('password', 'Password must be 6+ characters with at least one letter and one number'); valid = false;
      } else { clearError('password'); }

      // Confirm Password
      if (confirmPassword === '') {
        showError('confirmPassword', 'Please confirm your password'); valid = false;
      } else if (password !== confirmPassword) {
        showError('confirmPassword', 'Passwords do not match'); valid = false;
      } else { clearError('confirmPassword'); }

      // Terms
      if (!terms.checked) {
        showGeneralError('You must accept the Terms & Conditions to continue.');
        valid = false;
      }

      if (!valid) return;

      // ── Fetch to backend ──
      const submitBtn = document.getElementById('submitBtn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Please wait...';

      try {
        const response = await fetch('/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ firstName, lastName, phone, email, password, confirmPassword })
        });

        const data = await response.json();

        if (data.success) {
          window.location.href = data.redirectUrl;
        } else {
          // Show error on the specific field if field is provided
          const validFields = ['firstName', 'lastName', 'phone', 'email', 'password', 'confirmPassword'];
          if (data.field && validFields.includes(data.field)) {
            showError(data.field, data.message);
          } else {
            showGeneralError(data.message || 'Something went wrong. Please try again.');
          }
        }

      } catch (err) {
        console.error('Signup fetch error:', err);
        // showGeneralError('Network error. Please check your connection and try again.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Continue';
      }
    });

  </script>
</body>
</html>
