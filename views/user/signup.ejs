<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up – 2ES Store</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            body: ['Raleway', 'sans-serif'],
            display: ['Playfair Display', 'serif'],
          }
        }
      }
    }
  </script>

  <style>
    * { font-family: 'Raleway', sans-serif; box-sizing: border-box; }

    /* ── Full-page background image ── */
    .bg-stadium {
      /* Replace this URL with your actual background image path, e.g. /images/stadium.jpg */
      background-image: url('YOUR_BACKGROUND_IMAGE_PATH_HERE');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
      min-height: 100vh;
      position: relative;
    }

    /* Dark overlay on the background */
    .bg-stadium::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      z-index: 0;
    }

    /* ── Frosted glass card ── */
    .glass-card {
      background: rgba(180, 180, 180, 0.28);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 18px;
    }

    /* ── Underline-only inputs ── */
    .field-input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(60, 60, 60, 0.55);
      padding: 6px 2px;
      font-size: 0.82rem;
      color: #1a1a1a;
      outline: none;
      font-family: 'Raleway', sans-serif;
      font-weight: 500;
      transition: border-color 0.2s;
      letter-spacing: 0.01em;
    }
    .field-input::placeholder {
      color: #4a4a4a;
      font-weight: 500;
      font-size: 0.82rem;
    }
    .field-input:focus {
      border-bottom-color: #111;
    }

    /* ── Continue button ── */
    .btn-continue {
      width: 100%;
      background: #111111;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: background 0.2s;
      font-family: 'Raleway', sans-serif;
    }
    .btn-continue:hover { background: #2a2a2a; }

    /* ── Gmail / Login outline buttons ── */
    .btn-outline {
      width: 100%;
      background: rgba(255,255,255,0.18);
      color: #1a1a1a;
      border: 1px solid rgba(80,80,80,0.3);
      border-radius: 8px;
      padding: 13px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      font-family: 'Raleway', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      letter-spacing: 0.02em;
    }
    .btn-outline:hover { background: rgba(255,255,255,0.28); }

    /* ── Navbar buttons ── */
    .nav-login {
      border: 1.5px solid rgba(255,255,255,0.7);
      color: #fff;
      border-radius: 6px;
      padding: 6px 22px;
      font-size: 0.82rem;
      font-weight: 600;
      background: transparent;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
      letter-spacing: 0.04em;
    }
    .nav-login:hover { background: rgba(255,255,255,0.1); }

    .nav-signup {
      border: 1.5px solid rgba(255,255,255,0.7);
      color: #fff;
      border-radius: 6px;
      padding: 6px 22px;
      font-size: 0.82rem;
      font-weight: 700;
      background: rgba(255,255,255,0.12);
      cursor: pointer;
      text-decoration: none;
      letter-spacing: 0.04em;
      transition: background 0.2s;
    }
    .nav-signup:hover { background: rgba(255,255,255,0.22); }

    /* Checkbox accent */
    input[type="checkbox"] {
      accent-color: #2563eb;
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      cursor: pointer;
    }

    /* OR divider */
    .or-text {
      text-align: center;
      font-size: 0.82rem;
      color: #2a2a2a;
      font-weight: 600;
      letter-spacing: 0.06em;
      margin: 4px 0;
    }

    /* Sign-Up heading */
    .signup-heading {
      font-family: 'Raleway', sans-serif;
      font-weight: 700;
      font-size: 1.5rem;
      color: #1a1a1a;
      letter-spacing: 0.06em;
      text-align: center;
    }

    /* Nav links */
    .nav-link {
      font-size: 0.82rem;
      font-weight: 700;
      color: rgba(255,255,255,0.9);
      letter-spacing: 0.08em;
      text-decoration: none;
      padding-bottom: 2px;
      transition: color 0.2s;
    }
    .nav-link:hover { color: #fff; }
    .nav-link.active {
      color: #fff;
      border-bottom: 2px solid #fff;
    }

    /* Logo on left side of card */
    .logo-shield {
      width: 160px;
      height: auto;
      opacity: 0.92;
      /* The logo is black on transparent — we invert it slightly for the dark card */
      filter: brightness(0) invert(0.15);
    }
  </style>
</head>
<body class="bg-black">

  <!-- ══════════════════════════════════
       FULL PAGE BACKGROUND WRAPPER
  ══════════════════════════════════ -->
  <div class="bg-stadium">

   

    <!-- ══════════════════════════════════
         MAIN GLASS CARD
    ══════════════════════════════════ -->
    <div class="relative z-10 flex justify-center px-6 py-8 pb-16">
      <div class="glass-card w-full max-w-3xl px-10 py-10 flex gap-10 items-center">

        <!-- ── LEFT: Logo ── -->
        <div class="hidden md:flex flex-col items-center justify-center flex-shrink-0" style="min-width:180px;">
          <img
            src="/images/pes_logo.png"
            alt="2ES Logo"
            class="logo-shield"
            style="width:170px;"
          />
        </div>

        <!-- ── RIGHT: Form ── -->
        <div class="flex-1">

          <!-- Heading -->
          <h1 class="signup-heading mb-5">Sign-Up</h1>

          <!-- Sub-label -->
          <p class="text-sm font-semibold text-gray-700 mb-4" style="letter-spacing:0.01em;">
            Enter your details below
          </p>
           <!-- ERROR MESSAGE -->
<% if (typeof message !== 'undefined' && message) { %>
<div class="mb-4 p-3 rounded-lg bg-red-500/20 border border-red-400 text-red-200 text-center">
    <%= message %>
</div>
<% } %>
          <form action="/signup" method="POST" class="flex flex-col gap-4">

            <!-- First Name + Last Name -->
            <div class="grid grid-cols-2 gap-5">
              <div>
                <input class="field-input" type="text" name="firstName" placeholder="First Name" required />
                <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
              </div>
              <div>
                <input class="field-input" type="text" name="lastName" placeholder="Last Name" required />
                <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
              </div>
            </div>

            <!-- Phone -->
            <div>
              <input class="field-input" type="tel" name="phone" placeholder="Phone" />
              <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Email -->
            <div>
              <input class="field-input" type="email" name="email" placeholder="Email" required />
              <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Password -->
            <div>
              <input class="field-input" type="password" name="password" placeholder="Password" required />
              <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Confirm Password -->
            <div>
              <input class="field-input" type="password" name="confirmPassword" placeholder="Confirm Password" required />
              <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Referral Code -->
            <div>
              <input class="field-input" type="text" name="referralCode" placeholder="Refferal code(Optional)" />
              <p class="error-message text-red-500 text-xs mt-1 hidden"></p>
            </div>

            <!-- Spacer -->
            <div class="mt-2"></div>

            <!-- Terms checkbox -->
            <div class="flex items-start gap-3">
              <input type="checkbox" id="terms" name="terms" checked />
              <label for="terms" class="text-xs text-gray-700 leading-relaxed" style="font-weight:500;">
                By creating an account, I agree to our
                <a href="/terms" class="underline font-semibold text-gray-800 hover:text-black">Terms of use</a>
                and
                <a href="/privacy" class="underline font-semibold text-gray-800 hover:text-black">Privacy Policy</a>
              </label>
            </div>

            <!-- Continue button -->
            <button type="submit" class="btn-continue mt-1">
              Continue
            </button>

            <!-- OR -->
            <div class="or-text">OR</div>

            <!-- Sign up with Gmail -->
            <a href="/auth/google" class="btn-outline">
              <!-- Google G icon -->
              <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
              Sign up with G-Mail
            </a>

            <!-- Already have account -->
            <a href="/login" class="btn-outline">
              Already have account ?&nbsp; Login
            </a>

          </form>
        </div>
        <!-- end form col -->

      </div>
      <!-- end glass card -->
    </div>
    <!-- end main -->

  </div>
  <!-- end bg-stadium -->

</body>
</html>
<script>

/* ===============================
   SIGNUP FORM VALIDATION
   =============================== */

const form = document.querySelector("form");

/* get inputs */

const firstName = document.querySelector('[name="firstName"]');
const lastName = document.querySelector('[name="lastName"]');
const phone = document.querySelector('[name="phone"]');
const email = document.querySelector('[name="email"]');
const password = document.querySelector('[name="password"]');
const confirmPassword = document.querySelector('[name="confirmPassword"]');
const terms = document.querySelector('[name="terms"]');

/* show error function */

function showError(input,message){

  const error = input.parentElement.querySelector(".error-message");

  input.style.borderBottom = "2px solid red";
  error.textContent = message;
  error.classList.remove("hidden");

}

/* clear error */

function clearError(input){

  const error = input.parentElement.querySelector(".error-message");

  input.style.borderBottom = "1px solid rgba(60,60,60,0.55)";
  error.textContent = "";
  error.classList.add("hidden");

}

form.addEventListener("submit",function(e){

  let valid = true;

  /* First Name */

  if(firstName.value.trim().length < 3){

    showError(firstName,"First name must contain at least 3 letters");
    firstName.value="";
    valid=false;

  }else{

    clearError(firstName);

  }

  /* Last Name */

  if(lastName.value.trim().length < 2){

    showError(lastName,"Last name must contain at least 2 letters");
    lastName.value="";
    valid=false;

  }else{

    clearError(lastName);

  }

  /* Phone */

  const phoneRegex=/^[0-9]{10}$/;

  if(!phoneRegex.test(phone.value)){

    showError(phone,"Enter valid 10 digit phone number");
    phone.value="";
    valid=false;

  }else{

    clearError(phone);

  }

  /* Email */

  const emailRegex=/^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  if(!emailRegex.test(email.value)){

    showError(email,"Enter valid email");
    email.value="";
    valid=false;

  }else{

    clearError(email);

  }

  /* Password */

  const passwordRegex=/^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]{6,}$/;

  if(!passwordRegex.test(password.value)){

    showError(password,"Password must be 6+ characters with letters and numbers");
    password.value="";
    valid=false;

  }else{

    clearError(password);

  }

  /* Confirm Password */

  if(password.value !== confirmPassword.value){

    showError(confirmPassword,"Passwords do not match");
    confirmPassword.value="";
    valid=false;

  }else{

    clearError(confirmPassword);

  }

  /* Terms */

  if(!terms.checked){

    alert("You must accept Terms & Conditions");
    valid=false;

  }

  if(!valid){
    e.preventDefault();
  }

});

</script>
