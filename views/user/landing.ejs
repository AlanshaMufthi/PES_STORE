class="border rounded-full px-4 py-1 text-sm"/>

<button class="bg-black text-white px-4 py-1 rounded">
Log in
</button>

<button class="border px-4 py-1 rounded">
Sign up
</button>

</div>

</nav>


<!-- HERO SECTION -->

<section class="px-10 py-10">

<div class="border p-10 flex flex-col md:flex-row items-center justify-between">

