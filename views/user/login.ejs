<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Login</title>

<script src="https://cdn.tailwindcss.com"></script>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
body{
    font-family:'Poppins',sans-serif;
}
</style>

</head>

<body class="h-screen w-full flex flex-col bg-black">

<!-- BACKGROUND IMAGE -->
<div class="absolute inset-0 -z-10">
    <img src="<%= typeof backgroundImage !== 'undefined' ? backgroundImage : '/images/login-bg.jpg' %>" class="w-full h-full object-cover opacity-60">
</div>

<!-- NAVBAR -->
<nav class="flex justify-between items-center px-12 py-6 text-white">

    <div class="text-xl font-semibold tracking-widest">
        <%= typeof siteName !== 'undefined' ? siteName : 'MySite' %>
    </div>

</nav>

<!-- LOGIN CARD -->
<div class="flex flex-grow justify-center items-center">

<div class="w-[1050px] h-[520px] rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 shadow-xl flex overflow-hidden">

<!-- LEFT -->
<div class="w-1/2 flex justify-center items-center">
<img src="<%= typeof logo !== 'undefined' ? logo : '/images/logo.png' %>" class="w-56">
</div>


<!-- RIGHT -->
<div class="w-1/2 flex flex-col justify-center px-16 text-white">

<h2 class="text-3xl font-semibold mb-6 text-center">Login</h2>

<!-- ERROR MESSAGE -->
<% if (typeof message !== 'undefined' && message) { %>
<div class="mb-4 p-3 rounded-lg bg-red-500/20 border border-red-400 text-red-200 text-center">
    <%= message %>
</div>
<% } %>

<form action="/login" method="POST" class="flex flex-col gap-5">

<div>
<label class="text-sm">Email</label>
<input
type="email"
name="email"
required
class="w-full mt-1 px-4 py-3 rounded-lg bg-white/10 border border-white/30 outline-none"
/>
</div>

<div>
<label class="text-sm">Password</label>
<input
type="password"
name="password"
required
class="w-full mt-1 px-4 py-3 rounded-lg bg-white/10 border border-white/30 outline-none"
/>
</div>

<div class="flex justify-between text-sm">
<a href="/forgot-password" class="opacity-80 hover:underline">Forgot Password?</a>
<a href="/signup" class="opacity-80 hover:underline">Sign Up instead</a>
</div>

<button class="mt-3 bg-black text-white py-3 rounded-full text-lg">
Login
</button>

</form>

<div class="flex items-center gap-4 my-5 opacity-70">
<div class="flex-grow h-px bg-white/40"></div>
<span>OR</span>
<div class="flex-grow h-px bg-white/40"></div>
</div>

<a href="/auth/google"
class="flex items-center justify-center gap-3 border border-white/40 py-3 rounded-full hover:bg-white/10">

<img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5">

<span>Continue with Google</span>

</a>

</div>

</div>

</div>

</body>
</html>