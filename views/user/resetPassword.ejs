<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | 2ES</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Nunito', sans-serif;
      min-height: 100vh;
      background: #111;
      position: relative;
      overflow: hidden;
    }

    /* ── Background image ── */
    .bg-image {
      position: fixed;
      inset: 0;
      background: url('/images/stadium-bg.jpg') center center / cover no-repeat;
      filter: grayscale(100%) brightness(0.45);
      z-index: 0;
    }

    /* ── Main card ── */
    .page-wrap {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }

    .card {
      background: rgba(180, 180, 180, 0.18);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 28px;
      width: 100%;
      max-width: 900px;
      min-height: 480px;
      display: flex;
      align-items: center;
      padding: 60px 56px;
      gap: 60px;
      animation: fadeUp 0.6s ease both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Left logo ── */
    .card-logo {
      flex-shrink: 0;
      width: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-logo img {
      width: 180px;
      height: 180px;
      object-fit: contain;
      opacity: 0.85;
    }

    /* ── Right form ── */
    .card-form {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .card-form h1 {
      font-family: 'Cinzel', serif;
      font-size: 2rem;
      font-weight: 700;
      color: #1a1a1a;
      letter-spacing: 0.02em;
      margin-bottom: 4px;
    }

    .card-form p {
      font-size: 0.92rem;
      font-weight: 600;
      color: #333;
      margin-bottom: 4px;
    }

    /* Error / success messages */
    .error-msg {
      color: #e63946;
      font-size: 0.85rem;
      font-weight: 700;
      display: none;
    }

    .success-msg {
      color: #22c55e;
      font-size: 0.85rem;
      font-weight: 700;
      display: none;
    }

    <% if (typeof message !== 'undefined' && message) { %>
    .flash-show { display: block !important; }
    <% } %>

    /* ── Input ── */
    .input-wrap {
      position: relative;
    }

    .input-wrap input {
      width: 100%;
      padding: 16px 20px;
      border-radius: 10px;
      border: 1.5px solid rgba(255,255,255,0.4);
      background: rgba(255,255,255,0.55);
      font-family: 'Nunito', sans-serif;
      font-size: 0.92rem;
      font-weight: 600;
      color: #222;
      outline: none;
      transition: border 0.2s, background 0.2s;
    }

    .input-wrap input::placeholder { color: #888; font-weight: 500; }

    .input-wrap input:focus {
      border-color: rgba(0,0,0,0.4);
      background: rgba(255,255,255,0.75);
    }

    /* ── Eye icon toggle ── */
    .input-wrap .eye-icon {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #666;
      font-size: 1rem;
      user-select: none;
    }

    /* ── Submit button ── */
    .btn-send {
      width: 100%;
      padding: 17px;
      border-radius: 10px;
      border: none;
      background: #111;
      color: #fff;
      font-family: 'Cinzel', serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-top: 4px;
    }

    .btn-send:hover { background: #333; transform: translateY(-1px); }
    .btn-send:active { transform: translateY(0); }

    /* ── Back to login link ── */
    .back-link {
      text-align: center;
      font-size: 0.85rem;
      font-weight: 600;
      color: #333;
      text-decoration: none;
      margin-top: 4px;
      transition: color 0.2s;
    }

    .back-link:hover { color: #111; text-decoration: underline; }
  </style>
</head>
<body>

  <!-- Background -->
  <div class="bg-image"></div>

  <!-- ═══════ MAIN CARD ═══════ -->
  <div class="page-wrap">
    <div class="card">

      <!-- Left: Logo -->
      <div class="card-logo">
        <img src="/img/pes.logo.png" alt="2ES Logo" />
      </div>

      <!-- Right: Form -->
      <div class="card-form">
        <h1>Reset Password</h1>
        <p>Please confirm your password!</p>

        <!-- Flash messages -->
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="error-msg flash-show"><%= message %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="success-msg flash-show"><%= success %></div>
        <% } %>

        <form action="/resetPassword" method="POST">

          <!-- New Password -->
          <div class="input-wrap" style="margin-bottom: 14px;">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="New Password"
              required
            />
            <span class="eye-icon" onclick="toggleVisibility('password', this)">👁</span>
          </div>

          <!-- Confirm Password -->
          <div class="input-wrap" style="margin-bottom: 14px;">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Confirm Password"
              required
            />
            <span class="eye-icon" onclick="toggleVisibility('confirmPassword', this)">👁</span>
          </div>

          <button type="submit" class="btn-send">Change Password</button>
        </form>

        <a href="/login" class="back-link">← Back to Login</a>

      </div>

    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function toggleVisibility(fieldId, icon) {
    const input = document.getElementById(fieldId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = '🙈';
    } else {
      input.type = 'password';
      icon.textContent = '👁';
    }
  }

  document.querySelector('form').addEventListener('submit', function(e) {
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    const hasLetter = /[a-zA-Z]/.test(password);
    const hasNumber = /[0-9]/.test(password);

    if (password.length < 6) {
      e.preventDefault();
      Swal.fire({ icon: 'error', title: 'Weak Password', text: 'Password must be at least 6 characters.', confirmButtonColor: '#111' });
      return;
    }

    if (!hasLetter || !hasNumber) {
      e.preventDefault();
      Swal.fire({ icon: 'error', title: 'Weak Password', text: 'Password must contain both letters and numbers.', confirmButtonColor: '#111' });
      return;
    }

    if (password !== confirmPassword) {
      e.preventDefault();
      Swal.fire({ icon: 'error', title: 'Mismatch', text: 'Passwords do not match.', confirmButtonColor: '#111' });
      return;
    }
  });

  // if success message is showing, redirect to login after 2.5 seconds
<% if (typeof success !== 'undefined' && success) { %>
  setTimeout(() => {
    window.location.href = '/login';
  }, 2500);
<% } %>
</script>

</body>
</html>
