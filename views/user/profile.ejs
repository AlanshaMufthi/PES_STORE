<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile | 2ES</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Raleway:wght@300;400;500;600;700;800&family=Cinzel:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'display': ['Cinzel', 'serif'],
            'heading': ['Playfair Display', 'serif'],
            'body': ['Raleway', 'sans-serif'],
          },
          colors: {
            'brand-red': '#e63946',
            'brand-dark': '#111111',
            'brand-gray': '#f5f5f5',
          }
        }
      }
    }
  </script>

  <style>
    * { font-family: 'Raleway', sans-serif; }

    /* ── Search input ── */
    .search-input {
      background: #f3f3f3; border: 1px solid #ddd; border-radius: 6px;
      padding: 0.35rem 2rem 0.35rem 0.75rem; font-size: 0.8rem; outline: none;
      width: 180px; color: #555;
    }
    .search-wrap { position: relative; }
    .search-wrap svg { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); }

    /* ── Profile Dropdown ── */
    .profile-dropdown {
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      min-width: 160px;
      z-index: 100;
      overflow: hidden;
      display: none;
    }
    .profile-dropdown.open { display: block; }
    .profile-dropdown a {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 16px; font-size: 0.82rem; font-weight: 600;
      color: #111; text-decoration: none; transition: background 0.15s;
    }
    .profile-dropdown a:hover { background: #f5f5f5; }
    .profile-dropdown a.logout { color: #e63946; }
    .profile-dropdown a.logout:hover { background: #fff5f5; }
    .profile-dropdown .divider { height: 1px; background: #eee; margin: 2px 0; }

    /* ── Cart icon wrapper ── */
    .cart-wrap { position: relative; display: flex; align-items: center; }
    .cart-count {
      position: absolute;
      top: -7px; right: -7px;
      background: #e63946; color: #fff;
      font-size: 0.6rem; font-weight: 800;
      width: 16px; height: 16px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }

    /* ── Icon btn ── */
    .icon-btn {
      background: none; border: none; cursor: pointer;
      padding: 4px; border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      color: #111; transition: background 0.15s;
    }
    .icon-btn:hover { background: #f3f3f3; }
    .profile-wrap { position: relative; }

    /* ── Sidebar link ── */
    .sidebar-link { transition: color 0.15s; cursor: pointer; }
    .sidebar-link:hover { color: #e63946; }

    /* ── Read-only field ── */
    .field-box {
      width: 100%;
      padding: 11px 16px;
      border: 1.5px solid #d1d5db;
      border-radius: 8px;
      background: #f9fafb;
      font-size: 0.85rem;
      color: #374151;
      font-family: 'Raleway', sans-serif;
      outline: none;
      transition: border 0.2s, background 0.2s;
    }

    /* ── Footer ── */
    footer { background: #fff; border-top: 1px solid #eee; }
  </style>
</head>
<body class="bg-white text-gray-900">

<%- include('../partials/user/header.ejs', { page: 'profile' }) %>


<!-- ═══════════════ MAIN CONTENT ═══════════════ -->
<main class="max-w-5xl mx-auto px-4 py-10">
  <div class="flex gap-8 items-start">

    <!-- ── SIDEBAR ── -->
    <aside class="w-52 flex-shrink-0">

      <!-- Avatar + Name -->
      <div class="flex flex-col items-center mb-6">
        <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-gray-200 mb-3">
          <img
            src="<%= user.profileImg || '/img/Solidão____.jpg' %>"
            alt="Profile"
            onerror="this.src='/img/Solidão____.jpg'"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-gray-100 border border-gray-300 rounded px-4 py-1 text-sm font-semibold text-gray-700">
          <%= user ? user.firstName + ' ' + user.lastName : 'Customer Name' %>
        </div>
      </div>

      <!-- Sidebar Nav -->
      <div class="text-sm space-y-1">
        <p class="font-bold text-gray-900 mb-2" style="font-family:'Raleway',sans-serif;">Manage My Account</p>
        <div class="pl-3 space-y-1.5">
          <a href="/profile" class="block font-semibold text-red-500 sidebar-link">My Profile</a>
          <a href="/addressBook" class="block text-gray-500 sidebar-link">Address Book</a>
        </div>
        <div class="pt-3 space-y-2.5">
          <a href="/orders" class="block font-bold text-gray-800 sidebar-link">My Orders</a>
          <a href="/privacy" class="block font-bold text-gray-800 sidebar-link">privacy</a>
          <a href="/wallet" class="block font-bold text-gray-800 sidebar-link">Wallet</a>
          <a href="/coupons" class="block font-bold text-gray-800 sidebar-link">Coupons</a>
          <a href="/wishlist" class="block font-bold text-gray-800 sidebar-link">My WishList</a>
          <a href="/logout" class="block font-bold text-red-500 sidebar-link">Logout</a>
        </div>
      </div>
    </aside>


    <!-- ── PROFILE PANEL ── -->
    <div class="flex-1 border border-gray-200 rounded-xl p-8 bg-white shadow-sm">

      <!-- Top row: avatar + title + edit button -->
      <div class="flex items-start justify-between mb-8">
        <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-gray-200">
          <img
            src="<%= user && user.profileImg ? user.profileImg : '/img/Solidão____.jpg' %>"
            alt="Profile"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="text-right">
          <p class="font-semibold text-base text-gray-800 mb-3" style="font-family:'Raleway',sans-serif; font-weight:700;">Personal Information</p>
          <a href="/editProfile">
            <button class="bg-gray-900 text-white text-sm font-semibold px-6 py-2.5 rounded-lg hover:bg-gray-700 transition-colors" style="font-family:'Raleway',sans-serif;">
              Edit profile
            </button>
          </a>
        </div>
      </div>

      <!-- Fields -->
      <div class="space-y-5">

        <!-- Row 1: First + Last name -->
        <div class="grid grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">first name</label>
            <input type="text" class="field-box" value="<%= user ? user.firstName : '' %>" readonly />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">last name</label>
            <input type="text" class="field-box" value="<%= user ? user.lastName : '' %>" readonly />
          </div>
        </div>

        <!-- Row 2: Email -->
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1.5">Email</label>
          <input type="email" class="field-box" value="<%= user ? user.email : '' %>" readonly />
        </div>

        <!-- Row 3: Phone (full-width) -->
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1.5">Phone</label>
          <input type="text" class="field-box" value="<%= user && user.phone ? user.phone : '' %>" placeholder="+91 XXXXX XXXXX" readonly />
        </div>

        <!-- Row 4: Password + Referral -->
        <div class="grid grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">Password</label>
            <input type="password" class="field-box" value="placeholder" readonly />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">Refferal code</label>
            <input type="text" class="field-box" value="<%= user && user.referralCode ? user.referralCode : '' %>" placeholder="—" readonly />
          </div>
        </div>

      </div>
    </div>

  </div>
</main>


<%- include('../partials/user/footer.ejs') %>

</body>
</html>
