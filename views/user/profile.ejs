<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile | 2ES</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Raleway:wght@300;400;500;600;700;800&family=Cinzel:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'display': ['Cinzel', 'serif'],
            'heading': ['Playfair Display', 'serif'],
            'body': ['Raleway', 'sans-serif'],
          },
          colors: {
            'brand-red': '#e63946',
            'brand-dark': '#111111',
            'brand-gray': '#f5f5f5',
          }
        }
      }
    }
  </script>

  <style>
    * { font-family: 'Raleway', sans-serif; }

    /* ── Search input ── */
    .search-input {
      background: #f3f3f3; border: 1px solid #ddd; border-radius: 6px;
      padding: 0.35rem 2rem 0.35rem 0.75rem; font-size: 0.8rem; outline: none;
      width: 180px; color: #555;
    }
    .search-wrap { position: relative; }
    .search-wrap svg { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); }

    /* ── Profile Dropdown ── */
    .profile-dropdown {
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      min-width: 160px;
      z-index: 100;
      overflow: hidden;
      display: none;
    }
    .profile-dropdown.open { display: block; }
    .profile-dropdown a {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 16px; font-size: 0.82rem; font-weight: 600;
      color: #111; text-decoration: none; transition: background 0.15s;
    }
    .profile-dropdown a:hover { background: #f5f5f5; }
    .profile-dropdown a.logout { color: #e63946; }
    .profile-dropdown a.logout:hover { background: #fff5f5; }
    .profile-dropdown .divider { height: 1px; background: #eee; margin: 2px 0; }

    /* ── Cart icon wrapper ── */
    .cart-wrap { position: relative; display: flex; align-items: center; }
    .cart-count {
      position: absolute;
      top: -7px; right: -7px;
      background: #e63946; color: #fff;
      font-size: 0.6rem; font-weight: 800;
      width: 16px; height: 16px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }

    /* ── Icon btn ── */
    .icon-btn {
      background: none; border: none; cursor: pointer;
      padding: 4px; border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      color: #111; transition: background 0.15s;
    }
    .icon-btn:hover { background: #f3f3f3; }
    .profile-wrap { position: relative; }

    /* ── Sidebar link ── */
    .sidebar-link { transition: color 0.15s; cursor: pointer; }
    .sidebar-link:hover { color: #e63946; }

    /* ── Read-only field ── */
    .field-box {
      width: 100%;
      padding: 11px 16px;
      border: 1.5px solid #d1d5db;
      border-radius: 8px;
      background: #f9fafb;
      font-size: 0.85rem;
      color: #374151;
      font-family: 'Raleway', sans-serif;
      outline: none;
      transition: border 0.2s, background 0.2s;
    }

    /* ── Footer ── */
    footer { background: #fff; border-top: 1px solid #eee; }
  </style>
</head>
<body class="bg-white text-gray-900">

<!-- ═══════════════ NAVBAR ═══════════════ -->
<nav class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">

    <!-- Logo -->
    <a href="/img/Solidão____.jpg" class="flex items-center gap-2">
      <svg width="44" height="50" viewBox="0 0 44 50" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M22 2L40 10V26C40 36.5 32 44.5 22 48C12 44.5 4 36.5 4 26V10L22 2Z" fill="white" stroke="black" stroke-width="2.5"/>
        <path d="M10 20L13 15L16 19L22 13L28 19L31 15L34 20H10Z" fill="black"/>
        <text x="22" y="34" text-anchor="middle" font-family="Cinzel,serif" font-size="9" font-weight="700" fill="black">2ES</text>
      </svg>
    </a>

    <!-- Search -->
    <div class="hidden md:flex items-center flex-1 justify-center">
      <div class="search-wrap">
        <input class="search-input" type="text" placeholder="search product..." />
        <svg width="14" height="14" fill="none" stroke="#888" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </div>
    </div>

    <!-- Cart + Profile -->
    <div class="flex items-center gap-3">
      <a href="/cart" class="cart-wrap icon-btn">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Nav Links -->
  <div class="border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 flex gap-8 py-2.5 justify-center">
      <a href="/" class="text-sm font-semibold text-gray-500 hover:text-gray-900 transition" style="font-family:'Raleway',sans-serif;">HOME</a>
      <a href="/shop" class="text-sm font-medium text-gray-500 hover:text-gray-900 transition" style="font-family:'Raleway',sans-serif;">SHOP</a>
      <a href="/about" class="text-sm font-medium text-gray-500 hover:text-gray-900 transition" style="font-family:'Raleway',sans-serif;">ABOUT</a>
      <a href="/contact" class="text-sm font-medium text-gray-500 hover:text-gray-900 transition" style="font-family:'Raleway',sans-serif;">CONTACT</a>
    </div>
  </div>
</nav>


<!-- ═══════════════ MAIN CONTENT ═══════════════ -->
<main class="max-w-5xl mx-auto px-4 py-10">
  <div class="flex gap-8 items-start">

    <!-- ── SIDEBAR ── -->
    <aside class="w-52 flex-shrink-0">

      <!-- Avatar + Name -->
      <div class="flex flex-col items-center mb-6">
        <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-gray-200 mb-3">
          <img
            src="<%= user.profileImg || '/img/Solidão____.jpg' %>"
            alt="Profile"
            onerror="this.src='/img/Solidão____.jpg'"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-gray-100 border border-gray-300 rounded px-4 py-1 text-sm font-semibold text-gray-700">
          <%= user ? user.firstName + ' ' + user.lastName : 'Customer Name' %>
        </div>
      </div>

      <!-- Sidebar Nav -->
      <div class="text-sm space-y-1">
        <p class="font-bold text-gray-900 mb-2" style="font-family:'Raleway',sans-serif;">Manage My Account</p>
        <div class="pl-3 space-y-1.5">
          <a href="/profile" class="block font-semibold text-red-500 sidebar-link">My Profile</a>
          <a href="/addressBook" class="block text-gray-500 sidebar-link">Address Book</a>
        </div>
        <div class="pt-3 space-y-2.5">
          <a href="/orders" class="block font-bold text-gray-800 sidebar-link">My Orders</a>
          <a href="/privacy" class="block font-bold text-gray-800 sidebar-link">privacy</a>
          <a href="/wallet" class="block font-bold text-gray-800 sidebar-link">Wallet</a>
          <a href="/coupons" class="block font-bold text-gray-800 sidebar-link">Coupons</a>
          <a href="/wishlist" class="block font-bold text-gray-800 sidebar-link">My WishList</a>
          <a href="/logout" class="block font-bold text-red-500 sidebar-link">Logout</a>
        </div>
      </div>
    </aside>


    <!-- ── PROFILE PANEL ── -->
    <div class="flex-1 border border-gray-200 rounded-xl p-8 bg-white shadow-sm">

      <!-- Top row: avatar + title + edit button -->
      <div class="flex items-start justify-between mb-8">
        <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-gray-200">
          <img
            src="<%= user && user.profileImg ? user.profileImg : '/img/Solidão____.jpg' %>"
            alt="Profile"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="text-right">
          <p class="font-semibold text-base text-gray-800 mb-3" style="font-family:'Raleway',sans-serif; font-weight:700;">Personal Information</p>
          <a href="/editProfile">
            <button class="bg-gray-900 text-white text-sm font-semibold px-6 py-2.5 rounded-lg hover:bg-gray-700 transition-colors" style="font-family:'Raleway',sans-serif;">
              Edit profile
            </button>
          </a>
        </div>
      </div>

      <!-- Fields -->
      <div class="space-y-5">

        <!-- Row 1: First + Last name -->
        <div class="grid grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">first name</label>
            <input type="text" class="field-box" value="<%= user ? user.firstName : '' %>" readonly />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">last name</label>
            <input type="text" class="field-box" value="<%= user ? user.lastName : '' %>" readonly />
          </div>
        </div>

        <!-- Row 2: Email -->
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1.5">Email</label>
          <input type="email" class="field-box" value="<%= user ? user.email : '' %>" readonly />
        </div>

        <!-- Row 3: Phone (full-width) -->
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1.5">Phone</label>
          <input type="text" class="field-box" value="<%= user && user.phone ? user.phone : '' %>" placeholder="+91 XXXXX XXXXX" readonly />
        </div>

        <!-- Row 4: Password + Referral -->
        <div class="grid grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">Password</label>
            <input type="password" class="field-box" value="placeholder" readonly />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-500 mb-1.5">Refferal code</label>
            <input type="text" class="field-box" value="<%= user && user.referralCode ? user.referralCode : '' %>" placeholder="—" readonly />
          </div>
        </div>

      </div>
    </div>

  </div>
</main>


<!-- ═══════════════ FOOTER ═══════════════ -->
<footer class="py-12 px-6 border-t border-gray-200 bg-white mt-10">
  <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">

    <!-- Exclusive / Newsletter -->
    <div>
      <h4 class="font-bold text-sm text-gray-900 mb-3 tracking-wide">Exclusive</h4>
      <p class="text-sm font-semibold text-gray-700 mb-1">Subscribe</p>
      <p class="text-xs text-gray-500 mb-3">Get 10% off your first order</p>
      <div class="flex items-center border border-gray-300 rounded-md overflow-hidden">
        <input type="email" placeholder="Enter your email" class="flex-1 px-3 py-2 text-xs outline-none bg-white text-gray-600" />
        <button class="bg-gray-900 px-3 py-2 text-white hover:bg-gray-700 transition">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Support -->
    <div>
      <h4 class="font-bold text-sm text-gray-900 mb-3 tracking-wide">Support</h4>
      <p class="text-xs text-gray-600 leading-relaxed">111 Bijoy sarani,<br/>Dhaka, DH 1515,<br/>Bangladesh.</p>
      <p class="text-xs text-gray-600 mt-3">exclusive@gmail.com</p>
      <p class="text-xs text-gray-600 mt-1">+88015-88888-9999</p>
    </div>

    <!-- Account -->
    <div>
      <h4 class="font-bold text-sm text-gray-900 mb-3 tracking-wide">Account</h4>
      <ul class="space-y-2">
        <li><a href="/profile" class="text-xs text-gray-600 hover:text-gray-900 transition">My Account</a></li>
        <li><a href="/login" class="text-xs text-gray-600 hover:text-gray-900 transition">Login / Register</a></li>
        <li><a href="/cart" class="text-xs text-gray-600 hover:text-gray-900 transition">Cart</a></li>
        <li><a href="/wishlist" class="text-xs text-gray-600 hover:text-gray-900 transition">Wishlist</a></li>
        <li><a href="/shop" class="text-xs text-gray-600 hover:text-gray-900 transition">Shop</a></li>
      </ul>
    </div>

    <!-- Quick Link -->
    <div>
      <h4 class="font-bold text-sm text-gray-900 mb-3 tracking-wide">Quick Link</h4>
      <ul class="space-y-2">
        <li><a href="/privacy" class="text-xs text-gray-600 hover:text-gray-900 transition">Privacy Policy</a></li>
        <li><a href="/terms" class="text-xs text-gray-600 hover:text-gray-900 transition">Terms Of Use</a></li>
        <li><a href="/faq" class="text-xs text-gray-600 hover:text-gray-900 transition">FAQ</a></li>
        <li><a href="/contact" class="text-xs text-gray-600 hover:text-gray-900 transition">Contact</a></li>
      </ul>
    </div>

  </div>

  <div class="max-w-5xl mx-auto mt-10 border-t border-gray-200 pt-6 text-center text-xs text-gray-400">
    &copy; <%= new Date().getFullYear() %> 2ES. All rights reserved.
  </div>
</footer>


<!-- ═══════════════ DROPDOWN JS ═══════════════ -->
<script>
  const profileBtn = document.getElementById('profileBtn');
  const profileDropdown = document.getElementById('profileDropdown');
  const profileWrap = document.getElementById('profileWrap');

  if (profileBtn) {
    profileBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      profileDropdown.classList.toggle('open');
    });
    document.addEventListener('click', function(e) {
      if (!profileWrap.contains(e.target)) {
        profileDropdown.classList.remove('open');
      }
    });
  }
</script>

</body>
</html>
