<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Product | 2ES Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <style>
    * { font-family: 'Nunito', sans-serif; box-sizing: border-box; }
    body { background: #f8fafc; margin: 0; color: #334155; }

    /* ── Topbar ── */
    .topbar { background: #fff; height: 72px; display: flex; align-items: center; padding: 0 32px; gap: 20px; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #e2e8f0; }
    .topbar-logo img { width: 52px; height: 52px; object-fit: contain; }
    .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 16px; }
    .icon-circle { width: 40px; height: 40px; border-radius: 12px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; border: 1px solid #e2e8f0; }
    .icon-circle:hover { background: #e2e8f0; transform: translateY(-1px); }
    .avatar img { width: 40px; height: 40px; border-radius: 12px; object-fit: cover; border: 2px solid var(--primary-color); }

    /* ── Layout ── */
    .layout { display: flex; min-height: calc(100vh - 72px); }
    .main { flex: 1; padding: 40px; background: #f8fafc; max-width: 1200px; margin: 0 auto; }

    /* ── Header ── */
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .page-title { font-size: 1.85rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }

    /* ── Card ── */
    .form-card {
      background: #fff; border-radius: 24px; border: 1px solid #e2e8f0;
      padding: 40px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); margin-bottom: 32px;
    }

    /* ── Fields ── */
    .field-group { margin-bottom: 24px; }
    .field-label { display: block; font-size: 0.85rem; font-weight: 800; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
    .field-input, .field-select, .field-textarea {
      width: 100%; padding: 12px 16px; border-radius: 12px; border: 1.5px solid #e2e8f0;
      font-size: 0.95rem; font-weight: 600; color: #1e293b; transition: all 0.2s; outline: none; background: #fcfdfe;
    }
    .field-input:focus, .field-select:focus, .field-textarea:focus { border-color: var(--primary-color); background: #fff; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1); }
    .field-textarea { min-height: 100px; resize: vertical; }

    .field-input.error { border-color: #ef4444; background: #fff1f2; }
    .error-msg { font-size: 0.8rem; color: #ef4444; font-weight: 700; margin-top: 6px; display: none; }
    .error-msg.show { display: block; animation: shake 0.3s ease-in-out; }

    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }

    /* ── Image Slots ── */
    .img-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .img-slot {
      aspect-ratio: 1; border: 2px dashed #e2e8f0; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; position: relative; transition: all 0.2s; overflow: hidden; background: #f8fafc;
    }
    .img-slot:hover { border-color: var(--primary-color); background: #f1f5f9; }
    .img-slot input { display: none; }
    .remove-btn {
      position: absolute; top: 8px; right: 8px; width: 28px; height: 28px;
      background: #ef4444; color: white; border-radius: 50%; display: none;
      align-items: center; justify-content: center; font-size: 14px; border: none; cursor: pointer; z-index: 10;
    }

    /* ── Variants Table ── */
    .variants-section { margin-top: 40px; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .section-title { font-size: 1.2rem; font-weight: 800; color: #1e293b; }

    .variants-table-wrap { border: 1.5px solid #e2e8f0; border-radius: 16px; overflow: hidden; background: #fcfdfe; }
    .variants-table { width: 100%; border-collapse: collapse; }
    .variants-table th { background: #f8fafc; padding: 12px 16px; text-align: left; font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; border-bottom: 1.5px solid #e2e8f0; }
    .variants-table td { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    
    .vt-input, .vt-select {
      width: 100%; padding: 8px 12px; border-radius: 8px; border: 1.5px solid #e2e8f0;
      font-size: 0.85rem; font-weight: 700; color: #1e293b; outline: none; background: #fff;
    }
    .vt-input:focus, .vt-select:focus { border-color: var(--primary-color); box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1); }

    .btn-remove-row { width: 32px; height: 32px; border-radius: 8px; background: #fef2f2; color: #ef4444; border: 1px solid #fee2e2; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; }
    .btn-remove-row:hover { background: #ef4444; color: white; transform: scale(1.05); }

    .btn-add-variant {
      display: inline-flex; align-items: center; gap: 8px; background: #fff;
      color: var(--primary-color); border: 2px solid var(--primary-color);
      padding: 10px 20px; border-radius: 12px; font-size: 0.9rem; font-weight: 800;
      cursor: pointer; transition: all 0.2s;
    }
    .btn-add-variant:hover { background: var(--primary-color); color: white; transform: translateY(-1px); }

    /* ── Toggle Switch ── */
    .switch { position: relative; display: inline-block; width: 40px; height: 22px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; inset: 0; background: #cbd5e1; border-radius: 20px; transition: 0.3s; }
    .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.3s; }
    input:checked + .slider { background: #10b981; }
    input:checked + .slider:before { transform: translateX(18px); }
    input:disabled + .slider { opacity: 0.4; cursor: not-allowed; }

    /* ── Buttons ── */
    .btn-save {
      background: var(--bg-active); color: #fff; border: none; padding: 14px 40px;
      border-radius: 16px; font-size: 1rem; font-weight: 800; cursor: pointer;
      transition: all 0.3s; box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
      display: inline-flex; align-items: center; gap: 10px;
    }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.4); }
    
    .btn-cancel {
      background: #f1f5f9; color: #64748b; padding: 14px 40px; border-radius: 16px;
      font-size: 1rem; font-weight: 800; text-decoration: none; transition: all 0.2s;
      border: 1px solid #e2e8f0; display: inline-flex; align-items: center;
    }
    .btn-cancel:hover { background: #e2e8f0; color: #1e293b; }

    /* ── Modal ── */
    .crop-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 100; padding: 20px; }
    .crop-modal-overlay.open { display: flex; }
    .crop-modal { background: #fff; border-radius: 24px; padding: 32px; width: 100%; max-width: 600px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
    .crop-container { width: 100%; max-height: 400px; border-radius: 16px; overflow: hidden; background: #000; }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo"><img src="/img/pes.logo.png" alt="2ES Logo" /></div>
    <div class="topbar-actions">
      <div class="icon-circle"><svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
      <div class="avatar"><img src="/images/admin-avatar.jpg" alt="Admin" /></div>
    </div>
  </div>

  <div class="layout">
    <%- include('../partials/admin/sidebar.ejs', { activePage: 'products' }) %>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Edit Product</h1>
      </div>

      <%- include('../partials/sweetalert.ejs') %>

      <form id="editProductForm" action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
        <div class="form-card">
          
          <div style="display:grid; grid-template-columns: 2fr 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <div class="field-group">
              <label class="field-label">Product Name</label>
              <input type="text" name="name" id="name" class="field-input" placeholder="e.g. Nike Mercurial Vapor 15" value="<%= product.productname %>" />
              <p class="error-msg" id="nameErr"></p>
            </div>
            <div class="field-group">
              <label class="field-label">Brand</label>
              <select name="brand" id="brand" class="field-select">
                <option value="">Select Brand</option>
                <% ['Nike','Puma','Adidas','New Balance','Mizuno'].forEach(b => { %>
                  <option value="<%= b %>" <%= product.brand === b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
              <p class="error-msg" id="brandErr"></p>
            </div>
            <div class="field-group">
              <label class="field-label">Gender</label>
              <select name="gender" id="gender" class="field-select">
                <option value="">Select Gender</option>
                <% ['Male','Female','Unisex','Kids'].forEach(g => { %>
                  <option value="<%= g %>" <%= product.gender === g ? 'selected' : '' %>><%= g %></option>
                <% }) %>
              </select>
              <p class="error-msg" id="genderErr"></p>
            </div>
          </div>

          <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <div class="field-group">
              <label class="field-label">Category</label>
              <select name="category" id="category" class="field-select">
                <option value="">Select Category</option>
                <% if (typeof categories !== 'undefined') { %>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" <%= product.category && product.category._id && product.category._id.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                  <% }) %>
                <% } %>
              </select>
              <p class="error-msg" id="categoryErr"></p>
            </div>
            <div class="field-group">
              <label class="field-label">Collection</label>
              <select name="collection" id="collection" class="field-select">
                <option value="">Select Collection</option>
                <% ['Retro','Limited Edition','Latest','Signature'].forEach(c => { %>
                  <option value="<%= c %>" <%= product.collection === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
              <p class="error-msg" id="collectionErr"></p>
            </div>
          </div>

          <div class="field-group">
            <label class="field-label">Product Description</label>
            <textarea name="description" id="description" class="field-input" placeholder="Enter detailed product information..."><%= product.description %></textarea>
            <p class="error-msg" id="descErr"></p>
          </div>

          <div class="field-group" style="margin-top: 32px;">
            <label class="field-label">Product Images <span style="color:#ef4444; font-size:0.75rem; text-transform: none; margin-left: 8px;">(Please ensure all 3 slots have an image)</span></label>
            <div class="img-grid">
              <% for(let i = 0; i < 3; i++) { %>
                <div class="img-slot" id="slot-<%= i %>" onclick="triggerFileInput(<%= i %>)">
                  <input type="file" id="fileInput-<%= i %>" name="productImages" accept="image/*" onchange="handleFileSelect(event, <%= i %>)" />
                  <img id="preview-<%= i %>" src="<%= product.productImage && product.productImage[i] ? product.productImage[i] : '' %>" alt="" style="display:<%= product.productImage && product.productImage[i] ? 'block' : 'none' %>;width:100%;height:100%;object-fit:cover;border-radius:14px;" />
                  <div id="placeholder-<%= i %>" style="display:<%= product.productImage && product.productImage[i] ? 'none' : 'flex' %>;flex-direction:column;align-items:center;justify-content:center;gap:8px;">
                    <svg width="32" height="32" fill="none" stroke="#cbd5e1" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                    <span style="font-size:0.8rem;color:#94a3b8;font-weight:700;">Add Photo <%= i+1 %></span>
                  </div>
                  <button type="button" class="remove-btn" id="removeBtn-<%= i %>" style="display:<%= product.productImage && product.productImage[i] ? 'flex' : 'none' %>;" onclick="removeImage(event, <%= i %>)">✕</button>
                </div>
              <% } %>
            </div>
            <p class="error-msg" id="imgErr"></p>
            <input type="hidden" name="existingImage0" id="existingImage0" value="<%= product.productImage && product.productImage[0] ? product.productImage[0] : '' %>" />
            <input type="hidden" name="existingImage1" id="existingImage1" value="<%= product.productImage && product.productImage[1] ? product.productImage[1] : '' %>" />
            <input type="hidden" name="existingImage2" id="existingImage2" value="<%= product.productImage && product.productImage[2] ? product.productImage[2] : '' %>" />
          </div>

          <!-- Variants Section -->
          <div class="variants-section">
            <div class="section-header">
              <h2 class="section-title">Product Variants</h2>
              <button type="button" class="btn-add-variant" onclick="addVariantRow()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Add Variant
              </button>
            </div>

            <div class="variants-table-wrap">
              <table class="variants-table" id="variantsTable">
                <thead>
                  <tr>
                    <th>Size</th>
                    <th>Stock</th>
                    <th>Base Price</th>
                    <th>Discount %</th>
                    <th>Offer Price</th>
                    <th>Status</th>
                    <th style="text-align:center;">Offer</th>
                    <th style="width:50px;"></th>
                  </tr>
                </thead>
                <tbody id="variantsTbody"></tbody>
              </table>
              <div id="variantsEmpty" style="padding: 32px; text-align: center; color: #94a3b8; font-weight: 700; font-size: 0.9rem;">
                No variants added. Click "Add Variant" to define sizes and stock.
              </div>
            </div>
            <p class="error-msg" id="variantErr"></p>
          </div>

          <div style="display: flex; gap: 16px; justify-content: center; margin-top: 48px;">
            <a href="/admin/products" class="btn-cancel">Cancel</a>
            <button type="submit" id="saveBtn" class="btn-save">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
              Update Product
            </button>
          </div>

        </div>
      </form>
    </main>
  </div>

      </form>
    </main>
  </div>

  <!-- CROP MODAL -->
  <div class="crop-modal-overlay" id="cropModalOverlay">
    <div class="crop-modal">
      <h3 style="font-size:1rem;font-weight:800;color:#111;margin-bottom:16px;">Crop Image</h3>
      <div class="crop-container"><img id="cropImage" src="" alt="Crop" /></div>
      <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:20px;">
        <button type="button" onclick="cancelCrop()" style="background:#fff;border:2px solid #e5e7eb;border-radius:8px;padding:9px 22px;font-size:0.88rem;font-weight:700;cursor:pointer;font-family:'Nunito',sans-serif;">Cancel</button>
        <button type="button" onclick="applyCrop()" style="background:#22c55e;color:#fff;border:none;border-radius:8px;padding:9px 22px;font-size:0.88rem;font-weight:700;cursor:pointer;font-family:'Nunito',sans-serif;">Crop & Save</button>
      </div>
    </div>
  </div>

  <script>
  // ── Cropper ─────────────────────────────────────────────────────────────────
  let cropperInstance = null, currentSlotIndex = null

  // Track which slots already have images (existing or newly cropped)
  const slotHasFile = {
    0: !!('<%= product.productImage && product.productImage[0] ? product.productImage[0] : "" %>'),
    1: !!('<%= product.productImage && product.productImage[1] ? product.productImage[1] : "" %>'),
    2: !!('<%= product.productImage && product.productImage[2] ? product.productImage[2] : "" %>')
  }

  function triggerFileInput(i) { document.getElementById(`fileInput-${i}`).click() }

  function handleFileSelect(event, index) {
    const file = event.target.files[0]
    if (!file) return
    currentSlotIndex = index
    const reader = new FileReader()
    reader.onload = (e) => {
      const cropImg = document.getElementById('cropImage')
      cropImg.src = e.target.result
      document.getElementById('cropModalOverlay').classList.add('open')
      if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null }
      cropperInstance = new Cropper(cropImg, { aspectRatio: 1, viewMode: 1, autoCropArea: 0.9 })
    }
    reader.readAsDataURL(file)
  }

  function applyCrop() {
    if (!cropperInstance) return
    const idx = currentSlotIndex
    cropperInstance.getCroppedCanvas({ width: 600, height: 600 }).toBlob(blob => {
      const preview = document.getElementById(`preview-${idx}`)
      preview.src = URL.createObjectURL(blob)
      preview.style.display = 'block'
      document.getElementById(`placeholder-${idx}`).style.display = 'none'
      document.getElementById(`removeBtn-${idx}`).style.display = 'flex'
      const dt = new DataTransfer()
      dt.items.add(new File([blob], `product_image_${idx}.jpg`, { type: 'image/jpeg' }))
      document.getElementById(`fileInput-${idx}`).files = dt.files
      slotHasFile[idx] = true
      closeCropModal()
    }, 'image/jpeg', 0.9)
  }

  function cancelCrop() { document.getElementById(`fileInput-${currentSlotIndex}`).value = ''; closeCropModal() }
  function closeCropModal() {
    document.getElementById('cropModalOverlay').classList.remove('open')
    if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null }
  }
  function removeImage(event, index) {
    event.stopPropagation()
    document.getElementById(`preview-${index}`).style.display = 'none'
    document.getElementById(`preview-${index}`).src = ''
    document.getElementById(`placeholder-${index}`).style.display = 'flex'
    document.getElementById(`removeBtn-${index}`).style.display = 'none'
    document.getElementById(`fileInput-${index}`).value = ''
    document.getElementById(`existingImage${index}`).value = ''
    slotHasFile[index] = false
  }

  // ── Variants Table ───────────────────────────────────────────────────────────
  let variantCount = 0
  const SIZES = [4, 5, 6, 7, 8, 9, 10, 11, 12]

  function getUsedSizes() {
    const used = new Set()
    document.querySelectorAll('#variantsTbody .size-select').forEach(sel => {
      if (sel.value) used.add(Number(sel.value))
    })
    return used
  }

  function refreshSizeDropdowns() {
    const used = getUsedSizes()
    document.querySelectorAll('#variantsTbody .size-select').forEach(sel => {
      const current = sel.value ? Number(sel.value) : null
      Array.from(sel.options).forEach(opt => {
        if (!opt.value) return
        const val = Number(opt.value)
        opt.disabled = used.has(val) && val !== current
      })
    })
  }

  function sizeOptions(selected) {
    return '<option value="">Size</option>' +
      SIZES.map(s => `<option value="${s}"${String(selected) === String(s) ? ' selected' : ''}>${s}</option>`).join('')
  }

  function statusOptions(selected) {
    const opts = [['onStock', 'On Stock'], ['outOfStock', 'Out of Stock'], ['archived', 'Archived']]
    return opts.map(([v, l]) => `<option value="${v}"${selected === v ? ' selected' : ''}>${l}</option>`).join('')
  }

  function addVariantRow(data = {}) {
    const i = variantCount++
    const tbody = document.getElementById('variantsTbody')
    document.getElementById('variantsEmpty').style.display = 'none'

    const basePrice = data.basePrice || ''
    const disc = data.discountPercentage || 0
    const offerVal = (basePrice && disc > 0) ? (basePrice - basePrice * disc / 100).toFixed(2) : ''
    const offerText = offerVal ? `₹${offerVal}` : '-'
    const offerColor = offerVal ? '#15803d' : '#9ca3af'
    const toggleDisabled = (!basePrice || disc <= 0) ? 'disabled' : ''
    const toggleChecked = data.offerActive ? 'checked' : ''
    const hiddenVal = data.offerActive ? 'true' : 'false'

    const tr = document.createElement('tr')
    tr.className = 'variant-row'
    tr.dataset.idx = i
    tr.innerHTML = `
      <td>
        <select name="variants[${i}][sizes]" class="vt-select size-select" onchange="refreshSizeDropdowns()">
          ${sizeOptions(data.size)}
        </select>
      </td>
      <td><input type="number" name="variants[${i}][stock]" class="vt-input" value="${data.stock !== undefined ? data.stock : 5}" min="0" max="50" style="width:62px;" /></td>
      <td><input type="number" name="variants[${i}][basePrice]" id="basePrice-${i}" class="vt-input" value="${basePrice}" placeholder="1399" min="1" oninput="recalc(${i})" style="width:86px;" /></td>
      <td><input type="number" name="variants[${i}][discountPercentage]" id="discountPct-${i}" class="vt-input" value="${disc}" min="0" max="99" oninput="recalc(${i})" style="width:74px;" /></td>
      <td><span class="offer-price-cell${offerVal ? ' active' : ''}" id="offerDisp-${i}" style="color:${offerColor};">${offerText}</span></td>
      <td><select name="variants[${i}][status]" class="vt-select" style="width:112px;">${statusOptions(data.status)}</select></td>
      <td style="text-align:center;">
        <label class="toggle-switch">
          <input type="checkbox" id="offerToggle-${i}" ${toggleChecked} ${toggleDisabled}
            onchange="document.getElementById('offerHidden-${i}').value = this.checked ? 'true' : 'false'" />
          <span class="toggle-track"></span>
        </label>
        <input type="hidden" name="variants[${i}][offerActive]" id="offerHidden-${i}" value="${hiddenVal}" />
      </td>
      <td>
        <button type="button" class="btn-remove-row" onclick="removeVariantRow(this)" title="Remove">✕</button>
      </td>
    `
    tbody.appendChild(tr)
    refreshSizeDropdowns()
    syncEmpty()
  }

  function removeVariantRow(btn) {
    btn.closest('tr').remove()
    refreshSizeDropdowns()
    syncEmpty()
  }

  function syncEmpty() {
    const rows = document.querySelectorAll('#variantsTbody tr')
    document.getElementById('variantsEmpty').style.display = rows.length ? 'none' : 'block'
  }

  function recalc(i) {
    const base = parseFloat(document.getElementById(`basePrice-${i}`)?.value) || 0
    const pct  = parseFloat(document.getElementById(`discountPct-${i}`)?.value) || 0
    const disp = document.getElementById(`offerDisp-${i}`)
    const tog  = document.getElementById(`offerToggle-${i}`)
    const hid  = document.getElementById(`offerHidden-${i}`)
    if (!disp) return
    if (base > 0 && pct > 0) {
      const offer = (base - base * pct / 100).toFixed(2)
      disp.textContent = `₹${offer}`
      disp.style.color = '#15803d'
      disp.classList.add('active')
      tog.disabled = false
    } else {
      disp.textContent = '-'
      disp.style.color = '#9ca3af'
      disp.classList.remove('active')
      tog.disabled = true
      tog.checked = false
      hid.value = 'false'
    }
  }

  // ✅ FIX 2: Pre-fill existing variants from product data on page load
  const existingVariants = <%- JSON.stringify(product.variants || []) %>
  existingVariants.forEach(v => {
    addVariantRow({
      size:               v.size && v.size.length > 0 ? v.size[0] : '',
      stock:              v.stock,
      basePrice:          v.productPrice,
      discountPercentage: v.discountPercentage,
      offerActive:        v.offerActive,
      status:             v.status
    })
  })

  // ── Error helpers ────────────────────────────────────────────────────────────
  function showErr(id, msg) { const el = document.getElementById(id); if (el) { el.textContent = msg; el.classList.add('show') } }
  function hideErr(id) { const el = document.getElementById(id); if (el) el.classList.remove('show') }
  function showFieldErr(fid, eid, msg) { document.getElementById(fid)?.classList.add('error'); showErr(eid, msg) }
  function clearFieldErr(fid, eid) { document.getElementById(fid)?.classList.remove('error'); hideErr(eid) }

  ;[['name','nameErr'],['brand','brandErr'],['gender','genderErr'],
    ['category','categoryErr'],['collection','collectionErr'],['description','descErr']
  ].forEach(([f, e]) => {
    document.getElementById(f)?.addEventListener('change', () => clearFieldErr(f, e))
    document.getElementById(f)?.addEventListener('input',  () => clearFieldErr(f, e))
  })

  // ── Form submit ──────────────────────────────────────────────────────────────
  // ✅ FIX 1: Changed from 'addProductForm' to 'editProductForm'
  document.getElementById('editProductForm').addEventListener('submit', function(e) {
    let valid = true
    document.getElementById('generalError').style.display = 'none'

    ;[['name','nameErr','Product name is required'],['brand','brandErr','Please select a brand'],
      ['gender','genderErr','Please select a gender'],['category','categoryErr','Please select a category'],
      ['collection','collectionErr','Please select a collection'],['description','descErr','Please enter a description']
    ].forEach(([id, errId, msg]) => {
      const val = document.getElementById(id).value.trim()
      if (!val) { showFieldErr(id, errId, msg); valid = false } else clearFieldErr(id, errId)
    })

    // For edit: a slot is valid if it has an existing image OR a new file was cropped
    const existingImgs = [
      document.getElementById('existingImage0').value,
      document.getElementById('existingImage1').value,
      document.getElementById('existingImage2').value,
    ]
    const validSlots = [0,1,2].filter(i => existingImgs[i] || slotHasFile[i])
    if (validSlots.length < 3) { showErr('imgErr', 'Please ensure all 3 image slots have an image'); valid = false } else hideErr('imgErr')

    if (document.querySelectorAll('#variantsTbody tr').length === 0) { showErr('variantErr', 'Please add at least one variant'); valid = false } else hideErr('variantErr')

    if (!valid) {
      e.preventDefault()
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }
    // If valid, form submits normally (multipart POST)
  })
  </script>
</body>
</html>
