  <style>
    :root { --primary-color: #e53935; }
    * { font-family: 'Nunito', sans-serif; box-sizing: border-box; }
    body { background: #0f172a; min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; padding: 20px; }

    .login-card {
      background: #fff; width: 100%; max-width: 900px; display: flex;
      border-radius: 32px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes slideIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .login-left { flex: 1.1; padding: 60px; display: flex; flex-direction: column; justify-content: center; }
    .login-right { flex: 0.9; background: #f8fafc; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .login-right img { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
    
    .logo-container { margin-bottom: 40px; }
    .logo-container img { width: 64px; height: 64px; object-fit: contain; }

    .login-header h1 { font-size: 2.25rem; font-weight: 900; color: #0f172a; margin: 0 0 12px; letter-spacing: -0.02em; }
    .login-header p { font-size: 1rem; color: #64748b; font-weight: 600; margin: 0 0 40px; }

    .form-group { margin-bottom: 24px; position: relative; }
    .form-label { display: block; font-size: 0.85rem; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    
    .input-wrapper { position: relative; }
    .input-field {
      width: 100%; padding: 16px 20px; border-radius: 14px; border: 2px solid #f1f5f9;
      background: #fcfdfe; font-size: 0.95rem; font-weight: 600; color: #1e293b;
      transition: all 0.2s; outline: none;
    }
    .input-field:focus { border-color: var(--primary-color); background: #fff; box-shadow: 0 0 0 4px rgba(229, 57, 53, 0.1); }
    .input-field::placeholder { color: #94a3b8; font-weight: 500; }

    .btn-login {
      width: 100%; padding: 18px; border-radius: 16px; background: var(--primary-color);
      color: #fff; font-size: 1rem; font-weight: 800; border: none; cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); margin-top: 8px;
      box-shadow: 0 10px 15px -3px rgba(229, 57, 53, 0.3);
    }
    .btn-login:hover { transform: translateY(-2px); background: #d32f2f; box-shadow: 0 20px 25px -5px rgba(229, 57, 53, 0.4); }
    .btn-login:active { transform: translateY(0); }

    .error-box {
      background: #fef2f2; border: 1px solid #fee2e2; padding: 12px 16px;
      border-radius: 12px; color: #b91c1c; font-size: 0.85rem; font-weight: 700;
      margin-bottom: 24px; display: flex; align-items: center; gap: 10px;
    }

    @media (max-width: 768px) {
      .login-card { flex-direction: column; border-radius: 24px; }
      .login-right { display: none; }
      .login-left { padding: 40px; }
    }
  </style>
</head>
<body>

  <div class="login-card">
    <div class="login-left">
      <div class="logo-container">
        <img src="/img/pes.logo.png" alt="PES Store" />
      </div>

      <div class="login-header">
        <h1>Welcome Back</h1>
        <p>Login to your admin dashboard</p>
      </div>

      <%- include('../partials/sweetalert.ejs') %>

      <form action="/admin/login" method="POST">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <div class="input-wrapper">
            <input type="email" name="email" class="input-field" placeholder="admin@pesstore.com" required autocomplete="email" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Password</label>
          <div class="input-wrapper">
            <input type="password" name="password" class="input-field" placeholder="••••••••" required autocomplete="current-password" />
          </div>
        </div>

        <button type="submit" class="btn-login">Sign In</button>
      </form>
    </div>

    <div class="login-right">
      <img src="/img/adminLoginImg.jpg" alt="PES Admin" />
      <div style="position: absolute; bottom: 40px; left: 40px; right: 40px; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
        <p style="font-size: 1.25rem; font-weight: 800; margin: 0;">2ES Admin Console</p>
        <p style="font-size: 0.85rem; font-weight: 600; opacity: 0.8; margin-top: 4px;">Exclusive management for PES Store administrators.</p>
      </div>
    </div>
  </div>

</body>
</html>
