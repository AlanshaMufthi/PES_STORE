<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login as Admin | 2ES</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    * { font-family: 'Inter', sans-serif; }

    body {
      background: #000;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card {
      background: #fff;
      border-radius: 20px;
      width: 860px;
      min-height: 480px;
      display: flex;
      overflow: hidden;
      padding: 56px 52px 56px 52px;
      gap: 48px;
      align-items: center;
    }

    /* Left side */
    .left {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .page-title {
      font-size: 2.4rem;
      font-weight: 900;
      color: #111;
      line-height: 1.1;
      margin-bottom: 32px;
      letter-spacing: -0.02em;
    }

    .logo-wrap {
      margin-bottom: 32px;
    }

    .logo-wrap img {
      width: 80px;
      height: 80px;
      object-fit: contain;
    }

    /* Inputs */
    .input-field {
      width: 100%;
      background: #f3f3f3;
      border: 1.5px solid #e8e8e8;
      border-radius: 8px;
      padding: 16px 20px;
      font-size: 0.95rem;
      font-weight: 500;
      color: #555;
      outline: none;
      transition: border-color 0.2s;
      margin-bottom: 16px;
    }
    .input-field::placeholder { color: #aaa; font-weight: 500; }
    .input-field:focus { border-color: #ccc; background: #fff; }

    /* Login button */
    .btn-login {
      width: 100%;
      background: #e63946;
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      border: none;
      border-radius: 999px;
      padding: 16px;
      cursor: pointer;
      margin-top: 8px;
      transition: background 0.2s;
      letter-spacing: 0.01em;
    }
    .btn-login:hover { background: #c1121f; }

    /* Error message */
    .error-msg {
      color: #e63946;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 8px;
      margin-top: -8px;
    }

    /* Right side image */
    .right {
      width: 380px;
      flex-shrink: 0;
      border-radius: 12px;
      overflow: hidden;
      align-self: stretch;
    }
    .right img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 12px;
    }
  </style>
</head>
<body>

  <div class="card">

    <!-- ── LEFT SIDE ── -->
    <div class="left">

      <h1 class="page-title">Login as Admin</h1>

      <!-- Logo -->
      <div class="logo-wrap">
        <img src="/img/pes.logo.png" alt="PES Logo" />
      </div>

      <!-- Flash error message (EJS) -->
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="error-msg"><%= error %></p>
      <% } %>

      <!-- Form -->
      <form action="/admin/login" method="POST" style="width:100%;">

        <!-- CSRF token if you use it -->
        <% if (typeof csrfToken !== 'undefined') { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>

        <input
          class="input-field"
          type="email"
          name="email"
          placeholder="Email"
          required
          autocomplete="email"
        />

        <input
          class="input-field"
          type="password"
          name="password"
          placeholder="Password"
          required
          autocomplete="current-password"
        />

        <button type="submit" class="btn-login">Login</button>

      </form>

    </div>

    <!-- ── RIGHT SIDE IMAGE ── -->
    <div class="right">
      <img src="/img/adminLoginImg.jpg" alt="Admin visual" />
    </div>

  </div>

</body>
</html>
