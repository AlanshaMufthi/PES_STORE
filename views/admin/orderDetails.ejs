<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Details | PES Store Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { poppins: ['Poppins', 'sans-serif'] },
          colors: {
            sidebar: '#1a1f3c',
            'sidebar-hover': '#252b4a',
            brand: '#e53935',
            'btn-navy': '#1a237e',
            'badge-delivered': '#00897b',
            'badge-processing': '#7b1fa2',
            'badge-cancelled': '#e53935',
            'btn-export': '#1565c0',
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .nav-item { transition: background 0.2s; }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #3a4170; border-radius: 4px; }

    .timeline-item { position: relative; padding-left: 28px; }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: 7px; top: 20px;
      width: 2px;
      bottom: -8px;
      background: #e5e7eb;
    }
    .timeline-item:last-child::before { display: none; }
    .timeline-dot {
      position: absolute;
      left: 0; top: 4px;
      width: 16px; height: 16px;
      border-radius: 50%;
      border: 2px solid;
    }
    .dot-done   { background: #00897b; border-color: #00897b; }
    .dot-active { background: #f59e0b; border-color: #f59e0b; }
    .dot-future { background: #fff; border-color: #d1d5db; }

    @keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .fade-in { animation: fadeIn 0.4s ease both; }
    .fade-in-delay { animation: fadeIn 0.4s ease 0.15s both; }
  </style>
</head>
<body class="bg-gray-100 flex h-screen overflow-hidden">

  <!-- ===== SIDEBAR ===== -->
  <aside class="w-52 bg-sidebar flex flex-col flex-shrink-0 h-full">
    <div class="flex items-center justify-center py-6 border-b border-white/10">
      <div class="w-14 h-14 bg-white/10 rounded-xl flex items-center justify-center">
        <svg viewBox="0 0 64 64" class="w-10 h-10 fill-white" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="52" width="24" height="5" rx="2"/>
          <rect x="16" y="47" width="32" height="6" rx="2"/>
          <path d="M22 47 C22 35 18 30 18 22 C18 14 24 10 32 10 C40 10 46 14 46 22 C46 30 42 35 42 47Z"/>
          <rect x="29" y="4" width="6" height="14" rx="3"/>
          <rect x="24" y="8" width="16" height="5" rx="2"/>
          <rect x="10" y="18" width="44" height="5" rx="2"/>
        </svg>
      </div>
    </div>
    <nav class="flex-1 py-4 overflow-y-auto scrollbar-thin">
      <ul class="space-y-1 px-3">
        <li>
          <a href="/admin/dashboard" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            Dashboard
          </a>
        </li>
        <li>
          <a href="/admin/orders" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg bg-brand text-white text-sm font-semibold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            Order
          </a>
        </li>
        <li>
          <a href="/admin/products" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            Products
          </a>
        </li>
        <li>
          <a href="/admin/sales-report" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>
            Sales report
          </a>
        </li>
        <li>
          <a href="/admin/customers" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            Customer
          </a>
        </li>
        <li>
          <a href="/admin/coupons" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            Coupon
          </a>
        </li>
        <li>
          <a href="/admin/categories" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            Category
          </a>
        </li>
        <li>
          <a href="/admin/refunds" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
            Refund/Return
          </a>
        </li>
      </ul>
    </nav>
    <div class="px-3 pb-5">
      <a href="/admin/logout" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/60 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign Out
      </a>
    </div>
  </aside>

  <!-- ===== MAIN AREA ===== -->
  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Top Header -->
    <header class="bg-white h-16 flex items-center justify-between px-8 gap-4 border-b border-gray-200 flex-shrink-0">
      <a href="/admin/orders" class="flex items-center gap-2 text-gray-500 hover:text-gray-800 transition text-sm font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Orders
      </a>
      <div class="flex items-center gap-4">
        <button class="relative w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center hover:bg-gray-200 transition">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center">3</span>
        </button>
        <button class="relative w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center hover:bg-gray-200 transition">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-orange-400 text-white text-[9px] font-bold rounded-full flex items-center justify-center">5</span>
        </button>
        <button class="w-10 h-10 rounded-full overflow-hidden ring-2 ring-brand ring-offset-1">
          <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=admin" alt="Admin" class="w-full h-full object-cover bg-orange-200"/>
        </button>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-1 overflow-y-auto p-8">

      <!-- Page Title -->
      <div class="flex items-center justify-between mb-6 fade-in">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Order Details</h1>
          <p class="text-sm text-gray-400 mt-0.5">Order #<%= String(order._id).slice(-5).toUpperCase() %> &bull; <%= new Date(order.createdAt).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></p>
        </div>

        <!-- Status Badge -->
        <% const s = (order.orderStatus || '').toLowerCase(); %>
        <% if (s === 'delivered') { %>
          <span class="bg-badge-delivered text-white text-sm font-semibold px-4 py-1.5 rounded-lg">Delivered</span>
        <% } else if (s === 'processing' || s === 'shipped') { %>
          <span class="bg-badge-processing text-white text-sm font-semibold px-4 py-1.5 rounded-lg"><%= order.orderStatus %></span>
        <% } else if (s === 'cancelled') { %>
          <span class="bg-badge-cancelled text-white text-sm font-semibold px-4 py-1.5 rounded-lg">Cancelled</span>
        <% } else { %>
          <span class="bg-gray-500 text-white text-sm font-semibold px-4 py-1.5 rounded-lg"><%= order.orderStatus %></span>
        <% } %>
      </div>

      <div class="grid grid-cols-3 gap-6">

        <!-- LEFT COLUMN: Items + Timeline -->
        <div class="col-span-2 space-y-5">

          <!-- Order Items Card -->
          <div class="bg-white rounded-xl shadow-sm overflow-hidden fade-in">
            <div class="px-6 py-4 border-b border-gray-100">
              <h2 class="text-sm font-semibold text-gray-700">
                Ordered Items
                <span class="ml-2 bg-gray-100 text-gray-500 text-xs font-medium px-2 py-0.5 rounded-full"><%= order.items.length %> item<%= order.items.length > 1 ? 's' : '' %></span>
              </h2>
            </div>
            <div class="divide-y divide-gray-50">
              <% order.items.forEach((item, idx) => { %>
              <div class="flex items-center gap-5 px-6 py-4 hover:bg-gray-50 transition">
                <!-- Product Image -->
                <div class="w-20 h-20 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden">
                  <% const imgArr = item.productId?.productImage; %>
                  <% if (imgArr && imgArr.length > 0) { %>
                    <img src="/<%= imgArr[0] %>" alt="<%= item.name %>" class="w-full h-full object-cover"/>
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                      <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                  <% } %>
                </div>
                <!-- Product Info -->
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-gray-800 text-sm truncate"><%= item.productId?.productname || item.name %></p>
                  <% if (item.size) { %><p class="text-xs text-gray-400 mt-0.5">Size: <%= item.size %></p><% } %>
                  <p class="text-xs text-gray-400 mt-0.5">Qty: <%= item.quantity %></p>
                </div>
                <!-- Price -->
                <div class="text-right flex-shrink-0">
                  <p class="font-bold text-gray-800">₹ <%= (item.price * item.quantity).toLocaleString('en-IN') %></p>
                  <p class="text-xs text-gray-400 mt-0.5">₹ <%= item.price %> each</p>
                </div>
              </div>
              <% }) %>
            </div>
          </div>

          <!-- Order Timeline Card -->
          <div class="bg-white rounded-xl shadow-sm fade-in-delay">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
              <h2 class="text-sm font-semibold text-gray-700">Order Timeline</h2>
              <a href="/admin/orders/<%= order._id %>/status"
                 class="flex items-center gap-1 text-btn-navy text-xs font-semibold hover:underline transition">
                See all updates
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
            <div class="px-6 py-5 space-y-5">

              <%
                const statusSteps = [
                  { key: 'placed',     label: 'Order Confirmed',  icon: '✓' },
                  { key: 'processing', label: 'Processing',       icon: '⚙' },
                  { key: 'shipped',    label: 'Shipped',          icon: '🚚' },
                  { key: 'delivered',  label: 'Delivered',        icon: '📦' },
                ];
                const statusOrder = ['placed','processing','shipped','delivered','cancelled'];
                const currentIdx  = statusOrder.indexOf((order.orderStatus || '').toLowerCase());
              %>

              <% if ((order.orderStatus || '').toLowerCase() === 'cancelled') { %>
                <!-- Cancelled state -->
                <div class="timeline-item pb-2">
                  <div class="timeline-dot dot-done"></div>
                  <p class="text-sm font-semibold text-gray-700">Order Placed</p>
                  <p class="text-xs text-gray-400 mt-0.5"><%= new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></p>
                </div>
                <div class="timeline-item pb-2">
                  <div class="timeline-dot" style="background:#e53935;border-color:#e53935;"></div>
                  <p class="text-sm font-semibold text-red-600">Order Cancelled</p>
                  <p class="text-xs text-gray-400 mt-0.5">Order was cancelled</p>
                </div>
              <% } else { %>
                <% statusSteps.forEach((step, i) => {
                     const done   = i < currentIdx;
                     const active = i === currentIdx;
                %>
                <div class="timeline-item pb-2">
                  <div class="timeline-dot <%= done ? 'dot-done' : (active ? 'dot-active' : 'dot-future') %>"></div>
                  <p class="text-sm font-semibold <%= done || active ? 'text-gray-800' : 'text-gray-400' %>">
                    <%= step.label %>
                  </p>
                  <% if (i === 0) { %>
                    <p class="text-xs text-gray-400 mt-0.5">
                      <%= new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
                    </p>
                  <% } else if (done || active) { %>
                    <p class="text-xs text-gray-400 mt-0.5">Completed</p>
                  <% } else { %>
                    <p class="text-xs text-gray-300 mt-0.5">Pending</p>
                  <% } %>
                </div>
                <% }) %>
              <% } %>

            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div class="space-y-5">

          <!-- Invoice Download -->
          <a href="/admin/orders/<%= order._id %>/invoice"
             class="bg-white rounded-xl shadow-sm flex items-center justify-between px-5 py-4 hover:shadow-md transition fade-in group">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center group-hover:bg-blue-100 transition">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/>
                  <line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                </svg>
              </div>
              <span class="text-sm font-semibold text-gray-700">Invoice Download</span>
            </div>
            <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 transition" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <!-- Shipping Details -->
          <div class="bg-white rounded-xl shadow-sm fade-in">
            <div class="px-5 py-4 border-b border-gray-100">
              <h2 class="text-sm font-semibold text-gray-700">Shipping Details</h2>
            </div>
            <div class="px-5 py-4 space-y-1.5">
              <p class="font-semibold text-gray-800 text-sm"><%= order.deliveryAddress?.name || order.userId?.name %></p>
              <p class="text-xs text-gray-500 leading-relaxed">
                <%= order.deliveryAddress?.houseName || '' %>
                <% if(order.deliveryAddress?.houseName) { %>,<% } %>
                <%= order.deliveryAddress?.place %>,
                <%= order.deliveryAddress?.city || '' %>
                <% if(order.deliveryAddress?.city) { %>,<% } %>
                <%= order.deliveryAddress?.state || '' %> - <%= order.deliveryAddress?.pincode %>
              </p>
              <% if(order.deliveryAddress?.phone) { %>
              <p class="text-xs text-gray-400 flex items-center gap-1.5 pt-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.22 2.18 2 2 0 012.22 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.09a16 16 0 006 6l.61-.61a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
                <%= order.deliveryAddress.phone %>
              </p>
              <% } %>
              <% if(order.userId?.email) { %>
              <p class="text-xs text-gray-400 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <%= order.userId.email %>
              </p>
              <% } %>
            </div>
          </div>

          <!-- Payment Details -->
          <div class="bg-white rounded-xl shadow-sm fade-in">
            <div class="px-5 py-4 border-b border-gray-100">
              <h2 class="text-sm font-semibold text-gray-700">Payment Details</h2>
            </div>
            <div class="px-5 py-3">
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Method</span>
                <span class="text-xs font-semibold text-gray-700 uppercase"><%= order.paymentMethod %></span>
              </div>
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Payment Status</span>
                <% const ps = (order.paymentStatus || '').toLowerCase(); %>
                <span class="text-xs font-semibold <%= ps === 'paid' ? 'text-green-600' : ps === 'pending' ? 'text-amber-500' : 'text-red-500' %>">
                  <%= order.paymentStatus %>
                </span>
              </div>
            </div>
          </div>

          <!-- Price Details -->
          <div class="bg-white rounded-xl shadow-sm fade-in">
            <div class="px-5 py-4 border-b border-gray-100">
              <h2 class="text-sm font-semibold text-gray-700">Price Details</h2>
            </div>
            <div class="px-5 py-3 space-y-0.5">
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Price (<%= order.items.length %> item<%= order.items.length > 1 ? 's' : '' %>)</span>
                <span class="text-xs font-medium text-gray-700">₹ <%= (order.subtotal || 0).toLocaleString('en-IN') %></span>
              </div>
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Delivery Charges</span>
                <% if (!order.deliveryCharge || order.deliveryCharge === 0) { %>
                  <span class="text-xs font-semibold text-green-600">FREE</span>
                <% } else { %>
                  <span class="text-xs font-medium text-gray-700">₹ <%= order.deliveryCharge %></span>
                <% } %>
              </div>
              <% if (order.platformFee !== undefined) { %>
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Platform fee</span>
                <span class="text-xs font-medium text-gray-700">₹ <%= order.platformFee %></span>
              </div>
              <% } %>
              <% if (order.deliveryTip !== undefined && order.deliveryTip > 0) { %>
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Delivery tip</span>
                <span class="text-xs font-medium text-gray-700">₹ <%= order.deliveryTip %></span>
              </div>
              <% } %>
              <% if (order.discount && order.discount > 0) { %>
              <div class="flex items-center justify-between py-1.5">
                <span class="text-xs text-gray-500">Discount</span>
                <span class="text-xs font-semibold text-green-600">- ₹ <%= order.discount %></span>
              </div>
              <% } %>
              <div class="border-t border-gray-100 mt-2 pt-3 flex items-center justify-between">
                <span class="text-sm font-bold text-gray-800">Total Amount</span>
                <span class="text-sm font-bold text-gray-900">₹ <%= (order.total || 0).toLocaleString('en-IN') %></span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </main>
  </div>

</body>
</html>
