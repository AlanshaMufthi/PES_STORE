<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Details | PES Admin</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    * { font-family: 'Nunito', sans-serif; box-sizing: border-box; }
    body { background: #f0f2f5; margin: 0; color: #1a1a2e; }

    /* ── Topbar ── */
    .topbar {
      background: #e8e8e8;
      height: 72px; display: flex; align-items: center;
      padding: 0 32px; gap: 20px; position: sticky; top: 0; z-index: 50;
      border-bottom: 1px solid #d0d0d0;
    }
    .topbar-logo img { width: 56px; height: 56px; object-fit: contain; }
    .topbar-search {
      flex: 1; max-width: 500px; margin: 0 auto;
      display: flex; align-items: center;
      background: #fff; border-radius: 10px;
      border: 1px solid #ddd; padding: 0 16px; height: 44px; gap: 10px;
    }
    .topbar-search input { border: none; outline: none; font-size: 0.9rem; color: #333; width: 100%; background: transparent; font-family: 'Nunito', sans-serif; }
    .topbar-search input::placeholder { color: #aaa; }
    .search-btn {
      width: 38px; height: 38px; background: #222; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      border: none; cursor: pointer; flex-shrink: 0;
    }
    .topbar-actions { display: flex; align-items: center; gap: 12px; }
    .icon-circle {
      width: 40px; height: 40px; border-radius: 50%;
      background: #fff; display: flex; align-items: center; justify-content: center;
      cursor: pointer; border: 1px solid #ddd; position: relative;
    }
    .notif-dot {
      position: absolute; top: 6px; right: 6px;
      width: 8px; height: 8px; border-radius: 50%;
      background: #e53935; border: 2px solid #e8e8e8;
    }
    .avatar-circle {
      width: 40px; height: 40px; border-radius: 50%;
      overflow: hidden; border: 2px solid #ddd; cursor: pointer;
    }
    .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Layout ── */
    .layout { display: flex; min-height: calc(100vh - 72px); }
    .main { flex: 1; padding: 32px 40px; background: #f0f2f5; }

    /* ── Back button ── */
    .btn-back {
      display: inline-flex; align-items: center; gap: 8px;
      color: #555; text-decoration: none; font-size: 0.9rem;
      font-weight: 700; margin-bottom: 20px;
      transition: color 0.2s;
    }
    .btn-back:hover { color: #111; }

    /* ── Page title ── */
    .page-title { font-size: 1.8rem; font-weight: 900; color: #111; margin-bottom: 24px; }

    /* ── Main grid ── */
    .content-grid { display: grid; grid-template-columns: 1fr 320px; gap: 20px; align-items: start; }

    /* ── Cards ── */
    .card {
      background: #fff; border-radius: 16px;
      border: 1px solid #e8e8e8;
      overflow: hidden;
    }

    /* ── Top empty area (image placeholder) ── */
    .img-placeholder {
      background: #f5f5f5; height: 120px;
      border-radius: 16px; margin-bottom: 16px;
      border: 1px solid #e8e8e8;
    }

    /* ── Product card ── */
    .product-card { padding: 24px; }
    .product-name { font-size: 1.1rem; font-weight: 900; color: #111; margin-bottom: 6px; }
    .product-price { font-size: 1.1rem; font-weight: 800; color: #111; margin-bottom: 20px; }

    /* ── Timeline ── */
    .timeline { margin-top: 8px; }
    .timeline-item { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 0; position: relative; }
    .timeline-left { display: flex; flex-direction: column; align-items: center; }
    .tl-dot {
      width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0;
      margin-top: 3px;
    }
    .tl-dot.green  { background: #22c55e; }
    .tl-dot.orange { background: #f97316; }
    .tl-dot.gray   { background: #d1d5db; }
    .tl-line { width: 2px; flex: 1; min-height: 28px; background: #e5e7eb; margin: 2px 0; }
    .tl-line.green  { background: #22c55e; }
    .tl-line.orange { background: #f97316; }
    .timeline-text { font-size: 0.88rem; font-weight: 700; color: #222; padding-bottom: 24px; }
    .timeline-text span { font-weight: 600; color: #888; margin-left: 6px; }

    .see-all {
      color: #6366f1; font-size: 0.85rem; font-weight: 800;
      text-decoration: none; display: inline-flex; align-items: center; gap: 4px;
      margin-top: 4px;
    }
    .see-all:hover { opacity: 0.8; }

    /* ── Product image in card ── */
    .product-img-wrap {
      width: 130px; height: 120px; border-radius: 10px;
      overflow: hidden; border: 1px solid #f0f0f0; flex-shrink: 0;
    }
    .product-img-wrap img { width: 100%; height: 100%; object-fit: contain; background: #f9f9f9; }

    /* ── Right sidebar cards ── */
    .sidebar-card { background: #fff; border-radius: 16px; border: 1px solid #e8e8e8; overflow: hidden; margin-bottom: 16px; }
    .sidebar-card:last-child { margin-bottom: 0; }

    .invoice-btn {
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 20px; text-decoration: none; color: #111;
      font-weight: 700; font-size: 0.95rem;
      transition: background 0.15s;
    }
    .invoice-btn:hover { background: #f9f9f9; }
    .invoice-left { display: flex; align-items: center; gap: 10px; }

    .shipping-card-body { padding: 18px 20px; }
    .shipping-label { font-size: 0.75rem; font-weight: 800; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 10px; }
    .shipping-name { font-size: 0.95rem; font-weight: 800; color: #111; margin-bottom: 6px; }
    .shipping-addr { font-size: 0.85rem; font-weight: 600; color: #555; line-height: 1.6; }

    .price-card-body { padding: 18px 20px; }
    .price-label { font-size: 0.75rem; font-weight: 800; color: #888; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 14px; }
    .price-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .price-row-label { font-size: 0.88rem; font-weight: 700; color: #333; }
    .price-row-value { font-size: 0.88rem; font-weight: 800; color: #111; }
    .price-row-value.green { color: #22c55e; }
    .price-divider { height: 1px; background: #f0f0f0; margin: 12px 0; }
    .price-total-label { font-size: 0.88rem; font-weight: 800; color: #111; }
    .price-total-value { font-size: 1rem; font-weight: 900; color: #111; }

    /* ── Update status btn ── */
    .btn-update-status {
      display: block; width: 100%;
      background: #6366f1; color: #fff;
      border: none; border-radius: 10px;
      padding: 13px; font-size: 0.9rem; font-weight: 800;
      cursor: pointer; text-align: center;
      text-decoration: none; margin-top: 16px;
      transition: background 0.2s;
    }
    .btn-update-status:hover { background: #4f46e5; }

    /* status badge */
    .status-badge { padding: 5px 14px; border-radius: 8px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
    .status-placed        { background: #eff6ff; color: #2563eb; }
    .status-processing    { background: #f0f9ff; color: #0891b2; }
    .status-shipped       { background: #fef3c7; color: #d97706; }
    .status-out_for_delivery { background: #e0f2fe; color: #0369a1; }
    .status-delivered     { background: #ecfdf5; color: #059669; }
    .status-cancelled     { background: #fef2f2; color: #dc2626; }
    .status-returned      { background: #f5f3ff; color: #7c3aed; }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo">
      <img src="/img/pes.logo.png" alt="PES Logo" />
    </div>
    <div class="topbar-search">
      <input type="text" placeholder="Search orders" />
      <button class="search-btn">
        <svg width="16" height="16" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
    </div>
    <div class="topbar-actions">
      <div class="icon-circle">
        <svg width="18" height="18" fill="none" stroke="#555" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </div>
      <div class="icon-circle">
        <svg width="18" height="18" fill="none" stroke="#555" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <div class="notif-dot"></div>
      </div>
      <div class="avatar-circle">
        <img src="/images/admin-avatar.jpg" alt="Admin" onerror="this.src='/img/pes.logo.png'"/>
      </div>
    </div>
  </div>

  <div class="layout">
    <%- include('../partials/admin/sidebar.ejs', { activePage: 'orders' }) %>

    <main class="main">

      <!-- Back -->
      <a href="/admin/orders" class="btn-back">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <polyline points="19 12 5 12"/><polyline points="12 5 5 12 12 19"/>
        </svg>
      </a>

      <!-- Title row -->
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
        <h1 class="page-title" style="margin:0;">Orders Details</h1>
        <span class="status-badge status-<%= (order.orderStatus||'').toLowerCase() %>">
          <%= order.orderStatus %>
        </span>
      </div>

      <div class="content-grid">

        <!-- LEFT COLUMN -->
        <div>

          <!-- Empty image placeholder (as per Figma) -->
          <div class="img-placeholder"></div>

          <!-- Product + Timeline card -->
          <div class="card">
            <div class="product-card">

              <!-- Product row: info + image -->
              <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:20px;">
                <div style="flex:1;">
                  <% const firstItem = order.items && order.items[0]; %>
                  <p class="product-name"><%= firstItem?.productId?.productname || firstItem?.name || 'Product' %></p>
                  <p class="product-price">₹ <%= (firstItem?.price || 0).toLocaleString('en-IN') %></p>

                  <!-- Timeline -->
                  <div class="timeline">
                    <%
                      const steps = [
                        { key: 'placed',            label: 'Order Confirmed' },
                        { key: 'processing',        label: 'Processing'      },
                        { key: 'shipped',           label: 'Shipped'         },
                        { key: 'out_for_delivery',  label: 'Out For Delivery'},
                        { key: 'delivered',         label: 'Delivered'       }
                      ];
                      const currentStatus = (order.orderStatus || '').toLowerCase();
                      const currentIdx    = steps.findIndex(s => s.key === currentStatus);
                      const isCancelled   = currentStatus === 'cancelled';
                      const isReturned    = currentStatus === 'returned';

                      const displaySteps = isCancelled
                        ? [{ key:'placed', label:'Order Confirmed' }, { key:'cancelled', label:'Order Cancelled' }]
                        : isReturned
                        ? [{ key:'placed', label:'Order Confirmed' }, { key:'delivered', label:'Delivered' }, { key:'returned', label:'Returned' }]
                        : steps;
                    %>

                    <% displaySteps.forEach((step, idx) => {
                      const isLast   = idx === displaySteps.length - 1;
                      const isDone   = !isCancelled && !isReturned && idx <= currentIdx;
                      const isActive = !isCancelled && !isReturned && idx === currentIdx;
                      const dotColor = isCancelled && step.key === 'cancelled' ? 'orange'
                                     : isReturned  && step.key === 'returned'  ? 'orange'
                                     : isDone ? 'green' : 'gray';
                      const lineColor = isDone && !isLast ? 'green' : '';
                      const date = idx === 0 ? new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '';
                    %>
                    <div class="timeline-item">
                      <div class="timeline-left">
                        <div class="tl-dot <%= dotColor %>"></div>
                        <% if (!isLast) { %><div class="tl-line <%= lineColor %>"></div><% } %>
                      </div>
                      <div class="timeline-text">
                        <%= step.label %><% if (date) { %><span><%= date %></span><% } %>
                      </div>
                    </div>
                    <% }) %>

                  </div>

                  <a href="/admin/orders/<%= order._id %>/status" class="see-all">
                    See all updates
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                  </a>
                </div>

                <!-- Product image -->
                <div class="product-img-wrap">
                  <% const imgArr = firstItem?.productId?.productImage; %>
                  <% if (imgArr && imgArr.length > 0) { %>
                    <% const imgSrc = imgArr[0].startsWith('/') ? imgArr[0] : '/' + imgArr[0]; %>
                    <img src="<%= imgSrc %>" alt="product" onerror="this.style.visibility='hidden'"/>
                  <% } %>
                </div>
              </div>

              <!-- All items if more than 1 -->
              <% if (order.items.length > 1) { %>
                <div style="border-top:1px solid #f0f0f0; padding-top:16px; margin-top:4px;">
                  <p style="font-size:0.75rem; font-weight:800; color:#888; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:12px;">
                    All Items (<%= order.items.length %>)
                  </p>
                  <% order.items.forEach((item, i) => { if (i === 0) return; %>
                  <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
                    <% const iImg = item.productId?.productImage; %>
                    <% if (iImg && iImg.length > 0) { %>
                      <img src="<%= iImg[0].startsWith('/') ? iImg[0] : '/' + iImg[0] %>"
                           style="width:48px;height:48px;object-fit:contain;border-radius:8px;border:1px solid #f0f0f0;" />
                    <% } %>
                    <div style="flex:1;">
                      <p style="font-size:0.85rem;font-weight:800;color:#111;margin:0;"><%= item.productId?.productname || item.name %></p>
                      <p style="font-size:0.78rem;font-weight:600;color:#888;margin:2px 0 0;">Size: <%= item.size %> &bull; Qty: <%= item.quantity %></p>
                    </div>
                    <p style="font-size:0.88rem;font-weight:800;color:#111;">₹<%= ((item.price||0)*item.quantity).toLocaleString('en-IN') %></p>
                  </div>
                  <% }) %>
                </div>
              <% } %>

            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div>

          <!-- Invoice Download -->
          <div class="sidebar-card">
            <a href="/admin/orders/<%= order._id %>/invoice" class="invoice-btn">
              <div class="invoice-left">
                <svg width="18" height="18" fill="none" stroke="#555" stroke-width="2" viewBox="0 0 24 24">
                  <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                  <rect x="6" y="14" width="12" height="8"/>
                </svg>
                Invoice Download
              </div>
              <svg width="16" height="16" fill="none" stroke="#aaa" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>

          <!-- Shipping Details -->
          <div class="sidebar-card">
            <div class="shipping-card-body">
              <p class="shipping-label">Shipping Details</p>
              <%
                const addr = order.deliveryAddress || {};
                const custName = order.userId
                  ? ((order.userId.firstName||'') + ' ' + (order.userId.lastName||'')).trim() || order.userId.email
                  : addr.name || '—';
              %>
              <p class="shipping-name"><%= custName %></p>
              <p class="shipping-addr">
                <%= addr.place || addr.addressLine || '—' %><br>
                <% if (addr.town || addr.state) { %><%= addr.town || '' %><% if (addr.state) { %>, <%= addr.state %><% } %><br><% } %>
                <% if (addr.pincode) { %>- <%= addr.pincode %><% } %>
              </p>
            </div>
          </div>

          <!-- Price Details -->
          <div class="sidebar-card">
            <div class="price-card-body">
              <p class="price-label">Price Details</p>

              <div class="price-row">
                <span class="price-row-label">Price (<%= order.items.length %> item<%= order.items.length !== 1 ? 's' : '' %>)</span>
                <span class="price-row-value">₹ <%= (order.subtotal || 0).toLocaleString('en-IN') %></span>
              </div>

              <div class="price-row">
                <span class="price-row-label">Delivery Charges</span>
                <span class="price-row-value green"><%= (order.deliveryCharge || 0) > 0 ? '₹ ' + order.deliveryCharge : 'FREE' %></span>
              </div>

              <div class="price-row">
                <span class="price-row-label">Platform fee</span>
                <span class="price-row-value">₹ 0</span>
              </div>

              <% if (order.discount > 0) { %>
              <div class="price-row">
                <span class="price-row-label">Discount</span>
                <span class="price-row-value" style="color:#ef4444;">− ₹ <%= order.discount.toLocaleString('en-IN') %></span>
              </div>
              <% } %>

              <div class="price-divider"></div>

              <div class="price-row">
                <span class="price-total-label">Total Amount</span>
                <span class="price-total-value">₹ <%= (order.total || 0).toLocaleString('en-IN') %></span>
              </div>
            </div>
          </div>

          <!-- Update Status -->
          <a href="/admin/orders/<%= order._id %>/status" class="btn-update-status">
            Update Order Status →
          </a>

        </div>
      </div>

    </main>
  </div>

</body>
</html>




const order = await order.findOne(
  {$and:{
    [orderStatus:'delivered',orderMethod:'COD']
  }}
)