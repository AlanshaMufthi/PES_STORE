<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Status | PES Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root { --primary-color: #6366f1; }
    * { font-family: 'Nunito', sans-serif; box-sizing: border-box; }
    body { background: #f8fafc; margin: 0; color: #334155; }

    /* ── Topbar ── */
    .topbar { background: #fff; height: 72px; display: flex; align-items: center; padding: 0 32px; gap: 20px; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #e2e8f0; }
    .topbar-logo img { width: 52px; height: 52px; object-fit: contain; }
    .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 16px; }
    .icon-circle { width: 40px; height: 40px; border-radius: 12px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; border: 1px solid #e2e8f0; }
    .icon-circle:hover { background: #e2e8f0; transform: translateY(-1px); }
    .avatar img { width: 40px; height: 40px; border-radius: 12px; object-fit: cover; border: 2px solid var(--primary-color); }

    /* ── Layout ── */
    .layout { display: flex; min-height: calc(100vh - 72px); }
    .main { flex: 1; padding: 40px; background: #f8fafc; }

    /* ── Header ── */
    .page-header { display: flex; align-items: center; gap: 20px; margin-bottom: 32px; }
    .page-title { font-size: 1.85rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }

    /* ── Cards ── */
    .card { background: #fff; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); padding: 32px; }
    .card-title { font-size: 0.85rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 20px; }

    /* ── Status Grid ── */
    .status-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 32px; }
    .status-btn {
      padding: 24px; border-radius: 20px; border: 2px solid #f1f5f9; background: #fff;
      display: flex; flex-direction: column; align-items: center; gap: 12px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; position: relative;
    }
    .status-btn:hover:not(:disabled) { border-color: #e2e8f0; transform: translateY(-4px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); }
    .status-btn.active { border-color: var(--primary-color); background: #fcfdfe; }
    .status-btn.active::after {
      content: '✓'; position: absolute; top: -10px; right: -10px; width: 28px; height: 28px;
      background: var(--primary-color); color: #fff; border-radius: 50%; display: flex;
      align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 900;
      border: 3px solid #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }
    .status-btn:disabled { opacity: 0.5; cursor: not-allowed; background: #f8fafc; }

    .status-label { font-size: 1rem; font-weight: 800; color: #1e293b; }
    .status-desc { font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-align: center; }

    /* ── Alert Box ── */
    .alert-box {
      background: #fef2f2; border: 1px solid #fee2e2; border-radius: 16px;
      padding: 20px; display: flex; gap: 16px; margin-bottom: 32px;
    }
    .alert-icon { width: 40px; height: 40px; border-radius: 12px; background: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .alert-content h4 { margin: 0; font-size: 0.95rem; font-weight: 800; color: #991b1b; }
    .alert-content p { margin: 4px 0 0; font-size: 0.85rem; color: #b91c1c; font-weight: 600; opacity: 0.8; }

    .btn-back { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 14px; background: #fff; border: 1px solid #e2e8f0; color: #64748b; transition: all 0.2s; }
    .btn-back:hover { color: #1e293b; border-color: #cbd5e1; transform: translateX(-2px); }

    /* Toast */
    #toast {
      position: fixed; bottom: 32px; right: 32px;
      background: #0f172a; color: white;
      padding: 16px 24px; border-radius: 16px;
      font-size: 0.9rem; font-weight: 600;
      display: flex; align-items: center; gap: 12px;
      transform: translateY(100px); opacity: 0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); z-index: 9999;
      pointer-events: none; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    }
    #toast.show { transform: translateY(0); opacity: 1; }
    #toast.success { border-left: 5px solid #10b981; }
    #toast.error   { border-left: 5px solid #ef4444; }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo"><img src="/img/pes.logo.png" alt="2ES Logo" /></div>
    <div class="topbar-actions">
      <div class="icon-circle"><svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
      <div class="avatar"><img src="/images/admin-avatar.jpg" alt="Admin" /></div>
    </div>
  </div>

  <div class="layout">
    <%- include('../partials/admin/sidebar.ejs', { activePage: 'orders' }) %>

    <main class="main">
      <div class="page-header">
        <a href="/admin/orders/<%= order._id %>" class="btn-back">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </a>
        <div>
          <h1 class="page-title">Update Status</h1>
          <p style="color: #64748b; font-weight: 600; margin: 4px 0 0;">Order #<%= order.orderId || String(order._id).slice(-8).toUpperCase() %></p>
        </div>
      </div>

      <% if (order.orderStatus === 'cancel_requested' || order.orderStatus === 'return_requested') { %>
        <div class="alert-box">
          <div class="alert-icon">
            <svg width="20" height="20" fill="none" stroke="#ef4444" stroke-width="2.5" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="alert-content">
            <h4>User Requested <%= order.orderStatus === 'cancel_requested' ? 'Cancellation' : 'Return' %></h4>
            <p>Reason: "<%= order.cancellationReason || order.returnReason || 'No reason provided' %>"</p>
          </div>
        </div>
      <% } %>

      <div class="card">
        <h2 class="card-title">Select New Status</h2>
        
        <div class="status-grid">
          <% 
            const s = (order.orderStatus || '').toLowerCase();
            const canCancel = ['placed', 'processing', 'cancel_requested'].includes(s);
            const isDelivered = s === 'delivered';
          %>

          <!-- Processing -->
          <button onclick="updateStatus('processing', this)" 
            <%= (s !== 'placed' && s !== 'processing') ? 'disabled' : '' %>
            class="status-btn <%= s === 'processing' ? 'active' : '' %>">
            <span class="status-label">Processing</span>
            <span class="status-desc">Items are being prepared for shipping</span>
          </button>

          <!-- Shipped -->
          <button onclick="updateStatus('shipped', this)" 
            <%= (s === 'delivered' || s === 'cancelled' || s === 'returned') ? 'disabled' : '' %>
            class="status-btn <%= s === 'shipped' ? 'active' : '' %>">
            <span class="status-label">Shipped</span>
            <span class="status-desc">Package has been handed to courier</span>
          </button>

          <!-- Out For Delivery -->
          <button onclick="updateStatus('out_for_delivery', this)"
            <%= (s === 'cancelled' || s === 'returned' || s === 'delivered') ? 'disabled' : '' %>
            class="status-btn <%= s === 'out_for_delivery' ? 'active' : '' %>">
            <span class="status-label">Out For Delivery</span>
            <span class="status-desc">Courier is delivering the package</span>
          </button>

          <!-- Delivered -->
          <button onclick="updateStatus('delivered', this)" 
            <%= (s === 'cancelled' || s === 'returned' || s === 'delivered') ? 'disabled' : '' %>
            class="status-btn <%= s === 'delivered' ? 'active' : '' %>">
            <span class="status-label">Delivered</span>
            <span class="status-desc">Customer has received the items</span>
          </button>

          <!-- Cancelled -->
          <button onclick="updateStatus('cancelled', this)" 
            <%= !canCancel && s !== 'cancelled' ? 'disabled' : '' %>
            class="status-btn <%= s === 'cancelled' ? 'active' : '' %>">
            <span class="status-label" style="color: #ef4444;">Cancelled</span>
            <span class="status-desc">Order is revoked and stock is restored</span>
          </button>
        </div>
      </div>
    </main>
  </div>

  <div id="toast">
    <div id="toastIcon" style="width: 20px; height: 20px;"></div>
    <span id="toastMsg"></span>
  </div>

  <script>
    const orderId = '<%= order._id %>';

    async function updateStatus(newStatus, btn) {
      if (['cancelled', 'returned'].includes(newStatus)) {
        if (!confirm(`Are you sure you want to mark this order as ${newStatus.toUpperCase()}? This will restore item stock.`)) return;
      }

      const originalContent = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<svg width="24" height="24" class="animate-spin" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0110 10"/></svg>`;

      try {
        const res = await fetch(`/admin/orders/${orderId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });
        const data = await res.json();

        if (data.success) {
          showToast(`Order status updated to ${data.status}`, 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.message || 'Update failed', 'error');
          btn.disabled = false;
          btn.innerHTML = originalContent;
        }
      } catch (err) {
        showToast('Network error. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = originalContent;
      }
    }

    function showToast(msg, type) {
      const t = document.getElementById('toast');
      const icon = document.getElementById('toastIcon');
      document.getElementById('toastMsg').textContent = msg;
      t.className = `show ${type}`;
      
      if (type === 'error') {
        icon.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
      } else {
        icon.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;
      }
      
      setTimeout(() => { t.className = ''; }, 3000);
    }
  </script>
</body>
</html>
