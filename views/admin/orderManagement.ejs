<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Orders | PES Store Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { poppins: ['Poppins', 'sans-serif'] },
          colors: {
            sidebar: '#1a1f3c',
            'sidebar-hover': '#252b4a',
            brand: '#e53935',
            'table-header': '#2e7d32',
            'btn-navy': '#1a237e',
            'badge-delivered': '#00897b',
            'badge-processing': '#7b1fa2',
            'badge-cancelled': '#e53935',
            'btn-export': '#1565c0',
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Poppins', sans-serif; }
    .nav-item { transition: background 0.2s; }
    .scrollbar-thin::-webkit-scrollbar { width: 4px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #3a4170; border-radius: 4px; }
  </style>
</head>
<body class="bg-gray-100 flex h-screen overflow-hidden">

  <!-- ===== SIDEBAR ===== -->
  <aside class="w-52 bg-sidebar flex flex-col flex-shrink-0 h-full">
    <!-- Logo -->
    <div class="flex items-center justify-center py-6 border-b border-white/10">
      <div class="w-14 h-14 bg-white/10 rounded-xl flex items-center justify-center">
        <!-- Chess King SVG Logo -->
        <svg viewBox="0 0 64 64" class="w-10 h-10 fill-white" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="52" width="24" height="5" rx="2"/>
          <rect x="16" y="47" width="32" height="6" rx="2"/>
          <path d="M22 47 C22 35 18 30 18 22 C18 14 24 10 32 10 C40 10 46 14 46 22 C46 30 42 35 42 47Z"/>
          <rect x="29" y="4" width="6" height="14" rx="3"/>
          <rect x="24" y="8" width="16" height="5" rx="2"/>
          <rect x="10" y="18" width="44" height="5" rx="2"/>
        </svg>
      </div>
    </div>

    <!-- Nav Items -->
    <nav class="flex-1 py-4 overflow-y-auto scrollbar-thin">
      <ul class="space-y-1 px-3">

        <li>
          <a href="/admin/dashboard" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Dashboard
          </a>
        </li>

        <li>
          <a href="/admin/orders" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg bg-brand text-white text-sm font-semibold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
            Order
          </a>
        </li>

        <li>
          <a href="/admin/products" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/>
              <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
            </svg>
            Products
          </a>
        </li>

        <li>
          <a href="/admin/sales-report" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/>
            </svg>
            Sales report
          </a>
        </li>

        <li>
          <a href="/admin/customers" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
              <circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
            Customer
          </a>
        </li>

        <li>
          <a href="/admin/coupons" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
            Coupon
          </a>
        </li>

        <li>
          <a href="/admin/categories" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Category
          </a>
        </li>

        <li>
          <a href="/admin/refunds" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/70 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
            </svg>
            Refund/Return
          </a>
        </li>

      </ul>
    </nav>

    <!-- Sign Out -->
    <div class="px-3 pb-5">
      <a href="/admin/logout" class="nav-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/60 hover:bg-sidebar-hover hover:text-white text-sm font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
          <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Sign Out
      </a>
    </div>
  </aside>

  <!-- ===== MAIN AREA ===== -->
  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- Top Header -->
    <header class="bg-white h-16 flex items-center justify-end px-8 gap-4 border-b border-gray-200 flex-shrink-0">
      <!-- Message Icon -->
      <button class="relative w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center hover:bg-gray-200 transition">
        <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center">3</span>
      </button>
      <!-- Bell Icon -->
      <button class="relative w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center hover:bg-gray-200 transition">
        <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/>
        </svg>
        <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-orange-400 text-white text-[9px] font-bold rounded-full flex items-center justify-center">5</span>
      </button>
      <!-- Avatar -->
      <button class="w-10 h-10 rounded-full overflow-hidden ring-2 ring-brand ring-offset-1">
        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=admin" alt="Admin" class="w-full h-full object-cover bg-orange-200"/>
      </button>
    </header>

    <!-- Page Content -->
    <main class="flex-1 overflow-y-auto p-8">

      <!-- Page Title + Controls -->
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Orders</h1>
        <div class="flex items-center gap-3">
          <!-- Search -->
          <div class="flex items-center gap-2">
            <div class="flex items-center bg-white border border-gray-200 rounded-lg px-3 py-2 w-64 gap-2">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input type="text" placeholder="Search here" class="outline-none text-sm text-gray-600 bg-transparent w-full placeholder-gray-400"/>
            </div>
            <button class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-lg transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </button>
          </div>
          <!-- Sort By -->
          <button class="flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 transition font-medium">
            Sort By
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M7 16V4m0 0L3 8m4-4l4 4"/><path d="M17 8v12m0 0l4-4m-4 4l-4-4"/>
            </svg>
          </button>
          <!-- Filters -->
          <button class="flex items-center gap-2 bg-white border border-gray-200 rounded-lg px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 transition font-medium">
            Filters
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
              <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
              <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
          </button>
          <!-- Export -->
          <a href="/admin/orders/export" class="flex items-center gap-2 bg-btn-export hover:bg-blue-800 text-white rounded-lg px-4 py-2 text-sm font-semibold transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export
          </a>
        </div>
      </div>

      <!-- Orders Table -->
      <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-table-header text-white">
              <th class="py-3.5 px-5 text-left font-semibold rounded-tl-xl w-20">Id</th>
              <th class="py-3.5 px-4 text-left font-semibold">Name</th>
              <th class="py-3.5 px-4 text-left font-semibold">Address</th>
              <th class="py-3.5 px-4 text-left font-semibold">Date</th>
              <th class="py-3.5 px-4 text-left font-semibold">Product</th>
              <th class="py-3.5 px-4 text-left font-semibold">Status</th>
              <th class="py-3.5 px-5 text-left font-semibold rounded-tr-xl">Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">

            <% orders.forEach(order => { %>
            <tr class="hover:bg-gray-50 transition">
              <td class="py-4 px-5 text-gray-600 font-medium"><%= order.orderId %></td>
              <td class="py-4 px-4 text-gray-800 font-medium"><%= order.customerName %></td>
              <td class="py-4 px-4 text-gray-500"><%= order.address %></td>
              <td class="py-4 px-4 text-gray-600 whitespace-nowrap"><%= order.date %></td>
              <td class="py-4 px-4 text-gray-700 max-w-[180px]"><%= order.product %></td>
              <td class="py-4 px-4">
                <div class="flex items-center gap-2">
                  <% if (order.status === 'Delivered') { %>
                    <span class="bg-badge-delivered text-white text-xs font-semibold px-3 py-1 rounded-md">Delivered</span>
                  <% } else if (order.status === 'Processing') { %>
                    <span class="bg-badge-processing text-white text-xs font-semibold px-3 py-1 rounded-md">Processing</span>
                  <% } else if (order.status === 'Cancelled') { %>
                    <span class="bg-badge-cancelled text-white text-xs font-semibold px-3 py-1 rounded-md">Cancelled</span>
                  <% } else { %>
                    <span class="bg-gray-400 text-white text-xs font-semibold px-3 py-1 rounded-md"><%= order.status %></span>
                  <% } %>
                  <a href="/admin/orders/<%= order._id %>" class="bg-btn-navy hover:bg-blue-900 text-white text-xs font-semibold px-3 py-1.5 rounded-md transition">view</a>
                </div>
              </td>
              <td class="py-4 px-5 text-gray-800 font-semibold whitespace-nowrap">₹ <%= order.price %></td>
            </tr>
            <% }) %>

          </tbody>
        </table>

        <!-- Pagination -->
        <div class="flex items-center justify-between px-6 py-4 border-t border-gray-100">
          <!-- Show Result -->
          <div class="flex items-center gap-2 text-sm text-gray-500">
            <span>Show result:</span>
            <div class="relative">
              <select class="appearance-none bg-white border border-gray-200 rounded-md pl-3 pr-7 py-1.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer font-medium">
                <option value="2" <%= limit == 2 ? 'selected' : '' %>>2</option>
                <option value="5" <%= limit == 5 ? 'selected' : '' %>>5</option>
                <option value="10" <%= limit == 10 ? 'selected' : '' %>>10</option>
                <option value="20" <%= limit == 20 ? 'selected' : '' %>>20</option>
              </select>
              <svg class="absolute right-2 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
          </div>

          <!-- Page Numbers -->
          <div class="flex items-center gap-1">
            <!-- Prev -->
            <a href="?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>&limit=<%= limit %>"
               class="w-8 h-8 flex items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 transition <%= currentPage === 1 ? 'pointer-events-none opacity-40' : '' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </a>

            <% for (let i = 1; i <= totalPages; i++) { %>
              <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                <a href="?page=<%= i %>&limit=<%= limit %>"
                   class="w-8 h-8 flex items-center justify-center rounded-md text-sm font-medium transition
                   <%= i === currentPage ? 'bg-btn-navy text-white' : 'text-gray-600 hover:bg-gray-100' %>">
                  <%= i %>
                </a>
              <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                <span class="w-8 h-8 flex items-center justify-center text-gray-400 text-sm">...</span>
              <% } %>
            <% } %>

            <!-- Next -->
            <a href="?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %>&limit=<%= limit %>"
               class="w-8 h-8 flex items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 transition <%= currentPage === totalPages ? 'pointer-events-none opacity-40' : '' %>">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>

</body>
</html>
