<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Return/Refund Details – PES Store Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <%# FIX: was two <head> tags with <style> outside <head> — merged into one clean head %>
  <style>
    :root { --primary-color: #6366f1; }
    * { font-family: 'Nunito', sans-serif; box-sizing: border-box; }
    body { background: #f8fafc; margin: 0; color: #334155; }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #9ca3af; border-radius: 3px; }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Topbar ── */
    .topbar { background: #fff; height: 72px; display: flex; align-items: center; padding: 0 32px; gap: 20px; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #e2e8f0; }
    .topbar-logo img { width: 52px; height: 52px; object-fit: contain; }
    .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 16px; }
    .icon-circle { width: 40px; height: 40px; border-radius: 12px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; border: 1px solid #e2e8f0; }
    .icon-circle:hover { background: #e2e8f0; transform: translateY(-1px); }
    .avatar img { width: 40px; height: 40px; border-radius: 12px; object-fit: cover; border: 2px solid var(--primary-color); }

    /* ── Layout ── */
    .layout { display: flex; min-height: calc(100vh - 72px); }
    .main { flex: 1; padding: 40px; background: #f8fafc; }

    /* ── Header ── */
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .page-title { font-size: 1.85rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; margin-top: 12px; }

    /* ── Card ── */
    .return-card {
      background: #fff; border-radius: 24px; border: 1px solid #e2e8f0;
      overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
      margin-bottom: 32px; animation: slideUp 0.4s ease both;
    }
    .card-body { padding: 32px; }
    .card-footer { background: #f8fafc; padding: 20px 32px; border-top: 1px solid #f1f5f9; display: flex; justify-content: center; gap: 16px; }

    /* ── Fields ── */
    .field-group { margin-bottom: 20px; }
    .field-label { display: block; font-size: 0.8rem; font-weight: 800; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
    .field-readonly {
      width: 100%; padding: 12px 16px; border-radius: 12px; border: 1.5px solid #e2e8f0;
      font-size: 0.95rem; font-weight: 700; color: #1e293b; background: #fcfdfe;
    }
    .field-textarea { min-height: 100px; line-height: 1.6; }

    /* ── Product Image ── */
    .product-img-wrap { width: 220px; height: 220px; border-radius: 16px; overflow: hidden; background: #f1f5f9; border: 1.5px solid #e2e8f0; flex-shrink: 0; }
    .product-img { width: 100%; height: 100%; object-fit: cover; }

    /* ── Buttons ── */
    .btn-accept {
      background: #10b981; color: #fff; border: none; padding: 12px 40px;
      border-radius: 12px; font-size: 0.95rem; font-weight: 800; cursor: pointer;
      transition: all 0.2s; box-shadow: 0 4px 6px -1px rgba(16,185,129,0.2);
    }
    .btn-accept:hover { background: #059669; transform: translateY(-1px); }

    .btn-reject {
      background: #ef4444; color: #fff; border: none; padding: 12px 40px;
      border-radius: 12px; font-size: 0.95rem; font-weight: 800; cursor: pointer;
      transition: all 0.2s; box-shadow: 0 4px 6px -1px rgba(239,68,68,0.2);
    }
    .btn-reject:hover { background: #dc2626; transform: translateY(-1px); }

    .status-badge { padding: 10px 32px; border-radius: 12px; font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .status-accepted { background: #ecfdf5; color: #059669; border: 1.5px solid #10b981; }
    .status-rejected { background: #fef2f2; color: #dc2626; border: 1.5px solid #ef4444; }

    .btn-back { display: inline-flex; align-items: center; gap: 8px; color: #64748b; text-decoration: none; font-size: 0.9rem; font-weight: 700; transition: color 0.2s; }
    .btn-back:hover { color: #1e293b; }
  </style>
</head>
<body>

  <div class="topbar">
    <div class="topbar-logo"><img src="/img/pes.logo.png" alt="PES Logo" /></div>
    <div class="topbar-actions">
      <div class="icon-circle"><svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
      <div class="avatar"><img src="/images/admin-avatar.jpg" alt="Admin" /></div>
    </div>
  </div>

  <div class="layout">
    <%- include('../partials/admin/sidebar.ejs', { activePage: 'returns' }) %>

    <main class="main">
      <div class="page-header">
        <div>
          <a href="/admin/returns" class="btn-back">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Returns
          </a>
          <h1 class="page-title">Return Item Details</h1>
        </div>
      </div>

      <% if (returnItems && returnItems.length > 0) { %>
        <% returnItems.forEach((item, idx) => { %>
        <div class="return-card" id="card-<%= item._id %>" style="animation-delay: <%= idx * 0.1 %>s">
          <div class="card-body">
            <div style="display:flex; gap:32px;">

              <div class="product-img-wrap">
                <% if (item.productImage) { %>
                  <img src="<%= item.productImage %>" alt="<%= item.productName %>" class="product-img" onerror="this.style.visibility='hidden'"/>
                <% } else { %>
                  <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
                    <svg width="60" height="60" fill="none" stroke="#cbd5e1" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                <% } %>
              </div>

              <div style="flex:1;">
                <div class="field-group">
                  <label class="field-label">Product Name</label>
                  <div class="field-readonly"><%= item.productName %></div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                  <div class="field-group">
                    <label class="field-label">Order ID</label>
                    <div class="field-readonly" style="font-family:monospace; font-size:0.85rem;"><%= item.orderId %></div>
                  </div>
                  <div class="field-group">
                    <label class="field-label">Refund ID</label>
                    <div class="field-readonly" style="font-family:monospace; font-size:0.85rem;">#<%= item._id %></div>
                  </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                  <div class="field-group">
                    <label class="field-label">Customer Name</label>
                    <div class="field-readonly"><%= item.customerName %></div>
                  </div>
                  <div class="field-group">
                    <label class="field-label">Refund Amount</label>
                    <div class="field-readonly" style="color:#059669; font-weight:800;">₹<%= (item.returnPrice || 0).toLocaleString('en-IN') %></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="field-group" style="margin-top:24px;">
              <label class="field-label">Reason for Return</label>
              <div class="field-readonly field-textarea"><%= item.reason || 'No reason provided.' %></div>
            </div>
          </div>

          <div class="card-footer" id="footer-<%= item._id %>">
            <% if (item.status === 'Requested') { %>
              <button onclick="handleReturn('<%= orderId %>', '<%= item._id %>', 'accept')" class="btn-accept">Accept Return</button>
              <button onclick="handleReturn('<%= orderId %>', '<%= item._id %>', 'reject')" class="btn-reject">Reject Request</button>
            <% } else { %>
              <div class="status-badge <%= item.status === 'Accepted' ? 'status-accepted' : 'status-rejected' %>">
                <%= item.status %>
              </div>
            <% } %>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <div style="text-align:center; padding:60px; background:#fff; border-radius:24px; border:1px solid #e2e8f0;">
          <p style="color:#94a3b8; font-weight:700;">No return details found for this order.</p>
        </div>
      <% } %>
    </main>
  </div>

  <div id="toast" class="hidden"></div>

  <script>
    async function handleReturn(orderId, itemId, action) {
      const label = action === 'accept' ? 'accept' : 'reject';
      if (!confirm(`Are you sure you want to ${label} this return request?`)) return;

      try {
        const res = await fetch(`/admin/returns/${orderId}/items/${itemId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action }),
        });
        const data = await res.json();

        if (data.success) {
          const footer = document.getElementById(`footer-${itemId}`);
          footer.innerHTML = `
            <div class="status-badge ${data.newStatus === 'Accepted' ? 'status-accepted' : 'status-rejected'}">
              ${data.newStatus}
            </div>`;
          showToast(data.message, 'green');
        } else {
          showToast(data.message || 'Something went wrong', 'red');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error. Please try again.', 'red');
      }
    }

    function showToast(msg, color) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = `fixed top-5 right-5 z-50 px-5 py-3 rounded-lg text-white text-sm font-medium shadow-lg
                     ${color === 'green' ? 'bg-green-600' : 'bg-red-600'}`;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 3000);
    }
  </script>
</body>
</html>
