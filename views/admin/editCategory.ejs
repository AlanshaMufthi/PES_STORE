<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Category | 2ES Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    * { font-family: 'Nunito', sans-serif; box-sizing: border-box; }
    body { background: #f8fafc; margin: 0; color: #334155; }

    /* ── Topbar ── */
    .topbar { background: #fff; height: 72px; display: flex; align-items: center; padding: 0 32px; gap: 20px; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #e2e8f0; }
    .topbar-logo img { width: 52px; height: 52px; object-fit: contain; }
    .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 16px; }
    .icon-circle { width: 40px; height: 40px; border-radius: 12px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; border: 1px solid #e2e8f0; }
    .icon-circle:hover { background: #e2e8f0; transform: translateY(-1px); }
    .avatar img { width: 40px; height: 40px; border-radius: 12px; object-fit: cover; border: 2px solid var(--primary-color); }

    /* ── Layout ── */
    .layout { display: flex; min-height: calc(100vh - 72px); }
    .main { flex: 1; padding: 40px; background: #f8fafc; max-width: 900px; margin: 0 auto; }

    /* ── Header ── */
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .page-title { font-size: 1.85rem; font-weight: 800; color: #0f172a; letter-spacing: -0.02em; }

    /* ── Card ── */
    .form-card {
      background: #fff; border-radius: 24px; border: 1px solid #e2e8f0;
      padding: 40px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }

    /* ── Fields ── */
    .field-group { margin-bottom: 24px; }
    .field-label { display: block; font-size: 0.85rem; font-weight: 800; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
    .field-input, .field-select, .field-textarea {
      width: 100%; padding: 12px 16px; border-radius: 12px; border: 1.5px solid #e2e8f0;
      font-size: 0.95rem; font-weight: 600; color: #1e293b; transition: all 0.2s; outline: none; background: #fcfdfe;
    }
    .field-input:focus, .field-select:focus, .field-textarea:focus { border-color: var(--primary-color); background: #fff; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1); }
    .field-textarea { min-height: 120px; resize: vertical; }

    .field-input.error { border-color: #ef4444; background: #fff1f2; }
    .error-msg { font-size: 0.8rem; color: #ef4444; font-weight: 700; margin-top: 6px; display: none; }
    .error-msg.show { display: block; animation: shake 0.3s ease-in-out; }

    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }

    /* ── Toggle Switch ── */
    .toggle-row { display: flex; align-items: center; justify-content: space-between; background: #f8fafc; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; margin-bottom: 24px; }
    .toggle-info div:first-child { font-size: 0.95rem; font-weight: 800; color: #1e293b; }
    .toggle-info div:last-child { font-size: 0.8rem; font-weight: 600; color: #64748b; margin-top: 2px; }

    .switch { position: relative; display: inline-block; width: 46px; height: 24px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; inset: 0; background: #cbd5e1; border-radius: 34px; transition: 0.4s; }
    .slider:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.4s; }
    input:checked + .slider { background: var(--bg-active); }
    input:checked + .slider:before { transform: translateX(22px); }
    input:disabled + .slider { opacity: 0.5; cursor: not-allowed; }

    /* ── Buttons ── */
    .btn-save {
      background: var(--bg-active); color: #fff; border: none; padding: 14px 32px;
      border-radius: 14px; font-size: 1rem; font-weight: 800; cursor: pointer;
      transition: all 0.3s; box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.4); }
    
    .btn-cancel {
      background: #f1f5f9; color: #64748b; padding: 14px 32px; border-radius: 14px;
      font-size: 1rem; font-weight: 800; text-decoration: none; transition: all 0.2s;
      border: 1px solid #e2e8f0;
    }
    .btn-cancel:hover { background: #e2e8f0; color: #1e293b; }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo"><img src="/img/pes.logo.png" alt="2ES Logo" /></div>
    <div class="topbar-actions">
      <div class="icon-circle"><svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
      <div class="avatar"><img src="/images/admin-avatar.jpg" alt="Admin" /></div>
    </div>
  </div>

  <div class="layout">
    <%- include('../partials/admin/sidebar.ejs', { activePage: 'categories' }) %>

    <main class="main">
      <div class="page-header">
        <h1 class="page-title">Edit Category</h1>
      </div>

      <div class="form-card">
        <form id="editCategoryForm" novalidate>
          
          <div class="field-group">
            <label class="field-label">Category Name</label>
            <input type="text" id="name" name="name" class="field-input" placeholder="e.g. Football Cleats" value="<%= category.name %>" />
            <p class="error-msg" id="nameErr"></p>
          </div>

          <div class="field-group">
            <label class="field-label">Category Description</label>
            <textarea id="description" name="description" class="field-input" placeholder="Describe the category..."><%= category.description %></textarea>
            <p class="error-msg" id="descErr"></p>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div class="field-group">
              <label class="field-label">Visibility Status</label>
              <select id="isBlocked" name="isBlocked" class="field-select">
                <option value="true"  <%= !category.isBlocked ? 'selected' : '' %>>Active</option>
                <option value="false" <%= category.isBlocked ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
            <div class="field-group">
              <label class="field-label">Discount Percentage</label>
              <select id="offer" name="offer" class="field-select" onchange="handleOfferChange()">
                <% [0,5,10,15,20,25,30,50].forEach(val => { %>
                  <option value="<%= val %>" <%= category.categoryOffer == val ? 'selected' : '' %>><%= val %><%= val === 0 ? '% (None)' : '%' %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="toggle-row">
            <div class="toggle-info">
              <div>Activate Offer</div>
              <div id="offerToggleSub">
                <% if (category.categoryOffer > 0) { %>
                  Toggle to enable or disable the <%= category.categoryOffer %>% offer
                <% } else { %>
                  Set a discount % to enable
                <% } %>
              </div>
            </div>
            <label class="switch">
              <input type="checkbox" id="offerActive" <%= category.categoryOffer > 0 ? '' : 'disabled' %> <%= category.offerActive ? 'checked' : '' %> />
              <span class="slider"></span>
            </label>
          </div>

          <div style="display: flex; gap: 16px; justify-content: flex-end; margin-top: 32px;">
            <a href="/admin/categories" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save">Update Category</button>
          </div>

        </form>
      </div>
    </main>
  </div>


  <script>
    function showErr(id, errId, msg) {
      document.getElementById(id).classList.add('error')
      const el = document.getElementById(errId)
      el.textContent = msg; el.classList.add('show')
    }
    function clearErr(id, errId) {
      document.getElementById(id).classList.remove('error')
      const el = document.getElementById(errId)
      el.textContent = ''; el.classList.remove('show')
    }

    document.getElementById('name').addEventListener('input', () => clearErr('name', 'nameErr'))
    document.getElementById('description').addEventListener('input', () => clearErr('description', 'descErr'))

    // Enable/disable the offerActive toggle when discount % changes
    function handleOfferChange() {
      const pct    = parseInt(document.getElementById('offer').value) || 0
      const toggle = document.getElementById('offerActive')
      const sub    = document.getElementById('offerToggleSub')
      if (pct > 0) {
        toggle.disabled = false
        sub.textContent = `Toggle to enable or disable the ${pct}% offer`
      } else {
        toggle.disabled = true
        toggle.checked  = false
        sub.textContent = 'Set a discount % above to enable'
      }
    }

    document.getElementById('editCategoryForm').addEventListener('submit', async function(e) {
      e.preventDefault()
      let valid = true
      const name        = document.getElementById('name').value.trim()
      const description = document.getElementById('description').value.trim()

      if (name.length < 2) { showErr('name', 'nameErr', 'Category name must be at least 2 characters'); valid = false }
      if (description.length < 5) { showErr('description', 'descErr', 'Please enter a description'); valid = false }
      if (!valid) return

      const result = await Swal.fire({
        title: 'Save Changes?',
        text: `Update category to "${name}"?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#22c55e',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, Save',
        cancelButtonText: 'Cancel'
      })
      if (!result.isConfirmed) return

      const categoryId = window.location.pathname.split('/').pop()

      try {
        const response = await fetch(`/admin/categories/edit/${categoryId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            description,
            isBlocked:   document.getElementById('isBlocked').value,
            offer:       document.getElementById('offer').value,
            offerActive: document.getElementById('offerActive').checked
          })
        })

        const data = await response.json()
        if (data.success) {
          await Swal.fire({
            icon: 'success', title: 'Category Updated!',
            text: 'Changes saved successfully.',
            confirmButtonColor: '#22c55e', timer: 1500, showConfirmButton: false
          })
          window.location.href = data.redirectUrl
        } else if (data.field === 'name') {
          showErr('name', 'nameErr', data.message)
        } else {
          Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#e63946' })
        }
      } catch (err) {
        console.error(err)
        Swal.fire({ icon: 'error', title: 'Network Error', text: 'Please try again.', confirmButtonColor: '#e63946' })
      }
    })
  </script>
</body>
</html>
