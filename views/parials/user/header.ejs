<header class="w-full border-b border-gray-100 bg-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">

    <!-- LOGO -->
    <a href="/">
      <img src="/img/pes.logo.png" class="h-14 w-14 object-contain" />
    </a>

    <!-- NAV -->
    <nav class="hidden md:flex gap-8 text-sm font-medium">
      <a href="/" class="<%= page === 'home' ? 'text-black border-b-2 border-red-500' : 'text-gray-500 hover:text-black' %>">HOME</a>
      <a href="/shop" class="<%= page === 'shop' ? 'text-black border-b-2 border-red-500' : 'text-gray-500 hover:text-black' %>">SHOP</a>
      <a href="/about" class="<%= page === 'about' ? 'text-black border-b-2 border-red-500' : 'text-gray-500 hover:text-black' %>">ABOUT</a>
      <a href="/contact" class="<%= page === 'contact' ? 'text-black border-b-2 border-red-500' : 'text-gray-500 hover:text-black' %>">CONTACT</a>
    </nav>

    <!-- RIGHT SIDE -->
    <div class="flex items-center gap-4">

      <!-- SEARCH -->
      <form action="/shop" method="GET" class="hidden sm:flex items-center relative">
        <input
          id="headerSearchInput"
          type="text"
          name="q"
          value="<%= searchQuery || '' %>"
          placeholder="Search..."
          class="border px-3 py-1 rounded-full text-sm pr-7"
          oninput="toggleSearchClear()"
        />
        <button
          type="button"
          id="headerSearchClear"
          onclick="clearHeaderSearch()"
          title="Clear search"
          style="display:<%= searchQuery ? 'flex' : 'none' %>;"
          class="absolute right-2 top-1/2 -translate-y-1/2 items-center justify-center w-4 h-4 rounded-full bg-gray-300 hover:bg-gray-400 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-gray-700" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </form>

     <!-- CART -->
<a href="/cart" class="relative text-lg">
  🛒
  <span
    id="headerCartCount"
    class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full px-1"
    style="display: <%= (cartCount && cartCount > 0) ? 'inline' : 'none' %>;"
  ><%= cartCount || 0 %></span>
</a>

      <!-- ACCOUNT -->
      <a href="/profile">👤</a>

    </div>
  </div>
</header>

<script>
  function toggleSearchClear() {
    const input = document.getElementById('headerSearchInput');
    const btn = document.getElementById('headerSearchClear');
    btn.style.display = input.value.trim() ? 'flex' : 'none';
  }

  function clearHeaderSearch() {
    const input = document.getElementById('headerSearchInput');
    input.value = '';
    document.getElementById('headerSearchClear').style.display = 'none';
    input.focus();
    // If we're on the shop page and there were search results, go back to /shop
    if (window.location.pathname === '/shop') {
      window.location.href = '/shop';
    }
  }
</script>